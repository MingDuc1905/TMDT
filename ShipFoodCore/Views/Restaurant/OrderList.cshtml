@{
    ViewBag.Title = "OrderList";
    Layout = "~/Views/Shared/_LayoutPageRestaurant.cshtml";
    List<ShipFood.Models.tbDonHang> donHangs = ViewBag.donHangs;
}

<!-- row -->
<div class="container-fluid">
    <div class="page-header mb-3">
        <div>
            <h2 class="mb-0">Đơn đặt hàng</h2>
            <p class="mb-0 text-muted small">Danh sách đơn đặt hàng</p>
        </div>
        <div class="toolbar">
            <div class="dropdown custom-dropdown">
                <button type="button" class="btn btn-outline d-flex align-items-center" data-bs-toggle="dropdown" id="filterStatusBtn">
                    <i class="fas fa-filter me-1"></i>
                    <span id="filterStatusLabel">Tất cả</span>
                    <i class="fas fa-chevron-down ms-2"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-right">
                    <a class="dropdown-item filter-status" data-status="" href="#"><i class="fas fa-list"></i> Tất cả</a>
                    <a class="dropdown-item filter-status" data-status="Đã đặt" href="#"><i class="fas fa-clock"></i> Đã đặt</a>
                    <a class="dropdown-item filter-status" data-status="Chờ thanh toán" href="#"><i class="fas fa-hourglass-half"></i> Chờ thanh toán</a>
                    <a class="dropdown-item filter-status" data-status="Đã xác nhận" href="#"><i class="fas fa-check-circle"></i> Đã xác nhận</a>
                    <a class="dropdown-item filter-status" data-status="Đang chuẩn bị" href="#"><i class="fas fa-fire"></i> Đang chuẩn bị</a>
                    <a class="dropdown-item filter-status" data-status="Chờ shipper lấy hàng" href="#"><i class="fas fa-box"></i> Chờ lấy hàng</a>
                    <a class="dropdown-item filter-status" data-status="Đang giao" href="#"><i class="fas fa-truck"></i> Đang giao</a>
                    <a class="dropdown-item filter-status" data-status="Hoàn thành" href="#"><i class="fas fa-check-circle"></i> Hoàn thành</a>
                    <a class="dropdown-item filter-status" data-status="Đã hủy" href="#"><i class="fas fa-times-circle"></i> Đã hủy</a>
                </div>
            </div>
            <div class="dropdown custom-dropdown">
                <button type="button" class="btn btn-outline d-flex align-items-center" data-bs-toggle="dropdown" id="filterDateBtn">
                    <i class="fas fa-calendar me-1"></i>
                    <span id="filterDateLabel">Hôm nay</span>
                    <i class="fas fa-chevron-down ms-2"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-right">
                    <a class="dropdown-item filter-date" data-days="" href="#"><i class="fas fa-calendar-alt"></i> Tất cả thời gian</a>
                    <a class="dropdown-item filter-date" data-days="0" href="#"><i class="fas fa-calendar-alt"></i> Hôm nay</a>
                    <a class="dropdown-item filter-date" data-days="7" href="#"><i class="fas fa-calendar-alt"></i> 7 ngày qua</a>
                    <a class="dropdown-item filter-date" data-days="30" href="#"><i class="fas fa-calendar-alt"></i> 30 ngày qua</a>
                    <a class="dropdown-item filter-date" data-days="90" href="#"><i class="fas fa-calendar-alt"></i> 3 tháng qua</a>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <div class="table-responsive">
                <table id="example5" class="display mb-4 dataTablesCard" style="min-width: 845px">
                    <thead>
                        <tr>
                            <th>Ngày đặt</th>
                            <th>Khách hàng</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th>Ghi chú</th>
                            <th style=" width: 40px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var i in donHangs)
                        {
                            <tr>
                                <td data-label="Ngày đặt">@(i.ngaydathang?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</td>
                                <td data-label="Khách hàng">@(i.tbThongTinDatHang?.tennguoinhan ?? "Khách")</td>
                                <td data-label="Tổng tiền">@i.tongtien?.ToString("N0") VNĐ</td>
                                @if (i.trangthai.Equals("Đã hủy"))
                                {
                                    <td data-label="Trạng thái"><span class="btn btn-sm light btn-danger fs-16">@i.trangthai</span></td>
                                }
                                @if (!i.trangthai.Equals("Đã hủy"))
                                {
                                    <td data-label="Trạng thái"><span class="btn btn-sm light btn-success fs-16">@i.trangthai</span></td>
                                }
                                <td data-label="Ghi chú">@i.ghichu</td>
                                <td data-label="Action" style="padding:20px">
                                    @if (i.trangthai == "Đã đặt")
                                    {
                                        <a href="~/Restaurant/nhandon/@i.madh"><span style="width: 115px; font-size: 13px; " class="btn btn-success light btn-secondary">Nhận đơn</span></a>
                                        <a href="~/Restaurant/huydon/@i.madh" onclick="return confirm('Bạn có chắc muốn huỷ đơn này?')"><span style="width: 115px; font-size: 13px;" class="btn btn-warning light btn-secondary">Huỷ đơn</span></a>
                                    }
                                    else if (i.trangthai == "Chờ thanh toán")
                                    {
                                        <span style="width: 140px; font-size: 12px;" class="btn btn-secondary light btn-secondary" title="Đơn đang chờ khách thanh toán VNPAY"><i class="fas fa-hourglass-half"></i> Chờ thanh toán</span>
                                        <a href="~/Restaurant/huydon/@i.madh" onclick="return confirm('Bạn có chắc muốn huỷ đơn này?')"><span style="width: 115px; font-size: 13px;" class="btn btn-warning light btn-secondary">Huỷ đơn</span></a>
                                    }
                                    else if (i.trangthai == "Đã xác nhận" || i.trangthai == "Đang chuẩn bị")
                                    {
                                        <a href="~/Restaurant/hoantatdon/@i.madh"><span style="width: 140px; font-size: 13px;" class="btn btn-primary btn-secondary">Chuẩn bị xong</span></a>
                                        <a href="~/Restaurant/huydon/@i.madh" onclick="return confirm('Bạn có chắc muốn huỷ đơn này?')"><span style="width: 115px; font-size: 13px;" class="btn btn-warning light btn-secondary">Huỷ đơn</span></a>
                                    }
                                    else if (i.trangthai == "Chờ shipper lấy hàng" || i.trangthai == "Đã lấy" || i.trangthai == "Đang giao")
                                    {
                                        <span style="width: 140px; font-size: 12px;" class="btn btn-info light btn-secondary"><i class="fas fa-truck"></i> Đang giao</span>
                                    }
                                    else if (i.trangthai == "Hoàn thành")
                                    {
                                        <span style="width: 115px; font-size: 12px;" class="btn btn-success light btn-secondary"><i class="fas fa-check-circle"></i> Hoàn thành</span>
                                    }
                                    <a href="~/Cart/ChiTietDonHang?id=@i.madh"><span style="width:115px" class="btn btn-sm light btn-secondary fs-16">Chi tiết</span></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>    <!-- Datatable -->
    <script src="~/Source/Restaurant/vendor/datatables/js/jquery.dataTables.min.js"></script>
<!-- SignalR -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

<script>
    (function ($) {
        var table = $('#example5').DataTable({
            searching: false,
            paging: true,
            select: false,
            lengthChange: false,
            order: [[0, 'desc']], // M?c d?nh s?p x?p theo ngày d?t m?i nh?t
        });
        $('#example tbody').on('click', 'tr', function () {
            var data = table.row(this).data();
        });

        // ─── FILTER: L?c theo tr?ng thái ───
        $('.filter-status').on('click', function(e) {
            e.preventDefault();
            var status = $(this).data('status');
            $('#filterStatusLabel').text($(this).text().trim().replace(/[\u{1F300}-\u{1F9FF}]/gu, '').trim());
            if (status === '') {
                table.column(3).search('').draw();
            } else {
                table.column(3).search('^' + status.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '$', true, false).draw();
            }
        });

        // ─── FILTER: L?c theo ngày ───
        $('.filter-date').on('click', function(e) {
            e.preventDefault();
            var days = $(this).data('days');
            var label = $(this).text().trim().replace(/[\u{1F300}-\u{1F9FF}]/gu, '').trim();
            $('#filterDateLabel').text(label);
            
            if (days === '' || days === undefined) {
                // Show all rows
                $.fn.dataTable.ext.search = $.fn.dataTable.ext.search.filter(function(f) { return f !== dateFilter; });
                table.draw();
                return;
            }
            
            days = parseInt(days);
            var cutoff = new Date();
            cutoff.setDate(cutoff.getDate() - days);
            cutoff.setHours(0, 0, 0, 0);
            
            // Remove old date filter if exists
            $.fn.dataTable.ext.search = $.fn.dataTable.ext.search.filter(function(f) { return f !== dateFilter; });
            
            // Add new date filter
            window.dateFilter = function(settings, data, dataIndex) {
                // Parse ngày VN format dd/MM/yyyy HH:mm
                var parts = data[0].split(' ')[0].split('/');
                if (parts.length === 3) {
                    var rowDate = new Date(parseInt(parts[2]), parseInt(parts[1]) - 1, parseInt(parts[0]));
                    return rowDate >= cutoff;
                }
                return true;
            };
            $.fn.dataTable.ext.search.push(window.dateFilter);
            table.draw();
        });

        // ── SignalR: Real-time đơn hàng mới ──
        (function initRestaurantRealtime() {
            var restaurantId = @(ViewBag.restaurantId ?? 0);
            if (!restaurantId) return;

            var conn = new signalR.HubConnectionBuilder()
                .withUrl('/nhantin')
                .withAutomaticReconnect()
                .build();

            conn.on('newOrder', function (data) {
                // Phát âm thanh thông báo (Web Audio API)
                try {
                    var ctx = new (window.AudioContext || window.webkitAudioContext)();
                    var osc = ctx.createOscillator();
                    var gain = ctx.createGain();
                    osc.connect(gain);
                    gain.connect(ctx.destination);
                    osc.frequency.value = 880; // Note A5
                    osc.type = 'sine';
                    gain.gain.setValueAtTime(0.3, ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.4);
                    osc.start(ctx.currentTime);
                    osc.stop(ctx.currentTime + 0.4);
                } catch (e) { /* Audio not supported */ }

                // Reload trang để lấy số liệu thật từ server (DataTable static, không có ajax source)
                setTimeout(function() { location.reload(); }, 2000);
            });

            conn.onreconnected(function() {
                conn.invoke('JoinRestaurantGroup', restaurantId).catch(function(){});
            });

            conn.start().then(function() {
                conn.invoke('JoinRestaurantGroup', restaurantId).catch(function(){});
            }).catch(function(err) {
                console.error('SignalR OrderList connection failed:', err);
            });
        })();
    })(jQuery);
</script>