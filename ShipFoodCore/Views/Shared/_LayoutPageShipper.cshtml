<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Fastship - Khám phá, đặt hàng, giao tân nơi</title>
    <!-- Favicon icon -->
    <link href="~/Source/Home/img/favicon.ico" rel="icon" />
    <link href="~/Source/Shipper/css/chat.css" rel="stylesheet" />
    <link href="~/Source/Shipper/vendor/jqvmap/css/jqvmap.min.css" rel="stylesheet" />
    <!-- Leaflet.js for live order tracking -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <link rel="stylesheet" href="~/Source/Shipper/vendor/chartist/css/chartist.min.css" />
    <link href="~/Source/Shipper/vendor/bootstrap-select/dist/css/bootstrap-select.min.css" rel="stylesheet" />
    <link href="~/Source/Shipper/css/style-shiper.css" rel="stylesheet" />
    <!-- Font Awesome 5 (CDN) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" onerror="var s=document.createElement('link');s.rel='stylesheet';s.href='https://use.fontawesome.com/releases/v5.10.0/css/all.css';document.head.appendChild(s);console.warn('FA CDN fallback');" />
    <!-- Global Design System v4.0 -->
    <link href="~/Source/Shared/css/fastship-design-tokens.css" rel="stylesheet" />
    <style>
        /* ============================================================
           SHIPPER DASHBOARD — Modern Minimalist Override (v4.0)
           ============================================================ */

        /* ── KPI Cards ── */
        .card {
            border: none !important;
            border-radius: var(--fs-radius, 12px) !important;
            box-shadow: var(--fs-shadow, 0 4px 20px rgba(0,0,0,.07)) !important;
            transition: transform .2s ease, box-shadow .2s ease;
        }
        .card:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 32px rgba(0,0,0,.1) !important;
        }
        .card .card-header {
            background: transparent;
            border-bottom: 1px solid var(--fs-border-soft, #f0f0f0);
            padding: 16px 20px;
            font-weight: 700;
            font-size: 15px;
            font-family: var(--fs-font, 'Inter', sans-serif) !important;
        }
        .card .card-body { padding: 20px; }

        /* ── Sidebar ── */
        .deznav {
            background: var(--fs-white, #fff) !important;
        }
        .deznav .metismenu a {
            font-family: var(--fs-font, 'Inter', sans-serif) !important;
        }
        .deznav .metismenu > li > a {
            border-radius: 8px !important;
            margin: 2px 8px;
            padding: 10px 16px;
            font-weight: 500;
            font-size: 14px;
            color: var(--fs-muted, #6b7280) !important;
            transition: all .2s ease;
        }
        .deznav .metismenu > li > a:hover {
            background: var(--fs-green-bg, rgba(60,184,21,.07)) !important;
            color: var(--fs-green, #3CB815) !important;
        }
        .deznav .metismenu > li.mm-active > a {
            background: var(--fs-green, #3CB815) !important;
            color: #fff !important;
        }

        /* ── Tables ── */
        .table {
            font-family: var(--fs-font, 'Inter', sans-serif) !important;
        }
        .table thead th {
            background: var(--fs-light, #f8f9fa) !important;
            padding: 12px 16px !important;
            font-weight: 600 !important;
            font-size: 12px !important;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: var(--fs-muted, #6b7280) !important;
            border-bottom: 1px solid var(--fs-border, #e5e7eb) !important;
        }
        .table tbody td {
            padding: 12px 16px !important;
            border-bottom: 1px solid var(--fs-border-soft, #f0f0f0) !important;
        }
        .table tbody tr:hover {
            background: var(--fs-green-bg, rgba(60,184,21,.07)) !important;
        }

        /* ── Buttons ── */
        .btn {
            border-radius: var(--fs-radius, 12px) !important;
            font-family: var(--fs-font, 'Inter', sans-serif) !important;
            font-weight: 600;
            padding: 10px 22px;
        }
        .btn-success {
            background: linear-gradient(135deg, var(--fs-green, #3CB815), var(--fs-green-dark, #2ea310)) !important;
            border: none !important;
        }

        /* ── Form controls ── */
        .form-control, .form-select {
            border-radius: var(--fs-radius, 12px) !important;
            border: 1.5px solid var(--fs-border, #e5e7eb);
            font-family: var(--fs-font, 'Inter', sans-serif) !important;
            padding: 10px 16px;
        }
        .form-control:focus, .form-select:focus {
            border-color: var(--fs-green, #3CB815) !important;
            box-shadow: 0 0 0 3px rgba(60,184,21,.12) !important;
        }

        /* ── Responsive (giữ nguyên) ── */
        @@media (max-width: 768px) {
            .table-responsive table,
            .table-responsive thead,
            .table-responsive tbody,
            .table-responsive th,
            .table-responsive td,
            .table-responsive tr { display: block; }
            .table-responsive thead { position: absolute; top: -9999px; left: -9999px; }
            .table-responsive td {
                position: relative;
                padding-left: 50% !important;
                border: none;
                border-bottom: 1px solid #eee;
                min-height: 44px;
                display: flex;
                align-items: center;
            }
            .table-responsive td:before {
                content: attr(data-label);
                position: absolute;
                left: 12px;
                width: 45%;
                font-weight: 700;
                color: #333;
            }
            .content-body { padding: 12px; }
            .btn, .nav-link, .dropdown-item { min-height: 44px; min-width: 44px; display: flex; align-items: center; }
            .full-map-area img { width: 100%; height: auto; }
            .nav-link { font-size: 16px; padding: 12px; }
        }
        @@media (max-width: 576px) {
            .col-12 { flex: 0 0 100%; max-width: 100%; }
            .custom-tab-1 .nav-link { font-size: 14px; padding: 10px 8px; }
        }
    </style>

</head>

<body>
@inject ShipFood.Models.dbFoodyEntities _db
@{
    var userJson = Context.Session.GetString("user");
    ShipFood.Models.tbUser? user = userJson != null ? JsonSerializer.Deserialize<tbUser>(userJson) : null;
    ShipFood.Models.tbShipper? shipper = user != null ? _db.tbShipper.Find(user.userid) : null;
}
    <!--*******************
        Preloader start
    ********************-->
    <div id="preloader">
        <div class="sk-three-bounce">
            <div class="sk-child sk-bounce1"></div>
            <div class="sk-child sk-bounce2"></div>
            <div class="sk-child sk-bounce3"></div>
        </div>
    </div>
    <!--*******************
        Preloader end
    ********************-->
    <!--**********************************
        Main wrapper start
    ***********************************-->
    <div id="main-wrapper">
        <!--**********************************
            Nav header start
        ***********************************-->
        <div class="nav-header">
            <a href="@Url.Action("Index", "Shipper")" class="brand-logo">
                <!-- <img class="logo-abbr" src="./images/logo.png" alt="" /> -->
                <img class="logo-compact" src="~/Source/Shipper/images/FASTSHIP.png" alt="" />
                <img class="brand-title" src="~/Source/Shipper/images/FASTSHIP.png" alt="" />
            </a>

            <div class="nav-control">
                <div class="hamburger"><span class="line"></span><span class="line"></span><span class="line"></span></div>
            </div>
        </div>
        <!--**********************************
            Nav header end
        ***********************************-->
        <!--**********************************
            Chat box start
        ***********************************-->
        <!--**********************************
            Chat box End
        ***********************************-->
        <!--**********************************
            Header start
        ***********************************-->
        <!-- header z-index: 1050 (over filter bar 1000) -->
        <div class="header" style="z-index:1050;">
            <div class="header-content">
                <nav class="navbar navbar-expand">
                    <div class="collapse navbar-collapse justify-content-between">
                        <div class="header-left d-none d-md-flex align-items-center ps-3">
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb mb-0 bg-transparent p-0" style="font-size: 14px;">
                                    <li class="breadcrumb-item"><a href="/Shipper/Dashboard" class="text-muted"><i class="fas fa-home me-1"></i>Bảng điều khiển Shipper</a></li>
                                    @if (!string.IsNullOrEmpty(ViewBag.Title))
                                    {
                                        <li class="breadcrumb-item active" aria-current="page" style="color: var(--fs-green); font-weight: 500;">@ViewBag.Title</li>
                                    }
                                </ol>
                            </nav>
                        </div>

                        <ul class="navbar-nav header-right">
                            <li class="nav-item dropdown notification_dropdown">
                                <a class="nav-link dz-fullscreen primary p-3" href="#">
                                    <svg id="Capa_1" enable-background="new 0 0 482.239 482.239" height="22" viewBox="0 0 482.239 482.239" width="22" xmlns="http://www.w3.org/2000/svg">
                                        <path d="m0 17.223v120.56h34.446v-103.337h103.337v-34.446h-120.56c-9.52 0-17.223 7.703-17.223 17.223z"
                                              fill="" />
                                        <path d="m465.016 0h-120.56v34.446h103.337v103.337h34.446v-120.56c0-9.52-7.703-17.223-17.223-17.223z"
                                              fill="" />
                                        <path d="m447.793 447.793h-103.337v34.446h120.56c9.52 0 17.223-7.703 17.223-17.223v-120.56h-34.446z"
                                              fill="" />
                                        <path d="m34.446 344.456h-34.446v120.56c0 9.52 7.703 17.223 17.223 17.223h120.56v-34.446h-103.337z"
                                              fill="" />
                                    </svg>
                                </a>
                            </li>

                            <li class="nav-item dropdown">
                                <span class="text-word">Trạng thái làm việc</span>
                            </li>
                            <li class="nav-item dropdown">
                                <div class="toggle-container">
                                    <input type="checkbox" id="toggle" class="toggle-input" />
                                    <label for="toggle" class="toggle-label">
                                        @if (shipper != null && shipper.trangthai.Equals("Đang hoạt động"))
                                        {
                                            <a href="~/Shipper/updateStatus"><span style="color:white" class="toggle-text">Đóng</span></a>
                                        }
                                        @if (shipper != null && shipper.trangthai.Equals("Không hoạt động"))
                                        {
                                            <a href="~/Shipper/updateStatus"><span style=" border-radius: 25px; background: green;" class="toggle-text">Mở</span></a>
                                        }
                                    </label>
                                </div>
                            </li>
                            <!-- ═══ SHIPPER: Avatar dropdown (modern minimalist) ═══ -->
                            <li class="nav-item dropdown" style="margin-right:12px;">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" data-toggle="dropdown" aria-expanded="false"
                                   style="padding:4px 8px;border-radius:8px;transition:background .15s;"
                                   onmouseenter="this.style.background='rgba(60,184,21,.07)'" onmouseleave="this.style.background='transparent'">
                                    <div style="width:28px;height:28px;border-radius:50%;background:#3CB815;color:#fff;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;flex-shrink:0;">@(shipper?.tenshipper?.Substring(0,1)?.ToUpper() ?? "S")</div>
                                    <span class="d-none d-lg-inline text-muted small fw-500">@(shipper?.tenshipper ?? "Shipper")</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-right" style="min-width:160px;border-radius:10px;box-shadow:0 4px 20px rgba(0,0,0,.12);border:1px solid rgba(0,0,0,.06);">
                                    <li><a class="dropdown-item d-flex align-items-center gap-2 py-2" href="@Url.Action("Index","Shipper")"><i class="fas fa-tachometer-alt" style="width:16px;color:var(--fs-green);"></i> Dashboard</a></li>
                                    <li><a class="dropdown-item d-flex align-items-center gap-2 py-2" href="@Url.Action("LichSu","Shipper")"><i class="fas fa-history" style="width:16px;color:var(--fs-green);"></i> Lịch sử</a></li>
                                    <li><a class="dropdown-item d-flex align-items-center gap-2 py-2" href="@Url.Action("CaiDat","Shipper")"><i class="fas fa-cog" style="width:16px;color:var(--fs-green);"></i> Cài đặt</a></li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li><a href="/Home/Logout" class="dropdown-item d-flex align-items-center gap-2 py-2 text-danger"><i class="fas fa-sign-out-alt" style="width:16px;"></i> Đăng xuất</a></li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                </nav>
            </div>
        </div>
        <!--**********************************
            Header end ti-comment-alt
        ***********************************-->
        <!--**********************************
            Sidebar start
        ***********************************-->
        <div class="deznav">
            <div class="deznav-scroll">
                <ul class="metismenu" id="menu">
                 
                 
                    <li>
                        <a class="has-arrow ai-icon" href="@Url.Action("QRDelivery","Shipper")" aria-expanded="false">
                            <i class="fas fa-qrcode" style="margin-right:8px;"></i>
                            <span class="nav-text">QR Giao hàng</span>
                        </a>
                    </li>
                    <li>
                        <a class="has-arrow ai-icon" href="@Url.Action("ViTien","Shipper")" aria-expanded="false">
                            <span class="nav-text">Ví</span>
                        </a>
                    </li>
                    <li>
                        <a class="has-arrow ai-icon" href="@Url.Action("LichSu","Shipper")" aria-expanded="false">
                            <span class="nav-text">Lịch sử đơn hàng</span>
                        </a>
                    </li>
                    <li>
                        <a class="has-arrow ai-icon" href="@Url.Action("CaiDat","Shipper")" aria-expanded="false">
                            <span class="nav-text">Cài đặt</span>
                        </a>
                    </li>
                </ul>

             
            </div>
        </div>


        @RenderBody()

        <!-- Required vendors -->
        <!-- ═══ FIX P1: jQuery ph?i load TR??C global.min.js ?? $ is not defined ═══ -->
        <script src="~/Source/Shipper/vendor/jquery/jquery.min.js"></script>
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
        <script src="~/Source/Shipper/vendor/global/global.min.js"></script>
        <script src="~/Source/Shipper/vendor/bootstrap-select/dist/js/bootstrap-select.min.js"></script>
        <script src="~/Source/Shipper/js/custom.min.js"></script>
        <script src="~/Source/Shipper/js/deznav-init.js"></script>
        <!-- Datatable -->
        <script src="~/Assets/vendor/datatables/js/jquery.dataTables.min.js"></script>

        <script>
            (function ($) {
                var table = $('#example5').DataTable({
                    searching: false,
                    paging: true,
                    select: false,
                    //info: false,
                    lengthChange: false,
                });
                $('#example tbody').on('click', 'tr', function () {
                    var data = table.row(this).data();
                });
            })(jQuery);
        </script>
        @RenderSection("scripts", required: false)
</body>

</html>

