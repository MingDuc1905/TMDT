# ============================================================
# FastShip .dockerignore — Tối ưu build trên Render
# ============================================================

# Exclude Skills repos (86MB+ exe file + thousands of files)
ShipFoodCore/Skills/

# Exclude .NET build artifacts
bin/
obj/
*.user
*.suo
*.sln.docstates

# Exclude Git
.git/
.gitattributes
.gitignore
.gitmodules

# Exclude Node.js / npm (not used in .NET backend)
node_modules/
npm-debug.log

# Exclude OS files
.DS_Store
Thumbs.db
*.swp
*.swo

# Exclude IDE files
.vs/
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Exclude logs
*.log
logs/

# Exclude test reports
e2e-tests/
playwright-report/
test-results/

# Exclude .codegraph
.codegraph/

# Exclude agents skills (already in ShipFoodCore/Skills/)
.agents/
