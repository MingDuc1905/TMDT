@inject ShipFood.Models.dbFoodyEntities _db
@{
    ViewBag.Title = "Giỏ hàng";
    Layout = "~/Views/Shared/_LayoutPageHome.cshtml";
    var cartJson = Context.Session.GetString("cart");
    ShipFood.Models.Cart? cart = cartJson != null ? JsonSerializer.Deserialize<ShipFood.Models.Cart>(cartJson) : null;
}

@section styles {
    <style>
        .cart-wrapper { margin-top: 100px; padding: 32px 0 60px; background: #f8f9fa; min-height: 70vh; }
        @@media (max-width: 768px) {
            .cart-wrapper { margin-top: 80px; padding: 20px 0 40px; }
            .cart-header { padding: 16px 20px; }
            .cart-header h3 { font-size: 17px; }
            .cart-item { flex-wrap: wrap; gap: 10px; padding: 14px 16px; }
            .cart-item img { width: 60px; height: 60px; }
            .cart-item .item-info { min-width: calc(100% - 76px); flex: 1; }
            .cart-item .item-name { font-size: 13px; }
            .cart-item .item-price { font-size: 12px; }
            .qty-control { order: 2; }
            .item-total { min-width: auto; font-size: 13px; order: 3; }
            .delete-btn { order: 4; }
            .cart-summary { padding: 18px; }
            .summary-total { font-size: 16px; }
        }
        @@media (max-width: 576px) {
            .cart-wrapper { margin-top: 70px; padding: 12px 0 30px; }
            .cart-item { padding: 12px; }
            .cart-item img { width: 48px; height: 48px; }
            .cart-item .item-name { font-size: 12px; }
            .qty-btn { width: 28px; height: 28px; font-size: 14px; }
            .qty-num { min-width: 28px; font-size: 14px; }
            .item-total { font-size: 12px; }
            .btn-checkout-go { font-size: 14px; padding: 12px; }
            .cart-summary { padding: 14px; }
            .restaurant-badge { font-size: 11px; padding: 3px 8px; }
        }
        .cart-header { background: linear-gradient(135deg,#3CB815,#27a001); color:#fff; border-radius: 16px 16px 0 0; padding: 20px 28px; }
        .cart-header h3 { margin: 0; font-weight: 700; font-size: 20px; }
        .cart-body { background: #fff; border-radius: 0 0 16px 16px; box-shadow: 0 4px 20px rgba(0,0,0,.07); overflow: hidden; }
        .cart-item { display: flex; align-items: center; gap: 16px; padding: 18px 24px; border-bottom: 1px solid #f0f0f0; transition: background .15s; }
        .cart-item:hover { background: #fafff9; }
        .cart-item:last-child { border-bottom: none; }
        .cart-item img { width: 80px; height: 80px; object-fit: cover; border-radius: 12px; flex-shrink: 0; border: 1px solid #eee; }
        .cart-item .item-info { flex: 1; }
        .cart-item .item-name { font-weight: 600; font-size: 15px; color: #1a1a2e; }
        .cart-item .item-price { color: #888; font-size: 13px; margin-top: 2px; }
        .qty-control { display: flex; align-items: center; gap: 8px; }
        .qty-btn { width: 32px; height: 32px; border: 1.5px solid #dee2e6; border-radius: 8px; background: #fff; cursor: pointer; font-size: 16px; font-weight: 600; display: flex; align-items: center; justify-content: center; transition: all .15s; color: #333; }
        .qty-btn:hover { border-color: #3CB815; color: #3CB815; background: #f0fff0; }
        .qty-num { min-width: 36px; text-align: center; font-weight: 700; font-size: 16px; }
        .item-total { font-weight: 700; font-size: 15px; color: #e74c3c; min-width: 110px; text-align: right; }
        .delete-btn { color: #ccc; cursor: pointer; padding: 6px; border-radius: 8px; transition: all .15s; border: none; background: none; }
        .delete-btn:hover { color: #dc3545; background: #fff0f0; }
        .cart-summary { background: #fff; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,.07); padding: 24px; }
        .summary-row { display: flex; justify-content: space-between; padding: 8px 0; font-size: 14px; }
        .summary-total { display: flex; justify-content: space-between; padding-top: 12px; margin-top: 8px; border-top: 2px solid #e74c3c; font-size: 18px; font-weight: 700; color: #e74c3c; }
        .btn-checkout-go { display: block; width: 100%; padding: 14px; background: linear-gradient(135deg,#3CB815,#27a001); color:#fff; border: none; border-radius: 10px; font-size: 15px; font-weight: 700; text-align: center; text-decoration: none; cursor: pointer; transition: opacity .2s; margin-top: 16px; }
        .btn-checkout-go:hover { opacity:.88; color:#fff; text-decoration:none; }
        .empty-cart { text-align: center; padding: 60px 24px; }
        .empty-cart svg { opacity: .25; margin-bottom: 16px; }
        .restaurant-badge { display: inline-flex; align-items: center; gap: 6px; background: #f0fff0; border: 1px solid #c3e6cb; color: #28a745; padding: 4px 12px; border-radius: 20px; font-size: 13px; font-weight: 500; }
    </style>
}

<div class="cart-wrapper">
    <div class="container">
        @if (TempData["CartError"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>@TempData["CartError"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (cart == null || cart.monAns.Count == 0)
        {
            <div class="cart-body" style="border-radius:16px;">
                <div class="empty-cart">
                    <svg width="80" height="80" viewBox="0 0 24 24" fill="none"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4zM3 6h18M16 10a4 4 0 01-8 0" stroke="#333" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <h4 style="color:#888;font-weight:600;">Giỏ hàng của bạn đang trống</h4>
                    <p style="color:#aaa;font-size:14px;">Hãy chọn món ăn từ các quán yêu thích</p>
                    <a href="@Url.Action("Index","Home")" class="btn-checkout-go" style="display:inline-block;width:auto;padding:12px 32px;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" style="margin-right:6px;vertical-align:middle;"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" stroke="white" stroke-width="2"/><polyline points="9 22 9 12 15 12 15 22" stroke="white" stroke-width="2"/></svg>
                        Khám phá quán ăn
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="cart-header d-flex align-items-center justify-content-between">
                        <h3>
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" style="margin-right:8px;vertical-align:middle;"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4zM3 6h18" stroke="white" stroke-width="2" stroke-linecap="round"/></svg>
                            Giỏ hàng
                        </h3>
                        @if (cart.maquanan != null)
                        {
                            var quanAn = _db.tbQuanAn.Find(cart.maquanan);
                            if (quanAn != null)
                            {
                                <div class="restaurant-badge" style="background:rgba(255,255,255,.2);border-color:rgba(255,255,255,.4);color:#fff;">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 3a4 4 0 110 8 4 4 0 010-8zM23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75" stroke="white" stroke-width="2" stroke-linecap="round"/></svg>
                                    @quanAn.tenquanan
                                </div>
                            }
                        }
                    </div>
                    <div class="cart-body" id="cart-items-container">
                        @foreach (var i in cart.monAns)
                        {
                            <div class="cart-item" id="item-row-@i.mamon">
                                <img src="~/Source/images/MonAn/@i.hinhanh" alt="@i.tenmon"
                                     onerror="this.src='/Source/Home/img/food-placeholder.png'">
                                <div class="item-info">
                                    <div class="item-name">@i.tenmon</div>
                                    <div class="item-price">@i.giatien?.ToString("N0") đ / phần</div>
                                </div>
                                <div class="qty-control">
                                    <button class="qty-btn btn-giam" data-mamon="@i.mamon" title="Giảm">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><line x1="5" y1="12" x2="19" y2="12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
                                    </button>
                                    <span class="qty-num so-luong-@i.mamon">@i.soLuong</span>
                                    <button class="qty-btn btn-tang" data-mamon="@i.mamon" title="Tăng">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><line x1="12" y1="5" x2="12" y2="19" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><line x1="5" y1="12" x2="19" y2="12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
                                    </button>
                                </div>
                                <div class="item-total item-total-@i.mamon">@((i.giatien * i.soLuong)?.ToString("N0")) đ</div>
                                <a href="@Url.Action("XoaMon","Cart")?maMonAn=@i.mamon" class="delete-btn" title="Xóa món">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><polyline points="3 6 5 6 21 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6M10 11v6M14 11v6M9 6V4a1 1 0 011-1h4a1 1 0 011 1v2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                                </a>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="cart-summary">
                        <div style="font-size:17px;font-weight:700;margin-bottom:16px;display:flex;align-items:center;gap:8px;">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" stroke="#3CB815" stroke-width="2" stroke-linecap="round"/></svg>
                            Tóm tắt đơn hàng
                        </div>
                        <div class="summary-row">
                            <span style="color:#888;">Tổng món ăn</span>
                            <span id="cart-total">@cart.tongTien?.ToString("N0") đ</span>
                        </div>
                        <div class="summary-row">
                            <span style="color:#888;">Phí giao hàng</span>
                            <span>15,000 đ</span>
                        </div>
                        <div class="summary-total">
                            <span>Tổng cộng</span>
                            <span id="cart-grandtotal">@((cart.tongTien + 15000)?.ToString("N0")) đ</span>
                        </div>
                        <a href="@Url.Action("Checkout","Cart")" class="btn-checkout-go">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" style="margin-right:6px;vertical-align:middle;"><path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 001.95-1.57l1.65-7.43H6M10 21a1 1 0 110-2 1 1 0 010 2zM21 21a1 1 0 110-2 1 1 0 010 2z" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            Tiến hành thanh toán
                        </a>
                        <a href="@Url.Action("Index","Home")" style="display:block;text-align:center;color:#888;font-size:13px;margin-top:12px;text-decoration:none;">
                            ← Tiếp tục mua sắm
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section scripts {
<script>
$(document).ready(function () {
    // API JSON endpoints - tr? v? JSON thay vì parse HTML
    var tangApiUrl = '@Url.Action("ApiTangSoLuong","Cart")';
    var giamApiUrl = '@Url.Action("ApiGiamSoLuong","Cart")';

    $(document).on('click', '.btn-tang, .btn-giam', function(e) {
        e.preventDefault();
        var $btn = $(this);
        var maMonAn = $btn.data('mamon');
        var isTang = $btn.hasClass('btn-tang');
        var url = isTang ? tangApiUrl + '?maMonAn=' + maMonAn + '&soLuong=1' : giamApiUrl + '?maMonAn=' + maMonAn;

        $btn.prop('disabled', true);
        $.getJSON(url, function(res) {
            if (res.success) {
                // C?p nh?t s? lu?ng
                $('.so-luong-' + maMonAn).text(res.soLuong);
                // C?p nh?t giá t?ng món
                $('.item-total-' + maMonAn).text(res.itemTotal);
                // C?p nh?t t?ng ti?n gi? hàng
                $('#cart-total').text(res.cartTotal);
                $('#cart-grandtotal').text(res.cartGrandTotal);
            }
        }).always(function(){ $btn.prop('disabled', false); });
    });
});
</script>
}
