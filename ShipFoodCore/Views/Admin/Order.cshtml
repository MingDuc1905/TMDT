@model List<ShipFood.Models.tbDonHang>
@{
    ViewBag.Title = "Order";
    Layout = "~/Views/Shared/_LayoutPageAmin.cshtml";
}

<div class="content-body">
    <div class="container-fluid">
        <div class="row page-titles mx-0">
            <div class="col-sm-6 p-md-0">
                <div class="welcome-text">
                    <h4>Đơn hàng</h4>
                </div>
            </div>
            <div class="col-sm-6 p-md-0 justify-content-sm-end mt-2 mt-sm-0 d-flex">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="javascript:void(0)">Danh sách đơn hàng, chỉ những đơn hàng shipper nhận rồi mới xem được chi tiết</a></li>
                </ol>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-sm mb-0">
                                <thead>
                                    <tr>
                                        <th class="align-middle">Đơn hàng</th>
                                        <th class="align-middle pr-7">Ngày</th>
                                        <th class="align-middle" style="min-width: 12.5rem">Giao đến</th>
                                        <th class="align-middle text-right">Trạng thái</th>
                                        <th class="align-middle text-right">Tổng tiền</th>
                                        <th class="no-sort"></th>
                                    </tr>
                                </thead>
                                <tbody id="orders">
                                    @foreach(var item in Model) { 
                                    <tr class="btn-reveal-trigger">
                                        <td data-label="Đơn hàng" class="py-2">
                                            <a href="management-order-details.html"> <strong>#@item.madh</strong></a> bởi tài xế
                                            <strong>@(item.tbShipper == null ? "Trống" : item.tbShipper.tenshipper)</strong><br /><strong>@item.tbQuanAn.tenquanan</strong>
                                        </td>
                                        <td data-label="Ngày" class="py-2">@item.ngaydathang.Value.ToString("dd/MM/yyyy")</td>
                                        <td data-label="Giao đến" class="py-2">
                                            <strong>@item.tbThongTinDatHang.tennguoinhan</strong>, @item.tbThongTinDatHang.diachi
                                            <p class="mb-0 text-500">@item.ghichu</p>
                                        </td>
                                        <td data-label="Trạng thái" class="py-2 text-right">
                                            @{ if (item.trangthai == "Đã đặt" || item.trangthai == "Đã lấy")
                                                {
                                                    <span class="badge badge-primary">Xử lí<span class="ml-1 fa fa-redo"></span></span>
                                                }
                                                if (item.trangthai == "Đã hủy")
                                                {
                                                    <span class="badge badge-warning">Đã hủy<span class="ml-1 fas fa-stream"></span></span>
                                                }
                                                if (item.trangthai == "Hoàn thành")
                                                {
                                                    <span class="badge badge-success">Hoàn Thành<span class="ml-1 fa fa-check"></span></span>
                                                }
                                            }
                                        </td>
                                        <td data-label="Tổng tiền" class="py-2 text-right">@item.tongtien?.ToString("N0") VNĐ</td>
                                        <td data-label="" class="py-2 text-right">
                                            <div class="dropdown text-sans-serif">
                                                <button class="btn btn-primary tp-btn-light sharp"
                                                        type="button"
                                                        id="order-dropdown-0"
                                                        data-toggle="dropdown"
                                                        data-boundary="viewport"
                                                        aria-haspopup="true"
                                                        aria-expanded="false">
                                                    <span>
                                                        <svg xmlns="http://www.w3.org/2000/svg"
                                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                                             width="18px"
                                                             height="18px"
                                                             viewBox="0 0 24 24"
                                                             version="1.1">
                                                            <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                                                <rect x="0" y="0" width="24" height="24"></rect>
                                                                <circle fill="#000000" cx="5" cy="12" r="2"></circle>
                                                                <circle fill="#000000" cx="12" cy="12" r="2"></circle>
                                                                <circle fill="#000000" cx="19" cy="12" r="2"></circle>
                                                            </g>
                                                        </svg>
                                                    </span>
                                                </button>
                                                <div class="dropdown-menu dropdown-menu-right border py-0"
                                                     aria-labelledby="order-dropdown-0">
                                                    <div class="py-2">
                                                        <a class="dropdown-item" href="@Url.Action("OrderDetail","Admin", new {id =item.madh })">Xem chi tiết</a>
                                                        <div class="dropdown-divider"></div>
                                                        <a class="dropdown-item text-danger" href="#!">Xóa</a>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script>
// Phase 5: Admin Dashboard Real-time — tự động cập nhật đơn mới
$(document).ready(function() {
    var conn = new signalR.HubConnectionBuilder()
        .withUrl('/nhantin')
        .withAutomaticReconnect()
        .build();

    conn.on('newOrder', function(data) {
        var toast = $('<div style="position:fixed;top:80px;right:20px;z-index:9999;background:#3CB815;color:#fff;padding:14px 20px;border-radius:12px;box-shadow:0 4px 20px rgba(0,0,0,.2);font-size:13px;max-width:380px;">'
            + '<strong>📦 Đơn hàng mới!</strong><br>'
            + 'Mã ĐH: #' + data.orderId + ' — ' + (data.customerName || 'Khách') + '<br>'
            + '<small>' + (data.totalAmount || 0).toLocaleString('vi-VN') + ' đ</small>'
            + '</div>');
        $('body').append(toast);
        setTimeout(function(){ toast.fadeOut(400, function(){ $(this).remove(); }); }, 6000);
        setTimeout(function() { location.reload(); }, 2000);
    });

    conn.on('orderStatusChanged', function(madh, trangthai) {
        $('a[href*="OrderDetail?id=' + madh + '"]').closest('tr').css('background', '#fffde7');
        setTimeout(function() { $('a[href*="OrderDetail?id=' + madh + '"]').closest('tr').css('background', ''); }, 3000);
    });

    conn.start().catch(function(err) { console.error('Admin SignalR:', err); });
});
</script>
}
