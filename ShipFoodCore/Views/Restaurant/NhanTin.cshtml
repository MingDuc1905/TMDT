@{
    ViewBag.Title = "Nhắn tin | Fastship";
    Layout = "~/Views/Shared/_LayoutPageRestaurant.cshtml";
    var userJson = Context.Session.GetString("user");
    ShipFood.Models.tbUser? user = userJson != null ? System.Text.Json.JsonSerializer.Deserialize<ShipFood.Models.tbUser>(userJson) : null;
    var loggedIn = user != null && user.userid > 0;
}

<div class="container-fluid py-4">
    <div class="row g-4">
        <!-- Sidebar: Danh sách hội thoại -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="fw-bold mb-0"><i class="fas fa-comments text-success me-2"></i>Hội thoại</h6>
                </div>
                <div class="list-group list-group-flush" id="conversationList" style="max-height: 500px; overflow-y: auto;">
                    <div class="list-group-item text-muted text-center py-4">
                        <i class="fas fa-inbox fa-2x d-block mb-2" style="opacity:.3"></i>
                        Đang tải hội thoại...
                    </div>
                </div>
            </div>
        </div>

        <!-- Chat chính -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="fw-bold mb-0" id="chatPartnerName">
                            <i class="fas fa-user-circle text-success me-2"></i>Chọn hội thoại
                        </h6>
                        <small class="text-muted" id="chatPartnerStatus">Chọn một hội thoại để bắt đầu chat</small>
                    </div>
                    <span id="onlineDot" style="width:10px;height:10px;border-radius:50%;background:#ccc;display:inline-block;"></span>
                </div>

                <div class="card-body p-0" style="height: 400px; overflow-y: auto; background: #f8f9fa;" id="chatMessages">
                    <div class="text-center text-muted py-5">
                        <i class="fas fa-comment-dots fa-3x mb-3" style="opacity:.2"></i>
                        <p>Chọn một hội thoại bên trái để xem tin nhắn</p>
                    </div>
                </div>

                <div class="card-footer bg-white border-top p-3" id="chatInputArea" style="display:none;">
                    <div class="input-group">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="currentTargetUserId" value="0" />
                        <input type="text" class="form-control rounded-pill" id="msgInput" placeholder="Soạn tin nhắn..."
                               onkeypress="if(event.key==='Enter') sendMsg()" style="border-radius:24px!important;" />
                        <button class="btn btn-success rounded-pill ms-2 px-4" onclick="sendMsg()">
                            <i class="fas fa-paper-plane me-1"></i>Gửi
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        var userId = @(loggedIn ? user!.userid : 0);
        var userName = '@(loggedIn ? user!.username : "")';
        var conn = null;
        var targetUserId = 0;

        function getToken() { return document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''; }

        function connect() {
            if (!userId) return;
            conn = new signalR.HubConnectionBuilder()
                .withUrl('/nhantin')
                .withAutomaticReconnect()
                .build();

            conn.on('orderMessage', function(msg, orderId, senderName, senderRole, connId) {
                addMsg(msg, 'other', senderRole + ' - ' + senderName);
            });

            conn.on('directMessage', function(msg, senderName, senderRole, connId) {
                if (senderRole !== 'Quán ăn') {
                    addMsg(msg, 'other', senderRole + ' - ' + senderName);
                }
                loadConversations();
            });

            conn.on('adminMessage', function(msg, orderId, sender) {
                addMsg(msg, 'other', 'Admin');
                loadConversations();
            });

            conn.onclose(function() { setTimeout(connect, 5000); });

            conn.start().then(function() {
                conn.invoke('JoinRestaurantGroup', userId).catch(function(){});
            }).catch(function() {});
        }

        function sendMsg() {
            var input = document.getElementById('msgInput');
            var msg = input.value.trim();
            if (!msg || !targetUserId) return;

            addMsg(msg, 'own', 'Bạn');
            input.value = '';

            var formData = new FormData();
            formData.append('__RequestVerificationToken', getToken());
            formData.append('orderId', '0');
            formData.append('message', msg);
            formData.append('targetUserId', targetUserId);

            $.ajax({
                url: '@Url.Action("CustomerSendMessage", "AdminChat")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                error: function() { addMsg('❌ Lỗi gửi tin nhắn', 'other', 'Hệ thống'); }
            });
        }

        function addMsg(text, type, label) {
            var c = document.getElementById('chatMessages');
            var d = document.createElement('div');
            d.className = 'msg px-3 py-2 mb-2';
            d.style.maxWidth = '80%';
            d.style.borderRadius = '12px';
            d.style.clear = 'both';
            d.style.wordWrap = 'break-word';
            if (type === 'own') {
                d.style.cssFloat = 'right';
                d.style.background = 'linear-gradient(135deg,#3CB815,#2ea310)';
                d.style.color = '#fff';
                d.style.borderBottomRightRadius = '4px';
            } else {
                d.style.cssFloat = 'left';
                d.style.background = '#fff';
                d.style.border = '1.5px solid #e5e7eb';
                d.style.color = '#1a1a2e';
                d.style.borderBottomLeftRadius = '4px';
            }
            var time = new Date().toLocaleTimeString('vi-VN', {hour:'2-digit',minute:'2-digit'});
            d.innerHTML = '<small style="font-size:10px;opacity:.65;display:block;margin-bottom:2px;">' + (label || '') + '</small>'
                + escHtml(text).replace(/\n/g, '<br/>')
                + '<small style="font-size:10px;opacity:.6;display:block;margin-top:4px;text-align:right;">' + time + '</small>';
            c.appendChild(d);
            c.scrollTop = c.scrollHeight;
        }

        function loadConversations() {
            $.ajax({
                url: '@Url.Action("GetConversations", "AdminChat")',
                type: 'GET',
                success: function(res) {
                    if (!res.success) return;
                    var list = document.getElementById('conversationList');
                    list.innerHTML = '';
                    if (!res.data || res.data.length === 0) {
                        list.innerHTML = '<div class="list-group-item text-muted text-center py-4">'
                            + '<i class="fas fa-inbox fa-2x d-block mb-2" style="opacity:.3"></i>'
                            + 'Chưa có hội thoại nào</div>';
                        return;
                    }
                    res.data.forEach(function(c) {
                        var active = c.userId === targetUserId ? ' active' : '';
                        var item = document.createElement('a');
                        item.href = '#';
                        item.className = 'list-group-item list-group-item-action d-flex align-items-center gap-3' + active;
                        item.onclick = function(e) { e.preventDefault(); selectConversation(c.userId, c.tenkh); };
                        var initial = (c.tenkh || 'K').charAt(0).toUpperCase();
                        var colors = ['#3CB815','#007bff','#e74c3c','#f39c12','#9b59b6'];
                        var bg = colors[c.userId % colors.length];
                        item.innerHTML = '<div style="width:44px;height:44px;border-radius:50%;background:' + bg
                            + ';color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:16px;flex-shrink:0;">'
                            + initial + '</div>'
                            + '<div style="flex:1;min-width:0;">'
                            + '<div style="font-weight:600;font-size:14px;">' + escHtml(c.tenkh) + '</div>'
                            + '<div style="font-size:12px;color:#888;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">'
                            + escHtml(c.lastMessage) + '</div></div>'
                            + (c.hasUnread ? '<span class="badge bg-danger rounded-pill">' + c.messageCount + '</span>' : '');
                        list.appendChild(item);
                    });
                }
            });
        }

        function selectConversation(uid, name) {
            targetUserId = uid;
            document.getElementById('chatPartnerName').innerHTML = '<i class="fas fa-user-circle text-success me-2"></i>' + escHtml(name);
            document.getElementById('chatPartnerStatus').textContent = 'Đang chat...';
            document.getElementById('chatInputArea').style.display = 'block';
            document.getElementById('currentTargetUserId').value = uid;
            document.getElementById('onlineDot').style.background = '#3CB815';

            var c = document.getElementById('chatMessages');
            c.innerHTML = '<div style="text-align:center;padding:20px;color:#888;"><i class="fas fa-spinner fa-spin me-2"></i>Đang tải tin nhắn...</div>';

            $.ajax({
                url: '@Url.Action("GetCustomerMessages", "AdminChat")',
                type: 'GET', data: { userId: uid },
                success: function(res) {
                    c.innerHTML = '';
                    if (!res.success || !res.data || res.data.length === 0) {
                        addMsg('Bắt đầu cuộc trò chuyện!', 'other', 'Hệ thống');
                        return;
                    }
                    res.data.forEach(function(msg) {
                        var isOwn = msg.sender === 'Admin' || msg.sender === 'Shipper';
                        addMsg(msg.content, isOwn ? 'own' : 'other', isOwn ? 'Bạn' : msg.sender);
                    });
                },
                error: function() { c.innerHTML = '<div class="text-center text-danger py-4">Lỗi tải tin nhắn</div>'; }
            });
        }

        function escHtml(str) {
            if (!str) return '';
            var d = document.createElement('div'); d.textContent = str; return d.innerHTML;
        }

        $(document).ready(function() {
            if (userId) {
                connect();
                loadConversations();
                setInterval(loadConversations, 15000);
            }
        });
    </script>
}
