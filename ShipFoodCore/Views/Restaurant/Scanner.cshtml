@{
    ViewBag.Title = "Quét mã QR";
    Layout = "~/Views/Shared/_LayoutPageRestaurant.cshtml";
}

<style>
    .scanner-wrapper {
        padding: 20px; max-width: 600px; margin: 0 auto; min-height: calc(100vh - 120px);
        display: flex; flex-direction: column;
    }
    .scanner-wrapper h2 {
        font-size: 22px; font-weight: 700; color: #1a1a2e; margin: 0 0 4px;
        display: flex; align-items: center; gap: 10px;
    }
    .scanner-wrapper p { color: #6b7280; font-size: 13px; margin: 0 0 20px; }

    /* ── Scanner Box ── */
    .scanner-box {
        background: #fff; border-radius: 20px; padding: 20px;
        box-shadow: 0 4px 24px rgba(0,0,0,.06);
        border: 2px solid #f0f0f0; margin-bottom: 20px;
        position: relative; overflow: hidden;
    }
    .scanner-box::before {
        content: ''; position: absolute; inset: 0;
        background: linear-gradient(135deg, rgba(60,184,21,.03) 0%, transparent 50%);
        pointer-events: none;
    }

    #qr-reader {
        width: 100% !important; border: none !important;
        border-radius: 12px !important; overflow: hidden;
    }
    #qr-reader video { border-radius: 12px !important; }
    #qr-reader__scan_region { background: #f8f9fa; min-height: 280px; display: flex; align-items: center; justify-content: center; }
    #qr-reader__dashboard_section_csr button {
        background: #3CB815; color: #fff; border: none;
        padding: 8px 20px; border-radius: 8px; font-weight: 600; font-size: 13px;
        cursor: pointer; transition: all .2s;
    }
    #qr-reader__dashboard_section_csr button:hover { background: #34a013; }

    /* ── Scan Result ── */
    .scan-result {
        background: #fff; border-radius: 16px; padding: 20px;
        box-shadow: 0 4px 20px rgba(0,0,0,.06);
        border: 1px solid #f0f0f0;
        display: none; animation: fadeIn .3s ease;
    }
    @@keyframes fadeIn { 0% { opacity: 0; transform: translateY(10px); } 100% { opacity: 1; transform: translateY(0); } }

    .scan-result.success { border-color: #c3e6cb; display: block; }
    .scan-result.error { border-color: #f5c6cb; display: block; }
    .scan-result .icon { font-size: 36px; margin-bottom: 8px; }
    .scan-result h3 { font-size: 16px; font-weight: 700; margin: 0 0 8px; }
    .scan-result p { font-size: 13px; color: #6b7280; margin: 0; line-height: 1.6; }

    .scan-result .details { margin: 12px 0; padding: 12px; background: #f8f9fa; border-radius: 10px; }
    .scan-result .details .row { display: flex; justify-content: space-between; padding: 4px 0; font-size: 13px; }
    .scan-result .details .label { color: #6b7280; }
    .scan-result .details .value { font-weight: 600; color: #1a1a2e; }

    /* ── Scan History ── */
    .scan-history { margin-top: 16px; }
    .scan-history h4 { font-size: 14px; font-weight: 600; color: #1a1a2e; margin: 0 0 12px; }
    .history-item {
        display: flex; align-items: center; gap: 12px;
        padding: 10px 14px; background: #f8f9fa; border-radius: 10px;
        margin-bottom: 8px; font-size: 13px;
    }
    .history-item .time { color: #6b7280; font-size: 11px; flex-shrink: 0; }
    .history-item .order-id { font-weight: 700; color: #1a1a2e; }
    .history-item .status { margin-left: auto; padding: 2px 10px; border-radius: 12px; font-size: 11px; font-weight: 600; }
    .history-item .status.success { background: #f0fdf4; color: #16a34a; }

    /* ── Switch Camera ── */
    .camera-controls { display: flex; gap: 8px; margin-top: 12px; flex-wrap: wrap; }
    .camera-controls .btn {
        padding: 8px 16px; border-radius: 8px; font-size: 12px; font-weight: 600;
        border: 1px solid #e5e7eb; background: #fff; cursor: pointer; transition: all .2s;
    }
    .camera-controls .btn:hover { border-color: #3CB815; color: #3CB815; }
    .camera-controls .btn.active { background: #3CB815; color: #fff; border-color: #3CB815; }

    @@media (max-width: 576px) {
        .scanner-wrapper { padding: 12px; }
        #qr-reader__scan_region { min-height: 200px; }
    }
</style>

<div class="scanner-wrapper">
    <h2>
        <i class="fas fa-camera" style="color:#3CB815;"></i>
        Quét mã QR
    </h2>
    <p>Đưa mã QR từ màn hình Shipper vào khung để xác nhận lấy hàng</p>

    <!-- Scanner -->
    <div class="scanner-box">
        <div id="qr-reader"></div>
        <div class="camera-controls">
            <button class="btn active" id="btnStartScan" onclick="startScanner()">
                <i class="fas fa-play"></i> Bắt đầu quét
            </button>
            <button class="btn" id="btnStopScan" onclick="stopScanner()">
                <i class="fas fa-stop"></i> Dừng
            </button>
            <button class="btn" id="btnSwitchCamera" onclick="switchCamera()">
                <i class="fas fa-sync-alt"></i> Đổi camera
            </button>
        </div>
    </div>

    <!-- Scan Result -->
    <div class="scan-result" id="scanResult">
        <div class="icon" id="resultIcon">✅</div>
        <h3 id="resultTitle">Quét thành công!</h3>
        <div class="details" id="resultDetails"></div>
        <p id="resultMessage"></p>
    </div>

    <!-- Scan History -->
    <div class="scan-history">
        <h4><i class="fas fa-history" style="color:#3CB815;"></i> Lịch sử quét</h4>
        <div id="scanHistory">
            <div style="text-align:center;padding:16px;color:#9ca3af;font-size:13px;">
                Chưa có lượt quét nào
            </div>
        </div>
    </div>
</div>

<!-- html5-qrcode library -->
<script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
<script>
    let html5QrCode = null;
    let lastScannedToken = '';
    let scanHistory = JSON.parse(localStorage.getItem('restaurantScanHistory') || '[]');

    // Render scan history
    function renderHistory() {
        var container = document.getElementById('scanHistory');
        if (scanHistory.length === 0) {
            container.innerHTML = '<div style="text-align:center;padding:16px;color:#9ca3af;font-size:13px;">Chưa có lượt quét nào</div>';
            return;
        }
        container.innerHTML = scanHistory.slice().reverse().map(function(item) {
            return '<div class="history-item">'
                + '<span class="time">' + item.time + '</span>'
                + '<span class="order-id">#' + item.orderId + '</span>'
                + '<span style="color:#6b7280;font-size:12px;">' + item.restaurant + '</span>'
                + '<span class="status success">✅ ' + item.status + '</span>'
                + '</div>';
        }).join('');
    }
    renderHistory();

    function stopScanner() {
        if (html5QrCode) {
            try { html5QrCode.stop().catch(function(){}); } catch(e) {}
        }
        document.getElementById('btnStartScan').innerHTML = '<i class="fas fa-play"></i> Bắt đầu quét';
    }

    var _currentCameraIndex = 0;
    var _availableCameras = [];

    function startScanner(facingMode) {
        stopScanner();
        if (!html5QrCode) {
            html5QrCode = new Html5Qrcode("qr-reader");
        }

        document.getElementById('btnStartScan').innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang mở camera...';

        // Get cameras then start
        Html5Qrcode.getCameras().then(function(cameras) {
            _availableCameras = cameras;
            if (cameras.length === 0) {
                showResult('error', '❌', 'Không tìm thấy camera', 'Vui lòng kiểm tra quyền truy cập camera trên thiết bị của bạn.');
                document.getElementById('btnStartScan').innerHTML = '<i class="fas fa-play"></i> Bắt đầu quét';
                return;
            }

            var cameraId = cameras[0].id;
            // Try to find back camera
            if (facingMode) {
                var found = cameras.find(function(c) { return c.label && c.label.toLowerCase().includes(facingMode); });
                if (found) cameraId = found.id;
            }

            // Try rear camera first (merchant scans from phone)
            var rearCam = cameras.find(function(c) {
                return c.label && (c.label.toLowerCase().includes('back') || c.label.toLowerCase().includes('rear') || c.label.toLowerCase().includes('máy ảnh'));
            });
            if (rearCam && !facingMode) cameraId = rearCam.id;

            html5QrCode.start(
                cameraId,
                {
                    fps: 10,
                    qrbox: { width: 250, height: 250 }
                },
                onScanSuccess,
                function() {}
            ).then(function() {
                document.getElementById('btnStartScan').innerHTML = '<i class="fas fa-play"></i> 📷 Đang quét...';
                document.getElementById('btnStartScan').style.background = '#16a34a';
            }).catch(function(err) {
                showResult('error', '❌', 'Lỗi camera', err);
                document.getElementById('btnStartScan').innerHTML = '<i class="fas fa-play"></i> Bắt đầu quét';
            });
        }).catch(function(err) {
            showResult('error', '❌', 'Lỗi camera', err);
            document.getElementById('btnStartScan').innerHTML = '<i class="fas fa-play"></i> Bắt đầu quét';
        });
    }

    function switchCamera() {
        _currentCameraIndex = (_currentCameraIndex + 1) % (_availableCameras.length || 1);
        if (_availableCameras.length > 0) {
            startScanner();
        }
    }

    function onScanSuccess(decodedText) {
        // decodedText is the URL: https://domain/edelivery/scan/{token}
        if (!decodedText || decodedText === lastScannedToken) return;
        lastScannedToken = decodedText;

        // Extract token from URL
        var token = '';
        if (decodedText.includes('/edelivery/scan/')) {
            token = decodedText.split('/edelivery/scan/')[1];
        } else if (decodedText.includes('edelivery/scan/')) {
            token = decodedText.split('edelivery/scan/')[1];
        } else {
            token = decodedText; // assume token directly
        }

        // Vibrate on scan
        if (navigator.vibrate) navigator.vibrate(200);

        // Call API to confirm scan
        $.ajax({
            url: '/edelivery/confirm-scan',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ token: token }),
            success: function(res) {
                if (res.success) {
                    showResult('success', '✅', 'Xác nhận thành công!',
                        'Đơn hàng #' + res.orderId + ' đã được chuyển sang trạng thái <strong>Đã lấy</strong>');

                    // Add to history
                    scanHistory.push({
                        orderId: res.orderId,
                        restaurant: 'FastShip',
                        status: 'Đã lấy',
                        time: new Date().toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' })
                    });
                    if (scanHistory.length > 20) scanHistory.shift();
                    localStorage.setItem('restaurantScanHistory', JSON.stringify(scanHistory));
                    renderHistory();

                    // Play success sound
                    try {
                        var ctx = new (window.AudioContext || window.webkitAudioContext)();
                        var osc = ctx.createOscillator();
                        var gain = ctx.createGain();
                        osc.connect(gain); gain.connect(ctx.destination);
                        osc.frequency.value = 880; osc.type = 'sine';
                        gain.gain.setValueAtTime(0.3, ctx.currentTime);
                        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.3);
                        osc.start(ctx.currentTime); osc.stop(ctx.currentTime + 0.3);
                    } catch(e) {}

                    // Pause scanner briefly (2.5s)
                    stopScanner();
                    setTimeout(function() {
                        if (html5QrCode) startScanner();
                    }, 2500);
                } else {
                    showResult('error', '❌', 'Quét thất bại', res.message);
                }
            },
            error: function(xhr) {
                var msg = 'Lỗi kết nối máy chủ. Vui lòng thử lại.';
                try { var r = JSON.parse(xhr.responseText); msg = r.message || msg; } catch(e) {}
                showResult('error', '❌', 'Lỗi hệ thống', msg);
            }
        });
    }

    function showResult(type, icon, title, message) {
        var el = document.getElementById('scanResult');
        el.className = 'scan-result ' + type;
        document.getElementById('resultIcon').textContent = icon;
        document.getElementById('resultTitle').textContent = title;
        document.getElementById('resultMessage').innerHTML = message;
        el.style.display = 'block';

        if (type === 'success') {
            el.style.borderColor = '#c3e6cb';
            el.style.background = '#f0fff0';
        } else {
            el.style.borderColor = '#f5c6cb';
            el.style.background = '#fff5f5';
        }
    }

    // Auto-start scanner on load
    $(document).ready(function() {
        setTimeout(function() { startScanner('back'); }, 500);
    });

    // Cleanup on page unload
    window.addEventListener('beforeunload', function() {
        if (html5QrCode) {
            try { html5QrCode.stop().catch(function(){}); } catch(e) {}
        }
    });
</script>
