@{
    ViewBag.Title = "Đặt hàng thành công";
    Layout = "~/Views/Shared/_LayoutPageHome.cshtml";
    var successMsg = ViewBag.SuccessMessage ?? TempData["OrderSuccess"] as string ?? "Đặt hàng thành công!";
    var orderId = ViewBag.OrderId ?? TempData["OrderId"];
}

<style>
    .success-wrapper {
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 16px;
        background: linear-gradient(135deg, #f0fff0, #e8f5e9);
    }
    .success-card {
        background: #fff;
        border-radius: 24px;
        padding: 48px 40px;
        text-align: center;
        max-width: 500px;
        width: 100%;
        box-shadow: 0 8px 40px rgba(60,184,21,.15);
        animation: slideUp .5s ease;
    }
    @@keyframes slideUp { 0%{transform:translateY(30px);opacity:0} 100%{transform:translateY(0);opacity:1} }
    .success-icon {
        width: 100px; height: 100px;
        background: linear-gradient(135deg, #3CB815, #20c997);
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 24px;
        box-shadow: 0 8px 24px rgba(60,184,21,.3);
    }
    .btn-action {
        display: inline-block; padding: 12px 32px;
        border-radius: 10px; font-weight: 600; font-size: 15px;
        text-decoration: none; transition: all .2s;
    }
    .btn-history { background: linear-gradient(135deg,#3CB815,#27a001); color: #fff; }
    .btn-history:hover { opacity: .88; color: #fff; }
    .btn-home { background: #f0f2f5; color: #333; border: 1.5px solid #dee2e6; }
    .btn-home:hover { background: #dee2e6; color: #333; }
</style>

<div class="success-wrapper" style="margin-top:80px;">
    <div class="success-card">
        <div class="success-icon">
            <svg width="50" height="50" viewBox="0 0 24 24" fill="none">
                <path d="M20 6L9 17L4 12" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>
        <h2 style="font-weight:800;color:#1a1a2e;margin-bottom:8px;">Đặt hàng thành công!</h2>
        <p style="color:#666;font-size:15px;margin-bottom:8px;">@successMsg</p>
        <p style="color:#999;font-size:13px;margin-bottom:32px;">
            Đơn hàng của bạn đã được xác nhận. Shipper sẽ liên hệ với bạn sớm nhất.
        </p>
        <div style="background:#f8fff8;border:1px solid #c3e6cb;border-radius:12px;padding:16px;margin-bottom:28px;text-align:left;">
            <div style="display:flex;align-items:center;gap:10px;color:#28a745;font-size:14px;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="#28a745" stroke-width="2"/><path d="M12 6v6l4 2" stroke="#28a745" stroke-width="2" stroke-linecap="round"/></svg>
                Thời gian giao hàng dự kiến: <strong>30-45 phút</strong>
            </div>
        </div>
        <div class="d-flex gap-3 justify-content-center flex-wrap">
            <a href="@Url.Action("LichSuDatHang","Cart")" class="btn-action btn-history">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" style="margin-right:6px;vertical-align:middle;"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" stroke="white" stroke-width="2" stroke-linecap="round"/></svg>
                Xem lịch sử đơn hàng
            </a>
            <a href="@Url.Action("Index","Home")" class="btn-action btn-home">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" style="margin-right:6px;vertical-align:middle;"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" stroke="#333" stroke-width="2"/><polyline points="9 22 9 12 15 12 15 22" stroke="#333" stroke-width="2"/></svg>
                Về trang chủ
            </a>
        </div>
    </div>
</div>
