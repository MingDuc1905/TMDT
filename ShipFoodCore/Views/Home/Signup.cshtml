@{
    ViewBag.Title = "Đăng ký";
    Layout = "~/Views/Shared/_LayoutAuth.cshtml";
}

@section authNavRight {
    <a href="~/Home/Login" class="fs-btn fs-btn-primary" style="padding:7px 18px;border-radius:20px;font-size:13px;font-weight:600;white-space:nowrap;">Đăng nhập</a>
}

<div class="auth-card auth-container">
    <a href="~/Home" style="text-decoration:none;">
        <h1 style="color:var(--fs-green);font-size:28px;margin-bottom:4px;font-weight:700;">
            F<span style="color:var(--fs-orange);">ast</span>ship
        </h1>
    </a>

    <!-- ═══ 2-Step Progress Bar ═══ -->
    <div class="fs-wp-2" id="wizardProgress2">
        <div class="fs-wp-2-step active" data-step="1">
            <span class="step-num">1</span>
            <span class="step-label">Vai trò</span>
        </div>
        <div class="fs-wp-2-line" data-step="1-2"></div>
        <div class="fs-wp-2-step" data-step="2">
            <span class="step-num">2</span>
            <span class="step-label">Thông tin</span>
        </div>
    </div>

    <!-- ═══ FORM ═══ -->
    <form id="signupForm" method="post" action="~/Home/Signup">
        @Html.AntiForgeryToken()
        <input type="hidden" name="loaitaikhoan" id="hiddenRole" value="" />
        <input type="hidden" name="diachi" id="hiddenDiachi" value="" />

        <!-- ═══════════ BƯỚC 1: CHỌN VAI TRÒ ═══════════ -->
        <div class="fs-step-2 active" id="step1">
            <div class="fs-step-inner">
                <div class="fs-step-title">Bạn muốn đăng ký với tư cách gì?</div>
                <div class="fs-step-sub">Chọn vai trò của bạn trên Fastship</div>

                <!-- Role Cards -->
                <div class="fs-role-grid" id="roleGrid">
                    <div class="fs-role-card role-customer" onclick="selectRole(this, 'Khách hàng')" role="button" tabindex="0" aria-label="Đăng ký làm Khách hàng" onkeydown="if(event.key==='Enter'||event.key===' ')selectRole(this,'Khách hàng')">
                        <input type="radio" name="roleRadio" value="Khách hàng" id="role-customer">
                        <div class="role-icon"><i class="fas fa-user"></i></div>
                        <div class="role-info">
                            <div class="role-name">Khách hàng</div>
                            <div class="role-desc">Đặt món ăn, theo dõi đơn hàng</div>
                        </div>
                        <div class="role-check"><i class="fas fa-check"></i></div>
                    </div>
                    <div class="fs-role-card role-restaurant" onclick="selectRole(this, 'Quán ăn')" role="button" tabindex="0" aria-label="Đăng ký làm Đối tác Quán ăn" onkeydown="if(event.key==='Enter'||event.key===' ')selectRole(this,'Quán ăn')">
                        <input type="radio" name="roleRadio" value="Quán ăn" id="role-restaurant">
                        <div class="role-icon"><i class="fas fa-store"></i></div>
                        <div class="role-info">
                            <div class="role-name">Đối tác Quán ăn</div>
                            <div class="role-desc">Quản lý thực đơn, đơn hàng</div>
                        </div>
                        <div class="role-check"><i class="fas fa-check"></i></div>
                    </div>
                    <div class="fs-role-card role-shipper" onclick="selectRole(this, 'Shipper')" role="button" tabindex="0" aria-label="Đăng ký làm Tài xế Shipper" onkeydown="if(event.key==='Enter'||event.key===' ')selectRole(this,'Shipper')">
                        <input type="radio" name="roleRadio" value="Shipper" id="role-shipper">
                        <div class="role-icon"><i class="fas fa-motorcycle"></i></div>
                        <div class="role-info">
                            <div class="role-name">Tài xế Shipper</div>
                            <div class="role-desc">Nhận đơn giao hàng, kiếm thu nhập</div>
                        </div>
                        <div class="role-check"><i class="fas fa-check"></i></div>
                    </div>
                </div>

                <!-- Social Signup (icons) - matching Login exactly -->
                @{
                    var googleId = ViewContext.HttpContext.RequestServices
                        .GetService<Microsoft.Extensions.Configuration.IConfiguration>()?
                        ["Authentication:Google:ClientId"];
                    bool googleEnabled = !string.IsNullOrEmpty(googleId);

                    var fbAppId = ViewContext.HttpContext.RequestServices
                        .GetService<Microsoft.Extensions.Configuration.IConfiguration>()?
                        ["Authentication:Facebook:AppId"];
                    bool fbEnabled = !string.IsNullOrEmpty(fbAppId);
                }
                @if (googleEnabled || fbEnabled)
                {
                    <div class="divider">hoặc</div>
                    <div class="fs-social-icons">
                        @if (googleEnabled)
                        {
                            <a href="@Url.Action("GoogleLogin","Home")" class="fs-social-icon" aria-label="Đăng ký bằng Google" title="Đăng ký bằng Google">
                                <svg width="22" height="22" viewBox="0 0 48 48" fill="none"><path d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" fill="#EA4335"/><path d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" fill="#4285F4"/><path d="M10.54 28.59A14.5 14.5 0 0 1 9.5 24c0-1.59.28-3.14.76-4.59l-7.98-6.19A23.99 23.99 0 0 0 0 24c0 3.77.87 7.35 2.56 10.59l7.98-6z" fill="#FBBC05"/><path d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6C6.51 42.62 14.62 48 24 48z" fill="#34A853"/></svg>
                            </a>
                        }
                        @if (fbEnabled)
                        {
                            <a href="@Url.Action("FacebookLogin","Home")" class="fs-social-icon" aria-label="Đăng ký bằng Facebook" title="Đăng ký bằng Facebook">
                                <svg width="22" height="22" viewBox="0 0 48 48" fill="none">
                                    <path d="M24 0C10.74 0 0 10.74 0 24c0 13.26 10.74 24 24 24s24-10.74 24-24C48 10.74 37.26 0 24 0zm6.22 24.08h-3.29v15.06h-6.24V24.08h-3.15v-5.34h3.15v-3.24c0-2.61 1.24-6.69 6.68-6.69l4.9.02v5.46h-3.56c-.58 0-1.4.29-1.4 1.53v2.92h5l-.09 5.34z" fill="#1877F2"/>
                                </svg>
                            </a>
                        }
                    </div>
                    @if (googleEnabled)
                    {
                        <div style="text-align:center;margin-top:0;margin-bottom:4px;">
                            <a href="@Url.Action("GooglePartnerLogin","Home")" style="color:#4285F4;text-decoration:none;font-size:12px;font-weight:500;">
                                <i class="fas fa-store me-1"></i>Đăng ký làm Đối tác Quán ăn / Shipper
                            </a>
                        </div>
                    }
                }

                <!-- Error -->
                <div id="step1Error" class="alert alert-danger" role="alert" style="display:none;font-size:13px;padding:10px 12px;margin-bottom:12px;"></div>

                <!-- Next -->
                <div class="fs-signup-nav">
                    <button type="button" class="fs-btn-next" id="step1Next">Tiếp theo →</button>
                </div>
            </div>
        </div>

        <!-- ═══════════ BƯỚC 2: THÔNG TIN (gộp cả xác nhận) ═══════════ -->
        <div class="fs-step-2" id="step2">
            <div class="fs-step-inner">
                <div class="fs-step-title">Thông tin của bạn</div>
                <div class="fs-step-sub" id="step2Sub"><i class="fas fa-user me-1"></i>Khách hàng</div>

                <!-- Ho ten -->
                <div class="fs-signup-field">
                    <label for="inputHoten">Họ tên <span class="required">*</span></label>
                    <div class="fs-input-wrap">
                        <i class="fas fa-user fs-input-icon"></i>
                        <input type="text" class="fs-input-capsule" name="hoten" id="inputHoten" placeholder="Nhập họ tên" autocomplete="name" required />
                    </div>
                </div>

                <!-- Username -->
                <div class="fs-signup-field">
                    <label for="inputUsername">Tên đăng nhập <span class="required">*</span></label>
                    <div class="fs-input-wrap">
                        <i class="fas fa-user-tag fs-input-icon"></i>
                        <input type="text" class="fs-input-capsule" name="username" id="inputUsername" placeholder="VD: nguyenvan_a" autocomplete="username" required />
                    </div>
                    <div style="font-size:11px;color:#999;margin-top:4px;padding-left:4px;">Chỉ chứa chữ cái, số và dấu gạch dưới</div>
                </div>

                <!-- Email -->
                <div class="fs-signup-field">
                    <label for="inputEmail">Email <span class="required">*</span></label>
                    <div class="fs-input-wrap">
                        <i class="fas fa-envelope fs-input-icon"></i>
                        <input type="email" class="fs-input-capsule" name="email" id="inputEmail" placeholder="example@gmail.com" autocomplete="email" required />
                    </div>
                </div>

                <!-- SDT -->
                <div class="fs-signup-field">
                    <label for="inputSdt">Số điện thoại <span class="required">*</span></label>
                    <div class="fs-input-wrap">
                        <i class="fas fa-phone fs-input-icon"></i>
                        <input type="tel" class="fs-input-capsule" name="sdt" id="inputSdt" placeholder="0912345678" autocomplete="tel" required maxlength="11" />
                    </div>
                    <div style="font-size:11px;color:#999;margin-top:4px;padding-left:4px;">10-11 số, bắt đầu bằng 0</div>
                </div>

                <!-- Password fields (chỉ cho Quán ăn / Shipper) -->
                <div id="passwordFields" style="display:none;">
                    <div class="fs-signup-field">
                        <label for="inputPwd">Mật khẩu <span class="required">*</span></label>
                        <div class="fs-input-wrap fs-password-wrap">
                            <i class="fas fa-lock fs-input-icon"></i>
                            <input type="password" class="fs-input-capsule" name="pwd" id="inputPwd" placeholder="Tối thiểu 8 ký tự" autocomplete="new-password" />
                            <button type="button" class="fs-password-toggle" tabindex="-1" aria-label="Hiện/ẩn mật khẩu"><i class="fas fa-eye"></i></button>
                        </div>
                        <div class="fs-pwd-strength" id="pwdStrength" style="display:none;">
                            <div class="fs-pwd-bar"><div class="fs-pwd-bar-fill" id="pwdBarFill"></div></div>
                            <span class="fs-pwd-label" id="pwdLabel">Yếu</span>
                        </div>
                    </div>
                    <div class="fs-signup-field">
                        <label for="inputRepeatPwd">Xác nhận mật khẩu <span class="required">*</span></label>
                        <div class="fs-input-wrap fs-password-wrap">
                            <i class="fas fa-lock fs-input-icon"></i>
                            <input type="password" class="fs-input-capsule" name="repeatpw" id="inputRepeatPwd" placeholder="Nhập lại mật khẩu" autocomplete="new-password" />
                            <button type="button" class="fs-password-toggle" tabindex="-1" aria-label="Hiện/ẩn mật khẩu"><i class="fas fa-eye"></i></button>
                        </div>
                    </div>

                    <!-- Address (chỉ cho Quán ăn / Shipper) -->
                    <div class="fs-signup-field">
                        <label for="inputDistrict">Địa chỉ <span class="required">*</span></label>
                        <select class="fs-input-capsule" id="inputDistrict" aria-label="Quận/Huyện" style="margin-bottom:8px;padding-left:16px;">
                            <option value="">Chọn Quận/Huyện</option>
                            <option value="Quận 1">Quận 1</option>
                            <option value="Quận 3">Quận 3</option>
                            <option value="Quận 5">Quận 5</option>
                            <option value="Quận 7">Quận 7</option>
                            <option value="Bình Thạnh">Bình Thạnh</option>
                            <option value="Tân Bình">Tân Bình</option>
                            <option value="Gò Vấp">Gò Vấp</option>
                            <option value="Thủ Đức">Thủ Đức</option>
                            <option value="Hóc Môn">Hóc Môn</option>
                        </select>
                        <input type="text" class="fs-input-capsule" id="inputDetailAddr" placeholder="Số nhà, tên đường" maxlength="200" aria-label="Số nhà, tên đường" style="padding-left:16px;" />
                    </div>
                </div>

                <!-- Error -->
                <div id="step2Error" class="alert alert-danger" role="alert" style="display:none;font-size:13px;padding:10px 12px;margin-bottom:12px;"></div>

                <!-- Agreement checkbox -->
                <label class="fs-agree-wrap">
                    <input type="checkbox" id="agreeCheckbox" />
                    Tôi đồng ý với <a href="#">Điều khoản dịch vụ</a> của Fastship
                </label>

                <!-- Nav buttons -->
                <div class="fs-signup-nav">
                    <button type="button" class="fs-btn-prev" onclick="goToStep2(1)">← Quay lại</button>
                    <button type="submit" class="fs-btn-next" id="submitBtn" disabled>✓ Hoàn tất</button>
                </div>
            </div>
        </div>
    </form>

    <div style="text-align:center;margin-top:16px;font-size:13px;color:#888;">
        Đã có tài khoản? <a href="~/Home/Login" style="color:#3CB815;font-weight:600;text-decoration:none;">Đăng nhập</a>
    </div>
</div>

@section scripts {
<script>
var selectedRole = '';
var step2Data = { hoten: '', username: '', email: '', sdt: '', diachi: '' };

/* ─── Step navigation ─── */
function goToStep2(step) {
    document.querySelectorAll('.fs-step-2').forEach(function(el) { el.classList.remove('active'); });
    document.getElementById('step' + step).classList.add('active');
    document.querySelectorAll('.fs-wp-2-step').forEach(function(el) {
        var s = parseInt(el.getAttribute('data-step'));
        el.classList.remove('active', 'done');
        if (s === step) el.classList.add('active');
        else if (s < step) el.classList.add('done');
    });
    document.querySelectorAll('.fs-wp-2-line').forEach(function(el) {
        var pair = el.getAttribute('data-step').split('-');
        el.classList.toggle('done', parseInt(pair[1]) <= step);
    });
}

/* ─── Role selection ─── */
function selectRole(card, roleName) {
    document.querySelectorAll('.fs-role-card').forEach(function(c) { c.classList.remove('selected'); });
    card.classList.add('selected');
    card.querySelector('input[type="radio"]').checked = true;
    selectedRole = roleName;
    document.getElementById('hiddenRole').value = roleName;
    document.getElementById('step1Error').style.display = 'none';

    var sub = document.getElementById('step2Sub');
    var icons = { 'Khách hàng': 'user', 'Quán ăn': 'store', 'Shipper': 'motorcycle' };
    var labels = { 'Khách hàng': 'Khách hàng', 'Quán ăn': 'Đối tác Quán ăn', 'Shipper': 'Tài xế Shipper' };
    sub.innerHTML = '<i class="fas fa-' + (icons[roleName] || 'user') + ' me-1"></i>' + (labels[roleName] || roleName);

    var needsPwd = roleName === 'Quán ăn' || roleName === 'Shipper';
    document.getElementById('passwordFields').style.display = needsPwd ? 'block' : 'none';
    document.getElementById('inputPwd').required = needsPwd;
    document.getElementById('inputRepeatPwd').required = needsPwd;
    document.getElementById('inputDistrict').required = needsPwd;
}

document.getElementById('step1Next').addEventListener('click', function() {
    if (!selectedRole) {
        showErr('step1Error', 'Vui lòng chọn một vai trò để tiếp tục.');
        return;
    }
    goToStep2(2);
});

/* ─── Validation + Submit ─── */
function showErr(id, msg) {
    var el = document.getElementById(id);
    el.innerHTML = '<i class="fas fa-exclamation-circle me-1"></i>' + msg;
    el.style.display = 'block';
}
function clearErr(id) {
    document.getElementById(id).style.display = 'none';
}

document.getElementById('agreeCheckbox').addEventListener('change', function() {
    document.getElementById('submitBtn').disabled = !this.checked;
});

document.getElementById('signupForm').addEventListener('submit', function(e) {
    e.preventDefault();
    clearErr('step2Error');

    // Validate all fields
    var hoten = document.getElementById('inputHoten').value.trim();
    var username = document.getElementById('inputUsername').value.trim();
    var email = document.getElementById('inputEmail').value.trim();
    var sdt = document.getElementById('inputSdt').value.trim();

    if (!hoten || hoten.length < 2) { showErr('step2Error', 'Họ tên phải có ít nhất 2 ký tự'); return; }
    if (!username || username.length < 3) { showErr('step2Error', 'Tên đăng nhập phải có ít nhất 3 ký tự'); return; }
    if (!/^[a-zA-Z0-9_]+$/.test(username)) { showErr('step2Error', 'Tên đăng nhập chỉ được chứa chữ cái, số và dấu gạch dưới'); return; }
    if (!email || email.indexOf('\x40') < 1 || email.lastIndexOf('.') < email.indexOf('\x40') + 2) { showErr('step2Error', 'Email không hợp lệ'); return; }
    if (!sdt || !/^0[1-9][0-9]{8,9}$/.test(sdt)) { showErr('step2Error', 'Số điện thoại không hợp lệ (10-11 số, bắt đầu bằng 0)'); return; }

    if (selectedRole === 'Quán ăn' || selectedRole === 'Shipper') {
        var pwd = document.getElementById('inputPwd').value;
        var repeatPwd = document.getElementById('inputRepeatPwd').value;
        if (!pwd || pwd.length < 8) { showErr('step2Error', 'Mật khẩu phải có ít nhất 8 ký tự'); return; }
        if (pwd !== repeatPwd) { showErr('step2Error', 'Xác nhận mật khẩu không khớp'); return; }
        var district = document.getElementById('inputDistrict').value;
        var detail = document.getElementById('inputDetailAddr').value.trim();
        if (!district) { showErr('step2Error', 'Vui lòng chọn Quận/Huyện'); return; }
        if (!detail || detail.length < 3) { showErr('step2Error', 'Vui lòng nhập số nhà, tên đường'); return; }
        step2Data.diachi = detail + ', ' + district + ', TP. Hồ Chí Minh';
        document.getElementById('hiddenDiachi').value = step2Data.diachi;
    }

    // Submit via AJAX
    var btn = document.getElementById('submitBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Đang xử lý...';

    var formData = new FormData();
    formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
    formData.append('loaitaikhoan', selectedRole);
    formData.append('hoten', hoten);
    formData.append('username', username);
    formData.append('email', email);
    formData.append('sdt', sdt);
    formData.append('diachi', step2Data.diachi || '');
    if (selectedRole === 'Quán ăn' || selectedRole === 'Shipper') {
        formData.append('pwd', document.getElementById('inputPwd').value);
        formData.append('repeatpw', document.getElementById('inputRepeatPwd').value);
    }

    $.ajax({
        url: $('#signupForm').attr('action'),
        type: 'POST',
        data: formData,
        processData: false,
        contentType: false,
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
        success: function(response) {
            try {
                var json = typeof response === 'object' ? response : JSON.parse(response);
                if (json && json.success && json.redirectUrl) {
                    window.location.href = json.redirectUrl;
                    return;
                }
                if (json && json.success === false && json.message) {
                    showErr('step2Error', json.message);
                    btn.disabled = false;
                    btn.innerHTML = '✓ Hoàn tất';
                    return;
                }
            } catch(e) {}
            window.location.href = '/Home/Login';
        },
        error: function(xhr) {
            var msg = 'Lỗi kết nối. Vui lòng thử lại sau.';
            try {
                var resp = JSON.parse(xhr.responseText);
                if (resp && resp.message) msg = resp.message;
            } catch(e) {}
            showErr('step2Error', msg);
            btn.disabled = false;
            btn.innerHTML = '✓ Hoàn tất';
        }
    });
});

/* ─── Password strength ─── */
document.getElementById('inputPwd').addEventListener('input', function() {
    var pwd = this.value;
    var meter = document.getElementById('pwdStrength');
    var fill = document.getElementById('pwdBarFill');
    var label = document.getElementById('pwdLabel');
    if (!pwd) { meter.style.display = 'none'; return; }
    meter.style.display = 'flex';
    var score = 0;
    if (pwd.length >= 8) score += 25;
    if (pwd.length >= 12) score += 15;
    if (/[a-z]/.test(pwd)) score += 15;
    if (/[A-Z]/.test(pwd)) score += 15;
    if (/[0-9]/.test(pwd)) score += 15;
    if (/[^a-zA-Z0-9]/.test(pwd)) score += 15;
    var colors = ['#dc3545', '#dc3545', '#ffc107', '#ffc107', '#3CB815', '#3CB815'];
    var labels = ['Quá yếu', 'Yếu', 'Trung bình', 'Khá', 'Mạnh', 'Rất mạnh'];
    var idx = Math.min(Math.floor(score / 17), 5);
    fill.style.width = Math.min(score, 100) + '%';
    fill.style.background = colors[idx];
    label.textContent = labels[idx];
    label.style.color = colors[idx];
});

/* ─── Password toggle ─── */
document.querySelectorAll('#step2 .fs-password-toggle').forEach(function(btn) {
    btn.addEventListener('click', function() {
        var wrap = this.closest('.fs-password-wrap');
        var input = wrap.querySelector('input');
        var isPassword = input.type === 'password';
        input.type = isPassword ? 'text' : 'password';
        this.querySelector('i').className = isPassword ? 'fas fa-eye-slash' : 'fas fa-eye';
    });
});

/* ─── Escape HTML helper ─── */
function escHtml(str) {
    if (!str) return '';
    var d = document.createElement('div');
    d.textContent = str;
    return d.innerHTML;
}
</script>
}
