
@{
    ViewBag.Title = "ChiTietDonHang";
    Layout = "~/Views/Shared/_LayoutPageHome.cshtml";
    ShipFood.Models.tbDonHang donHang = ViewBag.donHang;
    var userJson = Context.Session.GetString("user");
    ShipFood.Models.tbUser? user = userJson != null ? JsonSerializer.Deserialize<tbUser>(userJson) : null;

}

@section styles {
    <style>
        /* Mobile responsive fixes for ChiTietDonHang */
        @@media (max-width: 768px) {
            .breadcrumb-section { margin-top: 80px !important; }
            .breadcrumb__text h2 { font-size: 20px; }
            .checkout.spad { padding-top: 30px; }
            .checkout__form h4 { font-size: 18px; }
            .checkout__order { margin-top: 20px; }
            #order-tracking-map { height: 180px !important; }
        }
        @@media (max-width: 576px) {
            .breadcrumb-section { margin-top: 60px !important; }
            .checkout__order { padding: 16px; }
            .checkout__order ul li { font-size: 13px; }
            .checkout__order__total { font-size: 14px; }
        }
    </style>
}
    <!-- Breadcrumb Section Begin -->
    <section style="margin-top:130px" class="breadcrumb-section set-bg" data-setbg="@Url.Content("~/Source/Restaurant/images/card/2.png")">
        <div class="container">
            <div class="row">
                <div class="col-lg-12 text-center">
                    <div class="breadcrumb__text">
                        <h2 style="color:green">Checkout</h2>
                        <div class="breadcrumb__option">
                            <a href="~/Home">Trang chủ</a>
                            <span>Checkout</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Breadcrumb Section End -->
    <!-- Checkout Section Begin -->
    <section class="checkout spad">
        <div class="container">
            <div class="checkout__form">
                <h4>Thông tin chi tiết đơn hàng</h4>

                <div class="row">
                    <div class="col-lg-8 col-md-6 formInfor">
                        <!-- ═══ FLAT INVOICE LABELS: thay thế input read-only ─── -->
                        <div style="background:#fff;border-radius:12px;box-shadow:0 2px 12px rgba(0,0,0,.06);padding:24px;">
                            <div style="border-bottom:1.5px solid #e5e7eb;padding-bottom:12px;margin-bottom:12px;">
                                <small style="color:#888;font-size:11px;text-transform:uppercase;letter-spacing:.5px;font-weight:600;">Họ tên người nhận</small>
                                <p style="margin:4px 0 0;font-size:15px;font-weight:600;color:#1a1a2e;">@donHang.tbThongTinDatHang.tennguoinhan</p>
                            </div>
                            <div style="border-bottom:1.5px solid #e5e7eb;padding-bottom:12px;margin-bottom:12px;">
                                <small style="color:#888;font-size:11px;text-transform:uppercase;letter-spacing:.5px;font-weight:600;">Địa chỉ giao hàng</small>
                                <p style="margin:4px 0 0;font-size:14px;color:#1a1a2e;">@donHang.tbThongTinDatHang.diachi</p>
                            </div>
                            <div style="border-bottom:1.5px solid #e5e7eb;padding-bottom:12px;margin-bottom:12px;">
                                <small style="color:#888;font-size:11px;text-transform:uppercase;letter-spacing:.5px;font-weight:600;">Số điện thoại</small>
                                <p style="margin:4px 0 0;font-size:14px;color:#1a1a2e;">@donHang.tbThongTinDatHang.sdt</p>
                            </div>
                            <div style="border-bottom:1.5px solid #e5e7eb;padding-bottom:12px;margin-bottom:12px;">
                                <small style="color:#888;font-size:11px;text-transform:uppercase;letter-spacing:.5px;font-weight:600;">Ghi chú đơn hàng</small>
                                <p style="margin:4px 0 0;font-size:14px;color:#1a1a2e;">@(string.IsNullOrEmpty(donHang.ghichu) ? "Không có" : donHang.ghichu)</p>
                            </div>
                            <div style="border-bottom:1.5px solid #e5e7eb;padding-bottom:12px;margin-bottom:12px;">
                                <small style="color:#888;font-size:11px;text-transform:uppercase;letter-spacing:.5px;font-weight:600;">Shipper</small>
                                <p style="margin:4px 0 0;font-size:14px;font-weight:600;color:#1a1a2e;">@(donHang.tbShipper != null ? donHang.tbShipper.tenshipper + " - " + donHang.tbShipper.tbUser.sdt : "Chưa có shipper")</p>
                                @if (user != null && user.loaitaikhoan.Equals("Khách hàng"))
                                {
                                    <a href="@Url.Action("NhanTin", "Home")" style="display:inline-flex;align-items:center;gap:6px;margin-top:8px;padding:8px 16px;background:#3CB815;color:#fff;border-radius:8px;text-decoration:none;font-size:13px;font-weight:600;">
                                        <i class="fab fa-facebook-messenger"></i> Chat ngay!
                                    </a>
                                }
                                @if (user != null && user.loaitaikhoan.Equals("Khách hàng") && donHang.trangthai.Equals("Đang giao"))
                                {
                                    <div class="mt-3">
                                        <div id="order-tracking-map" style="height:250px; border-radius:12px; border:2px solid #3CB815;"></div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6" style="margin:20px auto">
                        <div class="checkout__order">
                            <h4>Đơn hàng (@donHang.trangthai)</h4>
                            <div class="checkout__order__products">Món ăn <span>Tổng tiền</span></div>
                            <ul>
                                @foreach (var i in donHang.tbChiTietDonHang)
                                {
                                    <li>@i.tbMonAn.tenmon (@i.soluong) <span>@((i.tbMonAn.giatien * i.soluong)?.ToString("N0")) VNĐ</span></li>
                                }
                            </ul>
                            <!-- ═══ FIX ĐÈ CHỮ: dùng flexbox space-between mỗi dòng ─── -->
                            <div style="border-top:1.5px solid #e5e7eb;padding-top:12px;margin-top:8px;">
                                <div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;">
                                    <span style="color:#888;font-size:14px;">Tạm tính món ăn</span>
                                    <span style="font-weight:600;font-size:14px;color:#1a1a2e;">@donHang.tongtien?.ToString("N0") VNĐ</span>
                                </div>
                                <div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;">
                                    <span style="color:#888;font-size:14px;">Mã giảm giá</span>
                                    <span style="font-weight:600;font-size:14px;color:#3CB815;">0 VNĐ</span>
                                </div>
                                <div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;">
                                    <span style="color:#888;font-size:14px;">Phí ship</span>
                                    <span style="font-weight:600;font-size:14px;color:#1a1a2e;">15,000 VNĐ</span>
                                </div>
                                <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 0 0;margin-top:6px;border-top:2px solid #e74c3c;">
                                    <span style="font-weight:700;font-size:17px;color:#e74c3c;">Tổng thanh toán</span>
                                    <span style="font-weight:700;font-size:17px;color:#e74c3c;">@((donHang.tongtien + 15000)?.ToString("N0")) VNĐ</span>
                                </div>
                            </div>

                            <div class="row mt-3">
                                <div class="col-lg-12">
                                    <div style="border-bottom:1.5px solid #e5e7eb;padding-bottom:10px;">
                                        <small style="color:#888;font-size:11px;text-transform:uppercase;letter-spacing:.5px;font-weight:600;">Phương thức thanh toán</small>
                                        <p style="margin:4px 0 0;font-size:14px;font-weight:600;color:#1a1a2e;">@donHang.tbLoaiHinhThanhToan.tenhinhthuc</p>
                                    </div>
                                </div>
                            </div>
                            @if (user != null && user.loaitaikhoan.Equals("Khách hàng"))
                            {
                                <div class="row mt-3">
                                    <div class="col-lg-12 d-flex gap-2">
                                        <a href="~/Cart/OrderTracking?id=@donHang.madh" class="btn btn-outline-success flex-fill" style="border-radius:8px;">📍 Theo dõi đơn hàng</a>
                                    </div>
                                </div>
                            }
                            @if (user != null && user.loaitaikhoan.Equals("Quán ăn") && donHang.trangthai.Equals("Đã đặt"))
                            {
                                <div class="row mt-3">
                                    <div class="col-lg-12 d-flex gap-2">                                        <a href="~/Restaurant/nhandon/@donHang.madh" class="btn btn-success flex-fill">Nhận đơn</a>
                                        <a href="~/Restaurant/huydon/@donHang.madh" class="btn btn-danger flex-fill">Huỷ đơn</a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Checkout Section End -->

@section scripts {
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script type="text/javascript">
    function redirectToPage() {
        window.location.href = '@Url.Action("NhanTin", "Home")';
    }

    // Live order tracking with Leaflet.js + SignalR
    $(document).ready(function () {
        var trackingMap = document.getElementById('order-tracking-map');
        if (trackingMap && window.L) {
            var map = L.map('order-tracking-map').setView([10.8231, 106.6297], 13);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap'
            }).addTo(map);

            var shipperMarker = null;

            // Connect to SignalR hub for real-time location
            var conn = new signalR.HubConnectionBuilder()
                .withUrl('/nhantin')
                .withAutomaticReconnect()
                .build();

            conn.on('shipperLocationUpdate', function (orderId, lat, lng) {
                if (!shipperMarker) {
                    shipperMarker = L.marker([lat, lng])
                        .addTo(map)
                        .bindPopup('🚚 Shipper đang giao hàng')
                        .openPopup();
                    if (shipperMarker._icon) {
                        shipperMarker._icon.style.transition = 'transform 0.5s ease';
                    }
                } else {
                    shipperMarker.setLatLng([lat, lng]);
                }
                map.setView([lat, lng], 15);
            });

            conn.start().then(function () {
                conn.invoke('JoinOrderGroup', @donHang.madh).catch(function (err) {
                    console.error('JoinOrderGroup error:', err);
                });
            }).catch(function (err) {
                console.error('SignalR connection error:', err);
            });
        }
    });
</script>
}
