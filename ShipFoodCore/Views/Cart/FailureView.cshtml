@{
    ViewBag.Title = "Thanh toán thất bại";
    Layout = "~/Views/Shared/_LayoutPageHome.cshtml";
    var errorMsg = TempData["PaymentError"] as string ?? "Thanh toán không thành công. Vui lòng thử lại.";
}

<style>
    .failure-wrapper {
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 16px;
        background: linear-gradient(135deg, #fff5f5, #ffeaea);
    }
    .failure-card {
        background: #fff;
        border-radius: 24px;
        padding: 48px 40px;
        text-align: center;
        max-width: 500px;
        width: 100%;
        box-shadow: 0 8px 40px rgba(220,53,69,.12);
        animation: slideUp .5s ease;
    }
    @@keyframes slideUp { 0%{transform:translateY(30px);opacity:0} 100%{transform:translateY(0);opacity:1} }
    .failure-icon {
        width: 100px; height: 100px;
        background: linear-gradient(135deg, #dc3545, #e74c3c);
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 24px;
        box-shadow: 0 8px 24px rgba(220,53,69,.25);
    }
    .btn-retry {
        display: inline-block; padding: 12px 32px;
        border-radius: 10px; font-weight: 600; font-size: 15px;
        text-decoration: none; transition: all .2s;
        background: linear-gradient(135deg,#f39c12,#e67e22); color: #fff;
    }
    .btn-retry:hover { opacity:.88; color:#fff; }
    .btn-home2 {
        display: inline-block; padding: 12px 32px;
        border-radius: 10px; font-weight: 600; font-size: 15px;
        text-decoration: none; transition: all .2s;
        background: #f0f2f5; color: #333; border: 1.5px solid #dee2e6;
    }
    .btn-home2:hover { background:#dee2e6; color:#333; }
</style>

<div class="failure-wrapper" style="margin-top:80px;">
    <div class="failure-card">
        <div class="failure-icon">
            <svg width="50" height="50" viewBox="0 0 24 24" fill="none">
                <path d="M18 6L6 18M6 6l12 12" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
            </svg>
        </div>
        <h2 style="font-weight:800;color:#1a1a2e;margin-bottom:8px;">Thanh toán thất bại</h2>
        <div style="background:#fff5f5;border:1px solid #f5c6cb;border-radius:12px;padding:16px;margin:16px 0 28px;text-align:left;">
            <div style="color:#721c24;font-size:14px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" style="margin-right:8px;vertical-align:middle;"><circle cx="12" cy="12" r="10" stroke="#dc3545" stroke-width="2"/><line x1="12" y1="8" x2="12" y2="12" stroke="#dc3545" stroke-width="2" stroke-linecap="round"/><circle cx="12" cy="16" r="1" fill="#dc3545"/></svg>
                @errorMsg
            </div>
        </div>
        <p style="color:#999;font-size:13px;margin-bottom:28px;">
            Giỏ hàng của bạn vẫn được giữ nguyên. Bạn có thể thử thanh toán lại.
        </p>
        <div class="d-flex gap-3 justify-content-center flex-wrap">
            <a href="@Url.Action("Checkout","Cart")" class="btn-retry">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" style="margin-right:6px;vertical-align:middle;"><path d="M1 4v6h6M23 20v-6h-6" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M20.49 9A9 9 0 005.64 5.64L1 10M23 14l-4.64 4.36A9 9 0 013.51 15" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Thử lại thanh toán
            </a>
            <a href="@Url.Action("Index","Home")" class="btn-home2">Về trang chủ</a>
        </div>
    </div>
</div>
