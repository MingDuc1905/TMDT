@{
    ViewBag.Title = "Checkout";
    Layout = "~/Views/Shared/_LayoutPageHome.cshtml";
    ShipFood.Models.Cart cart = ViewBag.cart;
    ShipFood.Models.City city = new ShipFood.Models.City();
    List<ShipFood.Models.tbLoaiHinhThanhToan> lhtt = ViewBag.phuongthuctt;
    List<ShipFood.Models.tbThongTinDatHang> ttdh = ViewBag.diachicosan;
    List<ShipFood.Models.tbKhuyenMai> couponList = ViewBag.CouponList as List<ShipFood.Models.tbKhuyenMai> ?? new List<ShipFood.Models.tbKhuyenMai>();

    var restaurantCount = cart?.RestaurantIds?.Count ?? 1;
    var totalShipping = 15000 * restaurantCount;

    // URL actions dùng cho JavaScript (Razor ~ không hoạt động trong JS)
    string urlProcessPayment = Url.Action("ProcessPayment", "Payment")!;
    string urlCheckCoupon = Url.Action("CheckCoupon", "Cart")!;
    string urlLichSu = Url.Action("LichSuDatHang", "Cart")!;
    string urlChiTietDH = Url.Action("ChiTietDonHang", "Cart")!;
    string urlCheckout = Url.Action("Checkout", "Cart")!;
}
<style>
        body { font-family: 'Inter', sans-serif; background: #f8f9fa; }
        .checkout-card { background: #fff; border-radius: 16px; box-shadow: 0 2px 16px rgba(0,0,0,.07); padding: 28px; margin-bottom: 20px; }
        .address-tabs .tab-btn { cursor:pointer; padding: 10px 18px; border: 2px solid #dee2e6; border-radius: 30px; font-size: 14px; font-weight: 500; background: #fff; transition: all .2s; margin-right: 8px; margin-bottom: 8px; }
        .address-tabs .tab-btn.active { border-color: #3CB815; background: #3CB815; color: #fff; }
        .address-tabs .tab-btn i { margin-right: 6px; }
        .form-label { font-weight: 600; font-size: 14px; margin-bottom: 4px; }
        .form-control, .form-select { border-radius: 8px; border: 1.5px solid #dee2e6; padding: 10px 14px; font-size: 14px; }
        .form-control:focus, .form-select:focus { border-color: #3CB815; box-shadow: 0 0 0 3px rgba(60,184,21,.12); }
        .payment-option { border: 2px solid #dee2e6; border-radius: 12px; padding: 14px 16px; cursor: pointer; transition: all .2s; margin-bottom: 10px; display: flex; align-items: center; gap: 12px; }
        .payment-option:hover { border-color: #3CB815; background: #f6fff3; }
        .payment-option.selected { border-color: #3CB815; background: #f0fff0; }
        .payment-option input[type=radio] { accent-color: #3CB815; width: 18px; height: 18px; }
        .order-summary { background: #fff; border-radius: 16px; box-shadow: 0 2px 16px rgba(0,0,0,.07); padding: 24px; position: sticky; top: 100px; }
        .order-item { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #f0f0f0; font-size: 14px; }
        .order-total-row { display: flex; justify-content: space-between; padding: 6px 0; font-size: 14px; }
        .order-grand { font-size: 18px; font-weight: 700; color: var(--fs-danger); border-top: 2px solid var(--fs-danger); padding-top: 12px; margin-top: 8px; }
        .btn-checkout { width: 100%; padding: 14px; background: linear-gradient(135deg,var(--fs-green),var(--fs-green-dark)); color: #fff; border: none; border-radius: 10px; font-size: 16px; font-weight: 700; cursor: pointer; transition: opacity .2s; }
        .btn-checkout:hover { opacity: .88; }
        .btn-checkout:disabled { opacity: .5; cursor: not-allowed; }
        .coupon-box { border: 1.5px dashed var(--fs-green); border-radius: 12px; padding: 16px; }
        .fs-checkout-hero { margin-top:120px;padding:24px 0;background:linear-gradient(135deg,var(--fs-green),var(--fs-green-dark)); }
        .fs-checkout-breadcrumb { color:rgba(255,255,255,.8);font-size:13px;margin-top:4px; }
        .fs-checkout-link { color:rgba(255,255,255,.8);text-decoration:none; }
        .fs-checkout-link:hover { color:#fff;text-decoration:underline; }
        .section-title { font-size: 18px; font-weight: 700; color: var(--fs-dark); margin-bottom: 16px; display: flex; align-items: center; gap: 8px; }
        .section-title i { color: var(--fs-green); }
        .available-address-card { border: 1.5px solid #dee2e6; border-radius: 10px; padding: 12px 14px; cursor: pointer; transition: all .2s; margin-bottom: 10px; }
        .available-address-card:hover, .available-address-card.selected { border-color: #3CB815; background: #f6fff3; }
        .available-address-card input[type=radio] { accent-color: #3CB815; margin-right: 8px; }
        .payment-detail-box { background: linear-gradient(135deg,#f8f9ff,#eef1ff); border: 1px solid #d0d7ff; border-radius: 12px; padding: 16px; margin-top: 12px; }
        .confirm-check { display: flex; align-items: center; gap: 10px; padding: 12px 14px; background: #fffbf0; border: 1px solid #ffd700; border-radius: 12px; }
        /* ── Đồng bộ Home theme: border-radius + box-shadow cho Checkout ── */
        .checkout-card { border-radius: 12px !important; box-shadow: 0 4px 20px rgba(0,0,0,.07) !important; }
        .order-summary { border-radius: 12px !important; box-shadow: 0 4px 20px rgba(0,0,0,.07) !important; }
        .form-control, .form-select { border-radius: 12px !important; }
        .btn-checkout { border-radius: 12px !important; }
        .payment-option { border-radius: 12px !important; }
        .coupon-box { border-radius: 12px !important; }
        .available-address-card { border-radius: 12px !important; }
        .address-tabs .tab-btn { border-radius: 12px !important; }
        .confirm-check input { accent-color: #f39c12; width: 18px; height: 18px; }
        .fs-checkout-toast { position:fixed;top:24px;right:24px;z-index:99999;padding:14px 20px;border-radius:10px;box-shadow:0 4px 20px rgba(0,0,0,.2);font-size:14px;max-width:360px; }
        .fs-popup-icon-circle { width:80px;height:80px;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 16px; }
        .fs-coupon-overlay { display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.55);z-index:99999;align-items:center;justify-content:center; }
        .fs-coupon-modal { background:#fff;border-radius:20px;max-width:500px;width:92%;max-height:80vh;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,.2);animation:popIn .3s ease; }
        .fs-coupon-header { display:flex;align-items:center;justify-content:space-between;padding:18px 20px;border-bottom:1px solid #e5e7eb;background:linear-gradient(135deg,#f8f9fa,#fff); }
        .fs-coupon-body { padding:16px 20px;overflow-y:auto;max-height:calc(80vh - 80px); }
        .fs-coupon-card { display:flex;align-items:center;gap:14px;padding:14px 16px;border-radius:14px;border:1.5px solid #e5e7eb;margin-bottom:10px;background:#fff;transition:all .2s;cursor:pointer;position:relative;overflow:hidden; }
        .fs-coupon-badge { width:56px;height:56px;border-radius:12px;background:linear-gradient(135deg,var(--fs-green),var(--fs-green-dark));display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#fff;font-size:18px;font-weight:800;flex-direction:column;line-height:1.1; }
        .fs-coupon-close-btn { width:36px;height:36px;border-radius:50%;border:none;background:#e5e7eb;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:18px;color:#666;transition:all .15s; }
        .fs-coupon-close-btn:hover { background:#d1d5db; }
        .fs-voucher-timeslot { background:linear-gradient(135deg,#fff8e1,#fff3cd);border:1.5px solid #ffd700;border-radius:14px;padding:14px 16px;margin-bottom:16px;display:flex;align-items:center;gap:12px; }
        .fs-input-group { border-radius:12px;border:1.5px solid #dee2e6;padding:10px 14px;font-size:14px; }
        .fs-input-group:focus { border-color:var(--fs-green);box-shadow:0 0 0 3px rgba(60,184,21,.12); }
        .fs-overlay-center { display:flex;align-items:center;justify-content:center; }
        .fs-gap-2 { gap:8px; }
        @@keyframes popIn { 0%{transform:scale(.8);opacity:0} 100%{transform:scale(1);opacity:1} }
        .popup-overlay { position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.55);z-index:9999;display:flex;align-items:center;justify-content:center; }
        .popup-box { background:#fff;border-radius:20px;padding:40px 32px;text-align:center;max-width:420px;width:90%;box-shadow:0 20px 60px rgba(0,0,0,.2);animation:popIn .3s ease; }
    </style>
<!-- Breadcrumb -->    <section class="fs-checkout-hero">
    <div class="container">
        <h3 class="text-white fw-700" style="margin:0;"><i class="fas fa-credit-card me-2"></i>Thanh toán đơn hàng</h3>
        <nav class="fs-checkout-breadcrumb">
            <a href="~/Home" class="fs-checkout-link">Trang chủ</a>
            <span class="mx-2">/</span>
            <a href="@Url.Action("Index","Cart")" class="fs-checkout-link">Giỏ hàng</a>
            <span class="mx-2">/</span>
            <span>Thanh toán</span>
        </nav>
    </div>
</section>

<section class="py-4">
    <div class="container">
        @if (TempData["CartError"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>@TempData["CartError"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <form id="paymentForm">
            @Html.AntiForgeryToken()
            <div class="row g-4">
                <!-- Cột trái: thông tin giao hàng -->
                <div class="col-lg-8">
                    <!-- Chọn kiểu nhập địa chỉ -->
                    <div class="checkout-card">
                        <div class="section-title"><i class="fas fa-map-marker-alt"></i> Địa chỉ giao hàng</div>
                        <div class="address-tabs mb-3">
                            <button type="button" class="tab-btn active" id="tab-new" onclick="switchAddressMode('new')">
                                <i class="fas fa-plus-circle"></i> Nhập địa chỉ mới
                            </button>
                            <button type="button" class="tab-btn" id="tab-current" onclick="switchAddressMode('current')">
                                <i class="fas fa-location-arrow"></i> Lấy vị trí hiện tại
                            </button>
                            @if (ttdh.Count > 0)
                            {
                                <button type="button" class="tab-btn" id="tab-available" onclick="switchAddressMode('available')">
                                    <i class="fas fa-bookmark"></i> Địa chỉ đã lưu (@ttdh.Count)
                                </button>
                            }
                        </div>

                        <!-- Panel: địa chỉ có sẵn (đã deduplicated) -->
                        <div id="panel-available" style="display:none;">
                            <input type="hidden" id="selected-mattdh" name="mattdh" value="" />
                            @{
                                var groupedAddresses = ttdh
                                    .GroupBy(a => new { a.diachi, a.tennguoinhan, a.sdt })
                                    .Select(g => g.First())
                                    .ToList();
                            }
                            @foreach (var addr in groupedAddresses)
                            {
                                <label class="available-address-card d-block" onclick="selectSavedAddress(this, @addr.mattdh, '@Html.Raw(addr.tennguoinhan?.Replace("'","\\'")??"")','@Html.Raw(addr.sdt?.Replace("'","\\'")??"")','@Html.Raw(addr.diachi?.Replace("'","\\'")??"")' )">
                                    <div class="d-flex align-items-start">
                                        <input type="radio" name="_addrRadio" value="@addr.mattdh" style="margin-top:3px;">
                                        <div class="ms-2">
                                            <strong>@addr.tennguoinhan</strong>
                                            <span class="text-muted ms-2">@addr.sdt</span>
                                            <div class="text-muted small mt-1"><i class="fas fa-map-pin me-1"></i>@addr.diachi</div>
                                        </div>
                                    </div>
                                </label>
                            }
                            <div id="no-address-msg" style="display:@(groupedAddresses.Count==0?"block":"none")" class="text-muted text-center py-3">
                                <i class="fas fa-inbox fa-2x mb-2 d-block text-secondary"></i>Bạn chưa có địa chỉ nào đã lưu
                            </div>
                        </div>

                        <!-- Panel: nhập mới / vị trí hiện tại -->
                        <div id="panel-form">
                            <div id="geo-status-box" style="display:none;" class="alert alert-info py-2 mb-3">
                                <i class="fas fa-spinner fa-spin me-2"></i><span id="geo-msg">Đang lấy vị trí...</span>
                            </div>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Họ tên người nhận <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" name="hoten" id="input-hoten" placeholder="VD: Nguyễn Văn A">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Số điện thoại <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" name="SDT" id="input-sdt" placeholder="VD: 0912345678">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Quận / Huyện <span class="text-danger">*</span></label>
                                    <select class="form-select" name="quan">
                                        @foreach (var d in city.districts)
                                        {
                                            <option value="@d.nameDistrict">@d.nameDistrict</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Địa chỉ cụ thể <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" name="diachicuthe" id="input-diachi" placeholder="Số nhà, tên đường...">
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Tầng / Phòng / Ghi chú địa chỉ</label>
                                    <input type="text" class="form-control" name="diachiadd" placeholder="VD: Tầng 3, phòng 301">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Ghi chú & Khuyến mãi -->
                    <div class="checkout-card">
                        <div class="section-title"><i class="fas fa-sticky-note"></i> Ghi chú & Khuyến mãi</div>
                        <div class="mb-3">
                            <label class="form-label">Ghi chú đơn hàng</label>
                            <textarea class="form-control" name="note" rows="2" placeholder="Ghi chú cho shipper..."></textarea>
                        </div>
                        <!-- ═══ VOUCHER Grab/ShopeeFood Style ═══ -->                        <div class="coupon-box">
                        @{
                            var recommendedVouchers = ViewBag.RecommendedVouchers as List<ShipFood.Models.tbKhuyenMai> ?? new List<ShipFood.Models.tbKhuyenMai>();
                            var timeSlotInfo = ViewBag.CurrentTimeSlot as (string name, string icon, string description)?;
                        }
                        @if (timeSlotInfo.HasValue)
                        {
                            <!-- ═══ TIME-SLOT VOUCHER RECOMMENDATION ═══ -->
                            <div class="fs-voucher-timeslot">
                                <div style="font-size:28px;flex-shrink:0;">@timeSlotInfo.Value.icon</div>
                                <div style="flex:1;min-width:0;">
                                    <div style="font-size:14px;font-weight:700;color:#856404;">🎯 Khung giờ @timeSlotInfo.Value.name</div>
                                    <div style="font-size:12px;color:#856404;">@timeSlotInfo.Value.description</div>
                                </div>
                            </div>
                        }
                        @if (recommendedVouchers.Any())
                        {
                            <div style="margin-bottom:12px;">
                                <div style="font-size:12px;font-weight:600;color:#1a1a2e;margin-bottom:8px;">🎫 Gợi ý mã giảm giá cho bạn:</div>
                                <div class="d-flex flex-column gap-2">
                                    @foreach (var c in recommendedVouchers.Take(2))
                                    {
                                        <div onclick="quickApplyCoupon('@c.tenkm', this)"
                                             style="display:flex;align-items:center;gap:10px;cursor:pointer;padding:12px 14px;border-radius:14px;font-size:13px;font-weight:600;
                                             background:linear-gradient(135deg,#f0fff0,#e8f5e9);border:1.5px solid #3CB815;
                                             transition:all .2s;"
                                             class="fs-trans-x"
                                             style="transition:transform .2s;">
                                            <div style="width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,#3CB815,#27a001);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#fff;font-weight:800;font-size:15px;">
                                                @(c.phantramgiam ?? 0)%
                                            </div>
                                            <div style="flex:1;min-width:0;">
                                                <div style="font-size:14px;font-weight:700;color:#1a1a2e;">@c.tenkm</div>
                                                <div style="font-size:11px;color:#888;">Giảm @(c.phantramgiam ?? 0)% đơn hàng</div>
                                            </div>
                                            <div style="width:24px;height:24px;border-radius:50%;border:2px solid #3CB815;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                                <span style="color:#3CB815;font-size:14px;">✓</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
                            <label class="form-label" style="margin:0;"><i class="fas fa-tag me-1 text-success"></i>Chọn mã giảm giá</label>
                            <button type="button" class="btn btn-sm btn-outline-success px-3" id="btn-browse-coupons" style="border-radius:20px;font-size:12px;font-weight:600;">
                                <i class="fas fa-magic"></i> Xem tất cả
                            </button>
                        </div>
                        
                        <div class="input-group mb-3">
                            <input type="text" class="form-control" id="coupon-code" placeholder="Nhập mã giảm giá" style="background:#f8f9fa;">
                            <button type="button" class="btn btn-success px-3" id="btn-apply-coupon" style="font-weight:600;">Áp dụng</button>
                            <button type="button" class="btn btn-outline-danger px-2" id="btn-remove-coupon" title="Bỏ chọn mã" style="display:none;">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                        <div id="coupon-result" class="mt-1" style="display:none;font-size:13px;"></div>
                        <input type="hidden" name="makhuyenmai" id="applied-coupon-id" value="" />
                        
                        @if (couponList.Any())
                        {
                            <div style="margin-bottom:8px;">
                                <div style="font-size:12px;font-weight:600;color:#1a1a2e;margin-bottom:8px;">🎫 Mã giảm giá đề xuất:</div>
                                <div class="d-flex flex-column gap-2">
                                    @{
                                        var highlightCpns = couponList.Take(3).ToList();
                                    }
                                    @foreach (var c in highlightCpns)
                                    {
                                        var isFirst = c == highlightCpns.First();
                                        <div onclick="quickApplyCoupon('@c.tenkm', this)"
                                             style="display:flex;align-items:center;gap:10px;cursor:pointer;padding:12px 14px;border-radius:14px;font-size:13px;font-weight:600;
                                             @(isFirst ? "background:linear-gradient(135deg,#fff8e1,#fff3cd);border:1.5px solid #ffd700;" : "background:#f8f9fa;border:1.5px solid #e5e7eb;")
                                             transition:all .2s;"
                                             class="fs-trans-x"
                                             style="transition:transform .2s;">
                                            <div style="width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,#3CB815,#27a001);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#fff;font-weight:800;font-size:15px;">
                                                @(c.phantramgiam ?? 0)%
                                            </div>
                                            <div style="flex:1;min-width:0;">
                                                <div style="font-size:14px;font-weight:700;color:#1a1a2e;">@c.tenkm</div>
                                                <div style="font-size:11px;color:#888;">Giảm @(c.phantramgiam ?? 0)% đơn hàng</div>
                                            </div>
                                            <div style="width:24px;height:24px;border-radius:50%;border:2px solid #ddd;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                                @if (isFirst) { <span style="color:#3CB815;font-size:14px;">✓</span> }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                            if (couponList.Count > 3)
                            {
                                <div class="mt-1 small text-muted">
                                    <i class="fas fa-info-circle me-1"></i>Còn @(couponList.Count - 3) mã khác — ấn "Xem tất cả" để chọn
                                </div>
                            }
                        }
                    </div>
                    </div>

                    <!-- Phương thức thanh toán -->
                    <div class="checkout-card">
                        <div class="section-title"><i class="fas fa-wallet"></i> Phương thức thanh toán</div>
                        @{
                            // ─── Payment brand config: chỉ giữ COD + VNPAY ───
                            var paymentBrands = new Dictionary<string, Func<object>>(StringComparer.OrdinalIgnoreCase)
                            {
                                ["Tiền mặt"] = () => Html.Raw(
                                    "<div style=\"width:44px;height:44px;background:linear-gradient(135deg,#28a745,#20c997);border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:20px;\">" +
                                    "<i class='fas fa-money-bill-wave text-white'></i></div>"),
                                ["COD"] = () => Html.Raw(
                                    "<div style=\"width:44px;height:44px;background:linear-gradient(135deg,#28a745,#20c997);border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:20px;\">" +
                                    "<i class='fas fa-money-bill-wave text-white'></i></div>"),
                                ["VNPAY"] = () => Html.Raw(
                                    "<div style=\"width:44px;height:44px;background:linear-gradient(135deg,#F37920,#e05e0e);border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-weight:800;font-size:13px;color:#fff;letter-spacing:-0.5px;\">" +
                                    "VN</div>")
                            };
                        }
                        @foreach (var pt in lhtt)
                        {
                            var brandKey = paymentBrands.Keys.FirstOrDefault(k => (pt.tenhinhthuc ?? "").Contains(k, StringComparison.OrdinalIgnoreCase));
                            var brandIcon = brandKey != null ? paymentBrands[brandKey]() : Html.Raw(
                                "<div style=\"width:44px;height:44px;background:linear-gradient(135deg,#6f42c1,#e83e8c);border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:20px;\">" +
                                "<i class='fas fa-credit-card text-white'></i></div>");

                            <div class="payment-option" id="payment-opt-@pt.mahttt" onclick="selectPayment(@pt.mahttt, '@Html.Raw(pt.tenhinhthuc?.Replace("'","\\'")??"")' )" style="cursor:pointer;">
                                <input type="radio" name="pttt" value="@pt.mahttt" class="payment-method" data-name="@pt.tenhinhthuc" style="pointer-events:none;">
                                @brandIcon
                                <div>
                                    <div style="font-weight:600;font-size:15px;">@pt.tenhinhthuc</div>
                                    @if ((pt.tenhinhthuc ?? "").Contains("Tiền mặt") || (pt.tenhinhthuc ?? "").Contains("COD"))
                                    {
                                        <div style="font-size:12px;color:#888;">Thanh toán khi nhận hàng</div>
                                    }
                                    else if ((pt.tenhinhthuc ?? "").Contains("VNPAY") || (pt.tenhinhthuc ?? "").Contains("Vnpay"))
                                    {
                                        <div style="font-size:12px;color:#888;">Thanh toán qua cổng VNPAY (ATM, Visa, Mastercard)</div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Chi tiết phương thức thanh toán -->
                        <div id="payment-info-area" class="mt-2" style="display:none;"></div>

                        <!-- Khu vực test mock payment (chuyển khoản) -->
                        <div id="test-mode-area" class="mt-3" style="display:none;">
                            <div style="background:#fff8e1;border:1px solid #ffe082;border-radius:10px;padding:12px;">
                                <p class="mb-2" style="font-size:13px;color:#856404;"><i class="fas fa-flask me-1"></i><strong>Chế độ mô phỏng thanh toán:</strong></p>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-success btn-sm flex-fill" onclick="submitPayment('success')">
                                        <i class="fas fa-check me-1"></i>Thanh toán thành công
                                    </button>
                                    <button type="button" class="btn btn-outline-danger btn-sm flex-fill" onclick="submitPayment('failure')">
                                        <i class="fas fa-times me-1"></i>Giả lập thất bại
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Xác nhận -->
                    <div class="confirm-check mb-3">
                        <input type="checkbox" id="diff-acc">
                        <label for="diff-acc" style="cursor:pointer;font-size:14px;">
                            <i class="fas fa-shield-alt text-warning me-1"></i>
                            Tôi xác nhận thông tin trên là chính xác và đồng ý đặt hàng
                        </label>
                    </div>
                </div>

                <!-- Cột phải: tóm tắt đơn hàng -->
                <div class="col-lg-4">
                    <div class="order-summary">
                        <div class="section-title"><i class="fas fa-receipt"></i> Đơn hàng của bạn</div>
                        @foreach (var item in cart.monAns)
                        {
                            <div class="order-item">
                                <span>@item.tenmon <span class="badge bg-secondary ms-1">x@(item.soLuong)</span></span>
                                <span>@((item.soLuong * item.giatien)?.ToString("N0")) đ</span>
                            </div>
                        }
                        <div class="order-total-row mt-2">
                            <span class="text-muted">Tạm tính</span>
                            <span id="subtotal-amount">@cart.tongTien?.ToString("N0") đ</span>
                        </div>
                        <div class="order-total-row text-success" id="order-discount" style="display:none;">
                            <span><i class="fas fa-tag me-1"></i>Giảm giá</span>
                            <span id="discount-amount">-0 đ</span>
                        </div>
                        <div class="order-total-row">
                            <span class="text-muted">Phí giao hàng <span style="font-size:11px;color:#999;">(15,000đ × @restaurantCount quán)</span></span>
                            <span>@totalShipping.ToString("N0") đ</span>
                        </div>
                        <div class="order-total-row order-grand">
                            <span>Tổng cộng</span>
                            <span id="order-total">@((cart.tongTien + totalShipping)?.ToString("N0")) đ</span>
                        </div>

                        <button type="button" id="btn-submit-cod" class="btn-checkout mt-3" onclick="submitPayment('success')">
                            <i class="fas fa-check-circle me-2"></i>Xác nhận đặt hàng
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</section>

<!-- ponytail: Layout đã load jQuery + Bootstrap, không load lại gây conflict -->
<script>
    // === Server-side URLs (Razor renders these, no ~ issues in JS) ===
    var URL_PROCESS_PAYMENT = '@Html.Raw(urlProcessPayment)';
    var URL_CHECK_COUPON = '@Html.Raw(urlCheckCoupon)';
    var URL_GET_COUPONS = '@Url.Action("GetAvailableCoupons", "Cart")';
    var URL_REMOVE_COUPON = '@Url.Action("RemoveCoupon", "Cart")';
    var URL_LICH_SU = '@Html.Raw(urlLichSu)';
    var URL_CHI_TIET_DH = '@Html.Raw(urlChiTietDH)';
    var URL_CHECKOUT = '@Html.Raw(urlCheckout)';
    var SHIPPING_FEE = @totalShipping;

    // === Bank info th?t t? server — BIN code cho QR, tên ngân hàng riêng cho hi?n th? ===
    var BANK_BIN = '@ViewBag.BankId' || '970415'; // BIN code (VD: 970415 = VietinBank) cho VietQR API
    var BANK_DISPLAY = '@ViewBag.BankIdDisplay' || 'VietinBank'; // Tên hi?n th? (VD: VietinBank)
    var BANK_ACC_NO = '@ViewBag.BankAccountNo' || '102878588446';
    var BANK_ACC_NAME = '@ViewBag.BankAccountName' || 'BUI MINH DUC';

    // === Chế độ địa chỉ ===
    var addressMode = 'new'; // 'new' | 'current' | 'available'

    function switchAddressMode(mode) {
        addressMode = mode;
        $('#tab-new, #tab-current, #tab-available').removeClass('active');
        $('#tab-' + mode).addClass('active');
        if (mode === 'available') {
            $('#panel-available').show();
            $('#panel-form').hide();
        } else {
            $('#panel-available').hide();
            $('#panel-form').show();
            if (mode === 'current') {
                getCurrentLocation();
            }
        }
    }

    // === Chọn địa chỉ đã lưu ===
    function selectSavedAddress(el, mattdh, ten, sdt, diachi) {
        $('.available-address-card').removeClass('selected');
        $(el).addClass('selected');
        $('#selected-mattdh').val(mattdh);
    }

    // === Geolocation ===
    function getCurrentLocation() {
        if (!navigator.geolocation) {
            alert('Trình duyệt không hỗ trợ định vị. Vui lòng nhập địa chỉ thủ công.');
            switchAddressMode('new');
            return;
        }
        $('#geo-status-box').show();
        $('#geo-msg').text('Đang lấy vị trí của bạn...');
        navigator.geolocation.getCurrentPosition(
            function(pos) {
                $('#geo-msg').text('Đã lấy vị trí! Đang tra cứu địa chỉ...');
                reverseGeocode(pos.coords.latitude, pos.coords.longitude);
            },
            function(err) {
                $('#geo-status-box').hide();
                var m = 'Không thể lấy vị trí. Vui lòng nhập thủ công.';
                if (err.code === err.PERMISSION_DENIED) m = 'Bạn đã từ chối cấp quyền vị trí.';
                if (err.code === err.TIMEOUT) m = 'Quá thời gian chờ lấy vị trí.';
                alert(m);
                switchAddressMode('new');
            },
            { enableHighAccuracy: true, timeout: 10000, maximumAge: 60000 }
        );
    }

    function reverseGeocode(lat, lng) {
        $.ajax({
            url: 'https://nominatim.openstreetmap.org/reverse',
            data: { format: 'json', lat: lat, lon: lng, addressdetails: 1, 'accept-language': 'vi' },
            dataType: 'json', timeout: 8000,
            headers: { 'User-Agent': 'FastShipApp/1.0' },
            success: function(data) {
                $('#geo-status-box').hide();
                if (data && data.address) {
                    var a = data.address;
                    var road = a.road || a.pedestrian || a.street || '';
                    var house = a.house_number || '';
                    var suburb = a.suburb || a.neighbourhood || '';
                    var fullAddr = [house, road, suburb].filter(Boolean).join(' ');
                    if (!fullAddr && data.display_name) {
                        fullAddr = data.display_name.split(',').slice(0, -2).join(',').trim();
                    }
                    if (fullAddr) $('#input-diachi').val(fullAddr);
                    var dist = a.city_district || a.county || '';
                    if (dist) {
                        $('select[name="quan"] option').each(function() {
                            if ($(this).val().toLowerCase().includes(dist.toLowerCase())) {
                                $(this).prop('selected', true); return false;
                            }
                        });
                    }
                }
            },
            error: function() {
                $('#geo-status-box').hide();
                alert('Không thể tra cứu địa chỉ. Vui lòng nhập thủ công.');
            }
        });
    }

    // === Chọn phương thức thanh toán ===
    function selectPayment(id, name) {
        $('.payment-option').removeClass('selected');
        $('#payment-opt-' + id).addClass('selected');
        $('input[name="pttt"][value="' + id + '"]').prop('checked', true);
        updatePaymentUI(name);
    }

    function updatePaymentUI(name) {
        var area = $('#payment-info-area');
        var testArea = $('#test-mode-area');
        var codBtn = $('#btn-submit-cod');
        if (name.includes('Tiền mặt') || name.includes('COD')) {
            area.html('<div class="payment-detail-box text-center"><div style="background:linear-gradient(135deg,#28a745,#20c997);width:56px;height:56px;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 10px"><i class="fas fa-money-bill-wave text-white fa-lg"></i></div><strong style="color:#28a745;">Thanh toán khi nhận hàng (COD)</strong><p class="text-muted small mt-1 mb-0">Chuẩn bị sẵn tiền mặt khi shipper giao hàng.</p></div>').show();
            testArea.hide();
            codBtn.show().html('<i class="fas fa-check-circle me-2"></i>Xác nhận đặt hàng');
        } else if (name.includes('VNPAY') || name.includes('Vnpay') || name.includes('vnpay')) {
            area.html('<div class="payment-detail-box text-center"><div style="background:linear-gradient(135deg,#F37920,#e05e0e);width:56px;height:56px;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 10px"><span style="color:#fff;font-weight:800;font-size:22px;">VN</span></div><strong style="color:#F37920;">Thanh toán qua VNPAY</strong><p class="text-muted small mt-1 mb-0">Chuyển hướng đến cổng thanh toán VNPAY để thanh toán qua ATM, Visa, Mastercard.</p></div>').show();
            testArea.hide();
            codBtn.show().html('<i class="fas fa-credit-card me-2"></i>Đặt hàng (Thanh toán VNPAY)');
        } else {
            area.hide();
            testArea.hide();
            codBtn.show().html('<i class="fas fa-check-circle me-2"></i>Xác nhận đặt hàng');
        }
    }

    // === Áp dụng nhanh mã đề xuất (Grab/ShopeeFood style) ===
    var activeCouponClass = 'coupon-recommended-active';
    function quickApplyCoupon(code, el) {
        $('#coupon-code').val(code);
        // Reset all recommended coupons to default style
        $('[onclick*="quickApplyCoupon"]').each(function() {
            $(this).css('background','#f8f9fa').css('border','1.5px solid #e5e7eb').css('transform','');
            $(this).find('div:last').html('<div style="width:24px;height:24px;border-radius:50%;border:2px solid #ddd;display:flex;align-items:center;justify-content:center;flex-shrink:0;">');
        });
        // Highlight the selected one
        $(el).css('background','#f0fff0').css('border','1.5px solid #3CB815');
        $(el).find('div:last').html('<div style="width:24px;height:24px;border-radius:50%;border:2px solid #3CB815;background:#3CB815;display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#fff;font-weight:700;font-size:14px;">✓</div>');
        applyCoupon();
    }

    // === Khuyến mãi ===
    function applyCoupon() {
        var code = $('#coupon-code').val().trim();
        var result = $('#coupon-result');
        if (!code) { result.html('<span class="text-danger"><i class="fas fa-exclamation-circle me-1"></i>Vui lòng nhập mã</span>').show(); return; }
        $.ajax({
            url: URL_CHECK_COUPON, type: 'POST',
            data: { code: code, tongTien: @(cart?.tongTien ?? 0) },
            headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
            success: function(r) {
                if (r.success) {
                    $('#applied-coupon-id').val(r.couponId);
                    result.html('<span class="text-success"><i class="fas fa-check-circle me-1"></i>' + r.message + '</span>').show();
                    var disc = r.discountAmount || 0;
                    var sub = @(cart?.tongTien ?? 0);
                    var total = Math.max(sub - disc + SHIPPING_FEE, 0);
                    $('#order-discount').show().find('#discount-amount').text('-' + disc.toLocaleString('vi-VN') + ' đ');
                    $('#order-total').text(total.toLocaleString('vi-VN') + ' đ');
                    $('#btn-apply-coupon').prop('disabled', true).html('<i class="fas fa-check"></i> Đã áp dụng');
                } else {
                    result.html('<span class="text-danger"><i class="fas fa-exclamation-circle me-1"></i>' + r.message + '</span>').show();
                }
            },
            error: function() { result.html('<span class="text-danger">Lỗi kết nối. Vui lòng thử lại.</span>').show(); }
        });
    }

    // === Validate & Submit ===
    function validatePhone(sdt) { return /^0[1-9][0-9]{8,9}$/.test(sdt); }

    function startPolling(orderId) {
        var interval = setInterval(function () {
            $.ajax({
                url: '/Payment/CheckOrderStatus',
                type: 'GET',
                data: { orderId: orderId },
                success: function (r) {
                    if (r.success && r.status === 'Paid') {
                        clearInterval(interval);
                        if (r.redirectUrl) window.location.href = r.redirectUrl;
                    }
                },
                error: function () {
                    console.warn('check order status failed');
                }
            });
        }, 5000); // 5 seconds polling
    }

    function submitPayment(testResult) {
        var pttt = $('input[name="pttt"]:checked').val();
        if (!pttt) { showToast('error', 'Vui lòng chọn phương thức thanh toán'); return; }
        if (!$('#diff-acc').is(':checked')) { showToast('error', 'Vui lòng xác nhận thông tin trước khi đặt hàng'); return; }

        var formData = {};

        if (addressMode === 'available') {
            var mattdh = $('#selected-mattdh').val();
            if (!mattdh) { showToast('error', 'Vui lòng chọn một địa chỉ đã lưu'); return; }
            formData.mattdh = parseInt(mattdh);
            var selectedCard = $('.available-address-card.selected');
            formData.hoten = selectedCard.find('strong').first().text().trim() || 'Nguoi Nhan';
            formData.SDT = selectedCard.find('.text-muted').first().text().trim() || '0901234567';
            formData.quan = 'Quận 3';
            formData.diachicuthe = 'dia chi cu the';
            formData.diachiadd = '';
        } else {
            var hoten = $('#input-hoten').val().trim();
            var sdt = $('#input-sdt').val().trim();
            var diachi = $('#input-diachi').val().trim();
            if (!hoten) { showToast('error', 'Vui lòng nhập họ tên người nhận'); return; }
            if (hoten.length < 2 || hoten.length > 100) { showToast('error', 'Họ tên phải từ 2-100 ký tự'); return; }
            if (!sdt) { showToast('error', 'Vui lòng nhập số điện thoại'); return; }
            if (!validatePhone(sdt)) { showToast('error', 'Số điện thoại không hợp lệ (VD: 0912345678)'); return; }
            if (!diachi) { showToast('error', 'Vui lòng nhập địa chỉ giao hàng'); return; }
            if (diachi.length < 5 || diachi.length > 250) { showToast('error', 'Địa chỉ phải từ 5-250 ký tự'); return; }
            formData.hoten = hoten;
            formData.SDT = sdt;
            formData.quan = $('select[name="quan"]').val();
            formData.diachicuthe = diachi;
            formData.diachiadd = $('input[name="diachiadd"]').val();
        }

        formData.note = $('textarea[name="note"]').val() || '';
        formData.pttt = parseInt(pttt);
        var couponVal = $('#applied-coupon-id').val();
        if (couponVal) formData.makhuyenmai = parseInt(couponVal);
        formData.testResult = testResult;

        if (window._paymentInProgress) return;
        window._paymentInProgress = true;

        var btnText = testResult === 'failure' ? '<i class="fas fa-spinner fa-spin me-2"></i>Đang giả lập...' : '<i class="fas fa-spinner fa-spin me-2"></i>Đang xử lý...';
        $('#btn-submit-cod').prop('disabled', true).html(btnText);
        $('button[onclick*="submitPayment"]').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');

        $.ajax({
            url: URL_PROCESS_PAYMENT, type: 'POST',
            data: formData,
            headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
            success: function(r) {
                if (r.success) {
                    if (typeof clearCartLocal === 'function') clearCartLocal();
                    
                    if (r.paymentMethod === 'vnpay' && r.vnpayUrl) {
                        // ═══ VNPAY: redirect trực tiếp đến cổng thanh toán ═══
                        window.location.href = r.vnpayUrl;
                        return;
                    } else {
                        // ═══ COD: success bình thường ═══
                        showResultPopup(true, 'Đặt hàng thành công!', r.message || '', r.orderId, null, null, null, null);
                    }
                } else {
                    showResultPopup(false, 'Thanh toán thất bại', r.message || 'Đã xảy ra lỗi. Vui lòng thử lại.');
                }
            },
            error: function(xhr) {
                var msg = 'Lỗi kết nối. Vui lòng thử lại.';
                try {
                    var resp = JSON.parse(xhr.responseText);
                    if (resp && (resp.message || resp.error)) {
                        msg = resp.message || resp.error;
                    }
                } catch (e) {}

                if (xhr.status === 400) msg = msg || 'Dữ liệu không hợp lệ. Vui lòng kiểm tra lại thông tin.';
                if (xhr.status === 401) msg = msg || 'Phiên đăng nhập đã hết. Vui lòng đăng nhập lại.';
                if (xhr.status === 429) {
                    try {
                        var resp = JSON.parse(xhr.responseText);
                        var retryAfter = resp.retryAfter
                            || xhr.getResponseHeader('Retry-After')
                            || 30;
                        msg = (msg || 'Quá nhiều yêu cầu. Vui lòng thử lại sau.')
                            + ' (<strong>' + retryAfter + ' giây</strong>)';
                    } catch (e) {
                        var retryHeader = xhr.getResponseHeader('Retry-After');
                        msg = 'Quá nhiều yêu cầu. Vui lòng thử lại sau'
                            + (retryHeader ? ' ' + retryHeader + ' giây.' : ' ít phút.');
                    }
                }
                if (xhr.status === 500) msg = msg || 'Lỗi máy chủ. Vui lòng thử lại sau.';
                showResultPopup(false, 'Thanh toán thất bại', msg);
            },
            complete: function() {
                window._paymentInProgress = false;
                $('button[onclick*="submitPayment"]').prop('disabled', false);
                $('#btn-submit-cod').prop('disabled', false).html('<i class="fas fa-check-circle me-2"></i>Xác nhận đặt hàng');
            }
        });
    }

    function showToast(type, msg) {
        var color = type === 'error' ? '#dc3545' : '#28a745';
        var icon = type === 'error' ? 'fas fa-exclamation-circle' : 'fas fa-check-circle';
        var toast = $('<div class="fs-checkout-toast" style="background:' + color + ';color:#fff;"><i class="' + icon + ' me-2"></i>' + msg + '</div>');
        $('body').append(toast);
        setTimeout(function(){ toast.fadeOut(400, function(){ $(this).remove(); }); }, 3500);
    }

    // ════════════════════════════════════════════════════════════════
    // showResultPopup — Hiển thị popup kết quả thanh toán
    // ════════════════════════════════════════════════════════════════
    function showResultPopup(success, title, detail, orderId, qrCodeUrl, bankInfo, momoPayUrl, paypalApprovalUrl) {
        $('#payment-popup-overlay').remove();
        var iconHtml, contentHtml, btnHtml, redirectUrl;

        if (success) {
            redirectUrl = URL_CHI_TIET_DH + '?id=' + orderId;
            iconHtml = '<div class="fs-popup-icon-circle" style="background:linear-gradient(135deg,#28a745,#20c997);"><i class="fas fa-check fa-2x text-white"></i></div>';
            contentHtml = '<h4 style="font-weight:700;margin-bottom:8px;">' + title + '</h4>'
                + '<p class="text-muted" style="font-size:14px;margin-bottom:20px;">' + detail + '</p>';
            btnHtml = '<a href="' + redirectUrl + '" class="btn btn-success px-5" style="border-radius:8px;">Xem chi tiết đơn hàng</a>';
        } else {
            iconHtml = '<div class="fs-popup-icon-circle" style="background:linear-gradient(135deg,#dc3545,#e74c3c);"><i class="fas fa-times fa-2x text-white"></i></div>';
            contentHtml = '<h4 style="font-weight:700;margin-bottom:8px;">' + title + '</h4>'
                + '<p class="text-muted" style="font-size:14px;margin-bottom:20px;">' + detail + '</p>';
            btnHtml = '<button class="btn btn-warning px-5 me-2" onclick="$(\'#payment-popup-overlay\').remove();" style="border-radius:8px;">Thử lại</button>';
        }

        // Build popup DOM
        var overlay = $('<div id="payment-popup-overlay" class="popup-overlay"></div>');
        var box = $('<div class="popup-box"></div>');
        box.append(iconHtml);
        box.append(contentHtml);
        box.append(btnHtml);
        overlay.append(box);
        $('body').append(overlay);

        // Auto-redirect for COD/MoMo, stay for QR
        if (success && orderId) {
            overlay.click(function(e){ if(e.target===this) window.location.href = redirectUrl; });
            if (!qrCodeUrl) {
                setTimeout(function(){ window.location.href = redirectUrl; }, 4000);
            }
        } else {
            overlay.click(function(e){ if(e.target===this) $(this).remove(); });
        }
    }

    $(document).ready(function() {
        // Khởi tạo phương thức thanh toán đầu tiên
        var firstPt = $('.payment-method').first();
        if (firstPt.length) {
            firstPt.prop('checked', true);
            var id = firstPt.val();
            var name = firstPt.data('name');
            $('#payment-opt-' + id).addClass('selected');
            updatePaymentUI(name);
        }

        // Nút áp dụng coupon
        $('#btn-apply-coupon').click(applyCoupon);
        $('#coupon-code').keypress(function(e){ if(e.which===13){ e.preventDefault(); applyCoupon(); } });
        
        // ─── NÚT BỎ CHỌN MÃ ───
        $('#btn-remove-coupon').click(function() {
            $('#coupon-code').val('');
            $('#applied-coupon-id').val('');
            $('#coupon-result').hide();
            var sub = @(cart?.tongTien ?? 0);
            var total = Math.max(sub + SHIPPING_FEE, 0);
            $('#order-discount').hide().find('#discount-amount').text('-0 đ');
            $('#order-total').text(total.toLocaleString('vi-VN') + ' đ');
            $('#btn-apply-coupon').prop('disabled', false).html('Áp dụng');
            $('#btn-remove-coupon').hide();
            $('[onclick*="quickApplyCoupon"]').each(function() {
                $(this).css('background','#f8f9fa').css('border','1.5px solid #e5e7eb');
                $(this).find('div:last').html('<div style="width:24px;height:24px;border-radius:50%;border:2px solid #ddd;display:flex;align-items:center;justify-content:center;flex-shrink:0;">');
            });
            $.post(URL_REMOVE_COUPON, { __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() });
        });

        // ─── MỞ POPUP CHỌN MÃ GIẢM GIÁ ───
        $('#btn-browse-coupons').click(function() {
            $('#coupon-popup-overlay').fadeIn(150);
            loadCouponList();
        });

        $(document).on('click', '#coupon-popup-overlay', function(e) {
            if (e.target === this) $('#coupon-popup-overlay').fadeOut(150);
        });
        $(document).on('click', '.coupon-popup-close', function() {
            $('#coupon-popup-overlay').fadeOut(150);
        });
    });

    // ─── TẢI DANH SÁCH MÃ GIẢM GIÁ (Grab/ShopeeFood style popup) ───
    function loadCouponList() {
        var $list = $('#coupon-list-container');
        $list.html('<div style="text-align:center;padding:40px;"><i class="fas fa-spinner fa-spin fa-2x text-muted"></i><p class="mt-2 text-muted">Đang tải mã giảm giá...</p></div>');

        $.ajax({
            url: URL_GET_COUPONS,
            type: 'GET',
            success: function(res) {
                if (!res.success || !res.coupons || res.coupons.length === 0) {
                    $list.html('<div style="text-align:center;padding:40px;color:#888;"><i class="fas fa-tag fa-2x mb-2 d-block" style="opacity:.3"></i>Hiện chưa có mã giảm giá khả dụng</div>');
                    return;
                }
                $list.empty();
                res.coupons.forEach(function(c, idx) {
                    var now = new Date();
                    var expDate = c.ngayketthuc ? new Date(c.ngayketthuc) : null;
                    var expired = expDate && expDate < now;
                    if (expired) return;

                    var card = $('<div class="coupon-card"></div>');
                    card.css({
                        display:'flex', alignItems:'center', gap:'14px',
                        padding:'14px 16px', borderRadius:'14px',
                        border:'1.5px solid #e5e7eb', marginBottom:'10px',
                        background:'#fff', transition:'all .2s', cursor:'pointer',
                        position:'relative', overflow:'hidden'
                    });

                    var discountBadge = $('<div></div>');
                    discountBadge.css({
                        width:'56px', height:'56px', borderRadius:'12px',
                        background:'linear-gradient(135deg,#3CB815,#27a001)',
                        display:'flex', alignItems:'center', justifyContent:'center',
                        flexShrink:0, color:'#fff', fontSize:'18px', fontWeight:'800',
                        flexDirection:'column', lineHeight:'1.1'
                    });
                    discountBadge.html('<span style="font-size:10px;font-weight:500;">GIẢM</span><span>-' + c.phantramgiam + '%</span>');

                    var mid = $('<div style="flex:1;min-width:0"></div>');
                    var codeLabel = $('<div style="font-weight:700;font-size:14px;color:#1a1a2e;"></div>');
                    codeLabel.html(escHtml(c.tenkm));
                    var desc = $('<div style="font-size:12px;color:#888;margin-top:2px;"></div>');
                    var descText = c.mota || 'Giảm ' + c.phantramgiam + '% cho đơn hàng';
                    if (c.dieukien) descText += ' • ' + c.dieukien;
                    desc.text(descText);
                    mid.append(codeLabel, desc);

                    var isApplied = $('#coupon-code').val() === c.tenkm;
                    var checkMark = $('<div></div>');
                    checkMark.css({
                        width:'28px', height:'28px', borderRadius:'50%',
                        border:'2px solid ' + (isApplied ? '#3CB815' : '#ddd'),
                        background: isApplied ? '#3CB815' : 'transparent',
                        display:'flex', alignItems:'center', justifyContent:'center',
                        flexShrink:0, color:'#fff', fontWeight:'700', fontSize:'14px',
                        transition:'all .2s'
                    });
                    if (isApplied) checkMark.html('✓');

                    card.append(discountBadge, mid, checkMark);
                    card.hover(
                        function(){ $(this).css({borderColor:'#3CB815', boxShadow:'0 2px 12px rgba(60,184,21,.15)'}); },
                        function(){ $(this).css({borderColor:'#e5e7eb', boxShadow:'none'}); }
                    );
                    card.click(function() {
                        $('#coupon-code').val(c.tenkm);
                        $('#coupon-popup-overlay').fadeOut(150);
                        applyCoupon();
                    });

                    $list.append(card);
                });

                if ($list.children().length === 0) {
                    $list.html('<div style="text-align:center;padding:40px;color:#888;"><i class="fas fa-tag fa-2x mb-2 d-block" style="opacity:.3"></i>Hiện chưa có mã giảm giá khả dụng</div>');
                }
            },
            error: function() {
                $list.html('<div style="text-align:center;padding:40px;color:#e74c3c;"><i class="fas fa-exclamation-circle fa-2x mb-2 d-block"></i>Lỗi tải mã giảm giá</div>');
            }
        });
    }

    function escHtml(str) {
        if (!str) return '';
        var d = document.createElement('div'); d.textContent = str; return d.innerHTML;
    }
</script>
<!-- ─── POPUP CHỌN MÃ GIẢM GIÁ ─── -->
<div id="coupon-popup-overlay" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.55);z-index:99999;align-items:center;justify-content:center;">
    <div style="background:#fff;border-radius:20px;max-width:500px;width:92%;max-height:80vh;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,.2);animation:popIn .3s ease;">
        <!-- Header -->
        <div style="display:flex;align-items:center;justify-content:space-between;padding:18px 20px;border-bottom:1px solid #e5e7eb;background:linear-gradient(135deg,#f8f9fa,#fff);">
            <div>
                <h5 style="margin:0;font-weight:700;font-size:16px;color:#1a1a2e;">
                    <i class="fas fa-tag text-success me-1"></i>Chọn mã giảm giá
                </h5>
                <small style="color:#888;font-size:12px;">Chọn một mã để áp dụng vào đơn hàng</small>
            </div>
            <button type="button" class="coupon-popup-close" style="width:36px;height:36px;border-radius:50%;border:none;background:#e5e7eb;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:18px;color:#666;transition:all .15s;"
                    style="transition:all .15s;"                     class="fs-hover-danger"
                     style="transition:all .15s;">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <!-- Body -->
        <div style="padding:16px 20px;overflow-y:auto;max-height:calc(80vh - 80px);" id="coupon-list-container">
            <div style="text-align:center;padding:40px;">
                <i class="fas fa-spinner fa-spin fa-2x text-muted"></i>
                <p class="mt-2 text-muted">Đang tải mã giảm giá...</p>
            </div>
        </div>
    </div>
</div>
