
@{
    ViewBag.Title = "Signup";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Fastship - Khám phá, đặt hàng, giao tân nơi</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta content="" name="keywords" />
    <meta content="" name="description" />

    <!-- Favicon -->
    <link href="~/Source/Home/img/favicon.ico" rel="icon" />

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500&family=Lora:wght@600;700&display=swap"
          rel="stylesheet" />

    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet" />

    <!-- Libraries Stylesheet -->
    <link href="~/Source/Home/lib/animate/animate.min.css" rel="stylesheet" />
    <link href="~/Source/Home/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet" />

    <!-- Customized Bootstrap Stylesheet -->
    <link href="~/Source/Home/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Template Stylesheet -->
    <link href="~/Source/Home/css/style.css" rel="stylesheet" />
    <link href="~/Source/Home/css/login.css" rel="stylesheet" />
</head>

<body>
    <!-- Spinner Start -->
    
    <!-- Navbar End -->
    <div class="register-container">
        <h2>Đăng ký tài khoản</h2>
        <form action="~/Home/Signup" method="post" onsubmit="return validateSignupForm()">
            <input type="text" id="reg-hoten" name="hoten" placeholder="Họ tên" required />
            <input type="text" id="reg-username" name="username" placeholder="Username" required />
            <input type="password" id="reg-pwd" name="pwd" placeholder="Mật khẩu" required />
            <input type="password" id="reg-repeatpw" name="repeatpw" placeholder="Nhập lại mật khẩu" required />
            <select id="reg-loaitaikhoan" name="loaitaikhoan" required>
                <option value="" disabled selected>Chọn loại tài khoản</option>
                <option value="Khách hàng">Khách hàng</option>
                <option value="Quán ăn">Quán ăn</option>
                <option value="Shipper">Shipper</option>
            </select>
            <input type="tel" id="reg-sdt" name="sdt" placeholder="Số điện thoại" required />
            <input type="email" id="reg-email" name="email" placeholder="Email" required />
            <input type="text" id="reg-diachi" name="diachi" placeholder="Địa chỉ" required />
        @if (ViewBag.err != null)
        {
            <div class="alert alert-danger" role="alert">
                @ViewBag.err
            </div>
        }
        <div id="reg-err" class="alert alert-danger" role="alert" style="display:none"></div>
            <button type="submit" class="register-submit">Đăng ký</button>
        </form>
        <div class="login-note">
            <span>Đã có tài khoản? <a href="~/Home/Login">Đăng nhập</a></span>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Source/Home/lib/wow/wow.min.js"></script>
    <script src="~/Source/Home/lib/easing/easing.min.js"></script>
    <script src="~/Source/Home/lib/waypoints/waypoints.min.js"></script>
    <script src="~/Source/Home/lib/owlcarousel/owl.carousel.min.js"></script>

    <!-- Template Javascript -->
    <script>
        // BUG-004/005/006: Client-side validation cho form đăng ký
        function validateSignupForm() {
            var hoten = document.getElementById('reg-hoten').value.trim();
            var email = document.getElementById('reg-email').value.trim();
            var diachi = document.getElementById('reg-diachi').value.trim();
            var pwd = document.getElementById('reg-pwd').value;
            var repeatpw = document.getElementById('reg-repeatpw').value;
            var errDiv = document.getElementById('reg-err');

            // Kiểm tra trống
            if (hoten === '') {
                errDiv.textContent = 'Vui lòng nhập họ tên';
                errDiv.style.display = 'block';
                return false;
            }
            if (email === '') {
                errDiv.textContent = 'Vui lòng nhập email';
                errDiv.style.display = 'block';
                return false;
            }
            if (diachi === '') {
                errDiv.textContent = 'Vui lòng nhập địa chỉ';
                errDiv.style.display = 'block';
                return false;
            }

            // Kiểm tra mật khẩu
            if (pwd.length < 6) {
                errDiv.textContent = 'Mật khẩu phải có ít nhất 6 ký tự';
                errDiv.style.display = 'block';
                return false;
            }
            if (!/[0-9]/.test(pwd)) {
                errDiv.textContent = 'Mật khẩu phải chứa ít nhất một chữ số';
                errDiv.style.display = 'block';
                return false;
            }
            if (!/[a-zA-Z]/.test(pwd)) {
                errDiv.textContent = 'Mật khẩu phải chứa ít nhất một chữ cái';
                errDiv.style.display = 'block';
                return false;
            }
            if (pwd !== repeatpw) {
                errDiv.textContent = 'Xác nhận mật khẩu không khớp';
                errDiv.style.display = 'block';
                return false;
            }

            errDiv.style.display = 'none';
            return true;
        }
    </script>
    <script src="~/Source/Home/js/main.js"></script>
</body>
</html>


