{
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "dotnet publish ShipFoodCore/ShipFoodCore.csproj -c Release -o /app/publish",
    "watchPatterns": [
      "ShipFoodCore/**"
    ]
  },
  "deploy": {
    "numReplicas": 1,
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
