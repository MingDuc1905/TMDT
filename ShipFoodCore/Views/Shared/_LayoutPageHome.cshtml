@using ShipFood.Models
@inject ShipFood.Models.dbFoodyEntities _db
@{
    var userJson = Context.Session.GetString("user");
    ShipFood.Models.tbUser? user = userJson != null ? JsonSerializer.Deserialize<tbUser>(userJson) : null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Fastship — Khám phá & đặt món, giao tận nơi tại TP.HCM</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta name="keywords" content="đặt đồ ăn, giao thức ăn, quán ăn Sài Gòn, Fastship" />
    <meta name="description" content="Fastship — nền tảng đặt món và giao hàng nhanh tại TP. Hồ Chí Minh. Hàng trăm quán ăn, giao trong 30 phút." />
    <link href="~/Source/Home/css/chat.css" rel="stylesheet" />
    <!-- Favicon -->
    <link href="~/Source/Home/img/favicon.ico" rel="icon" />

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Roboto:wght@400;500&display=swap" rel="stylesheet" />

    <!-- Font Awesome 5 (CDN) — dùng CDN cloudflare, ko cần fallback local vì FA6 không tồn tại trong repo -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet" />

    <!-- Libraries Stylesheet -->
    <link href="~/Source/Home/lib/animate/animate.min.css" rel="stylesheet" />
    <link href="~/Source/Home/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet" />
    <!-- Customized Bootstrap Stylesheet -->
    <link href="~/Source/Home/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Template Stylesheet -->
    <link href="~/Source/Home/css/style.css" rel="stylesheet" />

    <!-- Sweetgreen-inspired overrides -->
    <link href="~/Source/Home/css/layout-sg.css" rel="stylesheet" />

    <!-- Global Design System v4.0 -->
    <link href="~/Source/Shared/css/fastship-design-tokens.css" rel="stylesheet" />

    @RenderSection("styles", required: false)
</head>

<body>
    <!-- Login state cho JS (cart-local.js cần biết user đã login chưa) -->
    <script>window._IS_LOGGED_IN = @(user != null ? "true" : "false");</script>

    <!-- Skip-to-content link cho keyboard users -->
    <a href="#main-content" class="skip-link">Bỏ qua điều hướng, đến nội dung chính</a>

    <!-- Skeleton Loading (replaces old spinner) -->
    <div id="fs-loading-skeleton" class="fs-skeleton-overlay" aria-hidden="true">
        <div class="fs-skel-header">
            <div class="fs-skel-logo fs-skeleton"></div>
            <div class="fs-skel-search fs-skeleton"></div>
            <div class="fs-skel-nav fs-skeleton"></div>
        </div>
        <div class="fs-skel-hero">
            <div class="fs-skel-hero-img fs-skeleton"></div>
            <div class="fs-skel-hero-text">
                <div class="fs-skeleton" style="height:24px;width:60%;margin-bottom:12px"></div>
                <div class="fs-skeleton" style="height:16px;width:40%"></div>
            </div>
        </div>
        <div class="fs-skel-cards">
            <div class="fs-skel-card fs-skeleton"></div>
            <div class="fs-skel-card fs-skeleton"></div>
            <div class="fs-skel-card fs-skeleton"></div>
            <div class="fs-skel-card fs-skeleton"></div>
        </div>
    </div>
    <!-- Skeleton End -->

    <!-- ===== NAVBAR ===== -->
    <header class="fs-header" id="fsHeader">
        <!-- Top info bar (desktop only) -->
        <div class="fs-topbar d-none d-lg-block">
            <div class="container-fluid px-5">
                <div class="row align-items-center">
                    <div class="col-lg-6 text-start">
                        <small><i class="fa fa-map-marker-alt me-1"></i>48 Cao Thắng, Quận 3, TP. Hồ Chí Minh</small>
                        <small class="ms-4"><i class="fa fa-envelope me-1"></i>fastship@contact.com</small>
                    </div>
                    <div class="col-lg-6 text-end">
                        <div class="top-bar-right">
                            <span>Theo dõi chúng tôi:</span>
                            <a href="https://facebook.com/fastship" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                                <svg viewBox="0 0 36 36" width="12" height="12" fill="currentColor"><path d="M15 35.8C6.5 34.3 0 26.9 0 18 0 8.1 8.1 0 18 0s18 8.1 18 18c0 8.9-6.5 16.3-15 17.8l-1-.8h-4zm10-12.8.8-5H21v-3.5c0-1.4.5-2.5 2.7-2.5H26V7.4c-1.3-.2-2.7-.4-4-.4-4.1 0-7 2.5-7 7v4h-4.5v5H15v12.7q1.5.3 3 .3c1.5 0 2-.1 3-.3V23z"/></svg>
                            </a>
                            <a href="https://instagram.com/fastship" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                                <svg viewBox="0 0 100 100" width="12" height="12" fill="currentColor"><path d="M50.092 67.942a17.85 17.85 0 1 0 0-35.7 17.85 17.85 0 0 0 0 35.7m0-7.14a10.71 10.71 0 1 0 0-21.42 10.71 10.71 0 0 0 0 21.42"/><path d="M75.042 30.474a5.355 5.355 0 1 1-10.71 0 5.355 5.355 0 0 1 10.71 0"/><path d="M14.426 48.698c0-11.995 0-17.993 2.335-22.577a21.42 21.42 0 0 1 9.36-9.36c4.584-2.335 10.582-2.335 22.577-2.335h2.856c11.995 0 17.993 0 22.577 2.335a21.42 21.42 0 0 1 9.36 9.36c2.335 4.584 2.335 10.582 2.335 22.577v2.856c0 11.995 0 17.993-2.335 22.577a21.42 21.42 0 0 1-9.36 9.36c-4.584 2.335-10.582 2.335-22.577 2.335h-2.856c-11.995 0-17.993 0-22.577-2.335a21.42 21.42 0 0 1-9.36-9.36c-2.335-4.584-2.335-10.582-2.335-22.577zm34.272-27.132h2.856c6.115 0 10.274.007 13.487.268 3.131.257 4.73.72 5.848 1.289a14.28 14.28 0 0 1 6.24 6.24c.572 1.117 1.036 2.717 1.286 5.848.264 3.213.271 7.372.271 13.487v2.856c0 6.115-.007 10.274-.268 13.487-.257 3.131-.72 4.73-1.289 5.848a14.28 14.28 0 0 1-6.24 6.24c-1.117.572-2.717 1.036-5.848 1.286-3.213.264-7.372.271-13.487.271h-2.856c-6.115 0-10.274-.007-13.487-.268-3.131-.257-4.73-.72-5.848-1.289a14.28 14.28 0 0 1-6.24 6.24c-.572-1.117-1.036-2.717-1.286-5.848-.267-3.213-.271-7.372-.271-13.487v-2.856c0-6.115.007-10.274.268-13.487.257-3.131.72-4.73 1.289-5.848a14.28 14.28 0 0 1 6.24-6.24c1.117-.572 2.717-1.036 5.848-1.286 3.213-.264 7.372-.271 13.487-.271"/></svg>
                            </a>
                            <a href="https://tiktok.com/@@fastship" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
                                <svg viewBox="0 0 100 100" width="12" height="12" fill="currentColor"><path d="M92.26 23.33a28.09 28.09 0 0 1-16.53-5.34 28.07 28.07 0 0 1-9.88-13.32 28.09 28.09 0 0 1-1.44-5.59H49.31v61.36a15.6 15.6 0 0 1-4.23 10.56 15.6 15.6 0 0 1-22.13 0 15.6 15.6 0 0 1 0-22.13 15.6 15.6 0 0 1 14.52-4.23V45.07A31.2 31.2 0 0 0 28 43.53 31.2 31.2 0 0 0 0 74.73a31.2 31.2 0 0 0 17.88 28.09 31.2 31.2 0 0 0 33.5-6.6 31.2 31.2 0 0 0 9.27-22.13V27.93a43.66 43.66 0 0 0 25.36 8.67V23.33h-1.59z"/></svg>
                            </a>
                            <a href="https://youtube.com/@@fastship" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
                                <svg viewBox="0 0 256 180" width="12" height="12" fill="currentColor"><path d="M250.346 28.075A32.18 32.18 0 0 0 227.69 5.418C207.824 0 127.87 0 127.87 0S47.912.164 28.046 5.582A32.18 32.18 0 0 0 5.39 28.24c-6.009 35.298-8.34 89.084.165 122.97a32.18 32.18 0 0 0 22.656 22.657c19.866 5.418 99.822 5.418 99.822 5.418s79.955 0 99.82-5.418a32.18 32.18 0 0 0 22.657-22.657c6.338-35.348 8.291-89.1-.164-123.134Z"/><path fill="currentColor" d="m102.421 128.06 66.328-38.418-66.328-38.418z"/></svg>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main nav -->
        <nav class="fs-nav navbar navbar-expand-lg navbar-light" aria-label="Điều hướng chính">
            <div class="container-fluid px-3 px-lg-5">
                <!-- Logo -->
                <a href="/Home" class="navbar-brand fs-logo" aria-label="Fastship trang chủ">
                    <span class="logo-f">F</span><span class="logo-ast">ast</span><span class="logo-ship">ship</span>
                </a>

                <!-- ═══ MOBILE HEADER: always visible icons (login/logout, cart, hamburger) ═══ -->
                <div class="d-flex d-lg-none align-items-center ms-auto gap-1 me-1">
                    @if (user != null)
                    {
                        <!-- User avatar icon → đơn hàng (luôn visible) -->
                        <a href="/Cart/LichSuDatHang" class="fs-mobile-icon" aria-label="Lịch sử đơn hàng" title="Lịch sử đơn hàng"
                           style="display:flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:50%;background:var(--fs-green);color:#fff;font-size:13px;font-weight:700;text-decoration:none;transition:all .15s;"
                           onmouseenter="this.style.opacity='.8'" onmouseleave="this.style.opacity='1'">
                            @user.username.Substring(0,1).ToUpper()
                        </a>
                        <!-- Logout icon (luôn visible) -->
                        <a href="/Home/Logout" class="fs-mobile-icon" aria-label="Đăng xuất" title="Đăng xuất"
                           style="display:flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:50%;color:#dc3545;font-size:15px;border:1.5px solid rgba(220,53,69,.25);transition:all .15s;text-decoration:none;"
                           onmouseenter="this.style.background='#fef2f2';this.style.borderColor='#dc3545'"
                           onmouseleave="this.style.background='transparent';this.style.borderColor='rgba(220,53,69,.25)'">
                            <i class="fa fa-sign-out-alt"></i>
                        </a>
                    }
                    else
                    {
                        <a href="/Home/Login" class="fs-mobile-login-btn" aria-label="Đăng nhập" title="Đăng nhập"
                           style="display:flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:50%;color:#3CB815;font-size:16px;border:1.5px solid rgba(60,184,21,.3);transition:all .15s;text-decoration:none;"
                           onmouseenter="this.style.background='#3CB815';this.style.color='#fff'"
                           onmouseleave="this.style.background='transparent';this.style.color='#3CB815'">
                            <i class="fa fa-sign-in-alt" style="font-size:14px;"></i>
                        </a>
                    }
                    <a class="fs-cart-btn" href="/Cart" aria-label="Giỏ hàng" id="navCartBtnMobile" style="position:relative;">
                        <i class="fa fa-shopping-bag"></i>
                        <span class="fs-cart-badge" id="navCartBadgeMobile" style="display:none;position:absolute;top:-6px;right:-6px;background:#dc3545;color:#fff;width:20px;height:20px;border-radius:50%;font-size:11px;align-items:center;justify-content:center;font-weight:700;">0</span>
                    </a>
                    <button type="button" class="navbar-toggler border-0" data-bs-toggle="collapse" data-bs-target="#navbarCollapse" aria-controls="navbarCollapse" aria-expanded="false" aria-label="Mở menu">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                </div>

                <!-- Search (visible inline on desktop) -->
                @{
                    var selectedIdDM = ViewBag.idDM as int?;
                    List<tbDanhMuc> allDanhMuc = new List<tbDanhMuc>();
                    try { allDanhMuc = _db.tbDanhMuc.ToList(); } catch { /* DB unavailable — skip category filter */ }
                }
                <div class="fs-search-wrap d-none d-lg-flex">
                    <form action="/Home" method="get" class="fs-search-form" role="search" aria-label="Tìm quán ăn">
                        <select name="idDM" aria-label="Chọn danh mục">
                            <option value="">Tất cả</option>
                            @foreach (var item in allDanhMuc)
                            {
                                if (selectedIdDM.HasValue && selectedIdDM.Value == item.madanhmuc)
                                {
                                    <option value="@item.madanhmuc" selected>@item.tendanhmuc</option>
                                }
                                else
                                {
                                    <option value="@item.madanhmuc">@item.tendanhmuc</option>
                                }
                            }
                        </select>
                        <input type="text" value="@ViewBag.txtSearch" name="txtSearch" placeholder="Tìm món ăn, quán ăn..." aria-label="Từ khoá tìm kiếm" id="mainSearchInput" />
                        <button type="submit" aria-label="Tìm kiếm"><i class="fa fa-search me-1"></i>Tìm</button>
                    </form>
                </div>

                <!-- Collapse menu -->
                <div class="collapse navbar-collapse" id="navbarCollapse">
                    <!-- Mobile search inside collapse -->
                    <div class="d-lg-none px-2 py-2">
                        <form action="/Home" method="get" class="fs-search-form-mobile" role="search">
                            <div class="input-group">
                                <select name="idDM" class="form-select form-select-sm fs-select-mobile" aria-label="Danh mục">
                                    <option value="">Tất cả</option>
                                    @foreach (var item in allDanhMuc)
                                    {
                                        if (selectedIdDM.HasValue && selectedIdDM.Value == item.madanhmuc)
                                        {
                                            <option value="@item.madanhmuc" selected>@item.tendanhmuc</option>
                                        }
                                        else
                                        {
                                            <option value="@item.madanhmuc">@item.tendanhmuc</option>
                                        }
                                    }
                                </select>
                                <input type="text" value="@ViewBag.txtSearch" name="txtSearch" class="form-control form-control-sm" placeholder="Tìm quán ăn..." />
                                <button type="submit" class="btn btn-success btn-sm px-3"><i class="fa fa-search"></i></button>
                            </div>
                        </form>
                    </div>

                    <!-- Nav links -->
                    <div class="navbar-nav ms-auto p-2 p-lg-0 align-items-lg-center">
                        <a href="/Home" class="nav-item nav-link">Trang chủ</a>
                        <a href="/Home/DanhMuc" class="nav-item nav-link">Menu ẩm thực</a>

                        @if (user != null)
                        {                        <!-- ═══ DESKTOP: direct links (ko cần scroll) ═══ -->
                            <div class="d-none d-lg-flex align-items-center gap-2 ms-2">
                                <!-- Avatar + tên -->
                                <span class="d-flex align-items-center gap-2 px-2" style="cursor:default;">
                                    <span class="fs-avatar-xs" style="width:32px;height:32px;border-radius:50%;background:var(--fs-green);color:#fff;display:inline-flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;">@user.username.Substring(0,1).ToUpper()</span>
                                    <span class="fs-14 fw-500">@user.username</span>
                                </span>
                                <!-- Lịch sử đơn hàng -->
                                <a href="/Cart/LichSuDatHang" class="nav-link d-inline-flex align-items-center gap-1 px-2" style="font-size:13px;font-weight:500;color:#555;transition:color .15s;"
                                   onmouseenter="this.style.color='var(--fs-green)'" onmouseleave="this.style.color='#555'">
                                    <i class="fa fa-history"></i>
                                    <span>Lịch sử</span>
                                </a>
                                <!-- Role-specific link -->
                                @if (user.loaitaikhoan.Equals("Quán ăn"))
                                {
                                    <a href="/Restaurant" class="nav-link d-inline-flex align-items-center gap-1 px-2" style="font-size:13px;font-weight:500;color:#555;transition:color .15s;"
                                       onmouseenter="this.style.color='var(--fs-green)'" onmouseleave="this.style.color='#555'">
                                        <i class="fa fa-store"></i>
                                        <span>Quản lý quán</span>
                                    </a>
                                }
                                @if (user.loaitaikhoan.Equals("Shipper"))
                                {
                                    <a href="/Shipper" class="nav-link d-inline-flex align-items-center gap-1 px-2" style="font-size:13px;font-weight:500;color:#555;transition:color .15s;"
                                       onmouseenter="this.style.color='var(--fs-green)'" onmouseleave="this.style.color='#555'">
                                        <i class="fa fa-truck"></i>
                                        <span>Bảng điều khiển</span>
                                    </a>
                                }
                                @if (user.loaitaikhoan.Equals("Admin"))
                                {
                                    <a href="/Admin" class="nav-link d-inline-flex align-items-center gap-1 px-2" style="font-size:13px;font-weight:500;color:#555;transition:color .15s;"
                                       onmouseenter="this.style.color='var(--fs-green)'" onmouseleave="this.style.color='#555'">
                                        <i class="fa fa-shield-alt"></i>
                                        <span>Quản trị</span>
                                    </a>
                                }
                                <!-- Logout -->
                                <a href="/Home/Logout" class="d-inline-flex align-items-center justify-content-center" aria-label="Đăng xuất" title="Đăng xuất"
                                   style="width:36px;height:36px;border-radius:50%;color:#dc3545;font-size:15px;border:1.5px solid rgba(220,53,69,.25);transition:all .15s;text-decoration:none;"
                                   onmouseenter="this.style.background='#fef2f2';this.style.borderColor='#dc3545'"
                                   onmouseleave="this.style.background='transparent';this.style.borderColor='rgba(220,53,69,.25)'">
                                    <i class="fa fa-sign-out-alt"></i>
                                </a>
                            </div>
                            <!-- ═══ MOBILE: direct links (visible <992px) — KO cần scroll ═══ -->
                            <div class="d-lg-none border-top mt-2 pt-2 px-2">
                                <div class="text-muted small mb-2 px-2">
                                    <i class="fa fa-user-circle me-1"></i>Xin chào, <strong class="text-dark">@user.username</strong>
                                </div>
                                <a href="/Cart/LichSuDatHang" class="d-flex align-items-center gap-2 py-2 px-2 rounded text-decoration-none text-dark hover-bg-light"
                                   style="transition:background .15s;"
                                   onmouseenter="this.style.background='#f0fdf4'" onmouseleave="this.style.background=''">
                                    <i class="fa fa-history" style="width:18px;color:var(--fs-green);"></i>
                                    <span>Lịch sử đơn hàng</span>
                                </a>
                                @if (user.loaitaikhoan.Equals("Quán ăn"))
                                {
                                    <a href="/Restaurant" class="d-flex align-items-center gap-2 py-2 px-2 rounded text-decoration-none text-dark hover-bg-light"
                                       style="transition:background .15s;"
                                       onmouseenter="this.style.background='#f0fdf4'" onmouseleave="this.style.background=''">
                                        <i class="fa fa-store" style="width:18px;color:var(--fs-green);"></i>
                                        <span>Quản lý quán</span>
                                    </a>
                                }
                                <a href="/Home/Logout" class="d-flex align-items-center gap-2 py-2 px-2 rounded text-decoration-none text-danger fw-500"
                                   style="transition:background .15s;"
                                   onmouseenter="this.style.background='#fef2f2'" onmouseleave="this.style.background=''">
                                    <i class="fa fa-sign-out-alt" style="width:18px;"></i>
                                    <span>Đăng xuất</span>
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="nav-item d-flex align-items-center gap-1 gap-lg-2">
                                <a href="/Home/Login" class="nav-link d-inline-flex align-items-center gap-1 px-2 px-lg-3" style="font-size:13.5px;font-weight:600;border:1.5px solid var(--fs-green);border-radius:24px;padding:6px 16px;color:var(--fs-green);transition:all .2s;"
                                   onmouseenter="this.style.background='var(--fs-green)';this.style.color='#fff'"
                                   onmouseleave="this.style.background='transparent';this.style.color='var(--fs-green)'">
                                    <i class="fa fa-sign-in-alt"></i>
                                    <span class="d-none d-lg-inline">Đăng nhập</span>
                                </a>
                                <a href="/Home/Signup" class="nav-link d-inline-flex align-items-center gap-1 px-2 px-lg-3" style="font-size:13.5px;font-weight:600;background:var(--fs-green);color:#fff;border-radius:24px;padding:6px 16px;border:1.5px solid var(--fs-green);transition:all .2s;"
                                   onmouseenter="this.style.background='#2ea310';this.style.borderColor='#2ea310'"
                                   onmouseleave="this.style.background='var(--fs-green)';this.style.borderColor='var(--fs-green)'">
                                    <i class="fa fa-user-plus"></i>
                                    <span class="d-none d-lg-inline">Đăng ký</span>
                                </a>
                            </div>
                        }

                        <a class="fs-cart-btn d-none d-lg-flex ms-2" href="/Cart" aria-label="Giỏ hàng" id="navCartBtn" style="position:relative;">
                            <i class="fa fa-shopping-bag"></i>
                            <span class="fs-cart-badge" id="navCartBadge" style="display:none;position:absolute;top:-6px;right:-4px;background:#dc3545;color:#fff;width:20px;height:20px;border-radius:50%;font-size:10px;align-items:center;justify-content:center;font-weight:700;box-shadow:0 2px 4px rgba(220,53,69,.3);border:2px solid #fff;">0</span>
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <!-- ===== END NAVBAR ===== -->

    <!-- Main content -->
    <main id="main-content">
        @RenderBody()
    </main>

    <!-- ===== FOOTER sweetgreen-style ===== -->
    <footer class="fs-footer">
        <!-- Newsletter band -->
        <div class="fs-footer-newsletter">
            <div class="container">
                <div class="row align-items-center justify-content-between gy-3">
                    <div class="col-md-6">
                        <h5 class="mb-1 fw-700">Nhận ưu đãi & thực đơn mới nhất</h5>
                        <p class="mb-0 text-muted small">Đăng ký để không bỏ lỡ món mới, khuyến mãi hấp dẫn.</p>
                    </div>
                    <div class="col-md-6">
                        <form class="fs-newsletter-form" novalidate>
                            <div class="input-group">
                                <input type="email" class="form-control" placeholder="Email của bạn..." aria-label="Email đăng ký nhận tin" required />
                                <button class="btn btn-success" type="submit">Đăng ký</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
