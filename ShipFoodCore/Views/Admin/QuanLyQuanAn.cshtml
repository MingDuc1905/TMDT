@{
    ViewBag.Title = "Quản lý Quán ăn";
    Layout = "~/Views/Shared/_LayoutPageAdmin.cshtml";
    List<ShipFood.Models.tbQuanAn> datas = ViewBag.datas;
}

<div class="content-body">
    <div class="container-fluid">
        @if (TempData["AdminSuccess"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">@TempData["AdminSuccess"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        }
        @if (TempData["AdminError"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">@TempData["AdminError"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        }

        <div class="page-header">
            <h2><i class="fas fa-store" style="color:#3CB815;margin-right:8px;"></i>Quản lý Quán ăn</h2>
            <div class="toolbar">
                <input type="text" id="search-qa" class="form-control" placeholder="Tìm kiếm quán ăn..." style="width:260px;" onkeyup="filterTable('qa')" />
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table" id="qa-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Tên quán</th>
                                <th>Username</th>
                                <th>Trạng thái</th>
                                <th style="width:180px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var i in datas)
                            {
                                var statusClass = i.tbUser.trangthai == 2 ? "locked" : (i.tbUser.trangthai == 1 ? "active" : "pending");
                                var statusText = i.tbUser.trangthai == 2 ? "Đã khóa" : (i.tbUser.trangthai == 1 ? "Hoạt động" : "Chờ duyệt");
                                <tr>
                                    <td data-label="ID" style="font-weight:600;color:#1a1a2e;">#@i.userid</td>
                                    <td data-label="Tên quán">@i.tenquanan</td>
                                    <td data-label="Username">@i.tbUser.username</td>
                                    <td data-label="Trạng thái"><span class="badge-status @statusClass"><i class="fas @(i.tbUser.trangthai == 2 ? "fa-lock" : (i.tbUser.trangthai == 1 ? "fa-check-circle" : "fa-hourglass-half"))" style="margin-right:4px;"></i>@statusText</span></td>
                                    <td data-label="Thao tác">
                                        <a href="~/Admin/PostTaiKhoan?id=@i.userid" class="btn btn-info btn-sm"><i class="fas fa-edit"></i> Sửa</a>
                                        @if (i.tbUser.trangthai == 0)
                                        {
                                            <a href="~/Admin/Duyet?id=@i.userid" class="btn btn-success btn-sm">Duyệt</a>
                                            <a href="~/Admin/Huy?id=@i.userid" class="btn btn-danger btn-sm">Từ chối</a>
                                        }
                                        @if (i.tbUser.trangthai == 1)
                                        {
                                            <a href="~/Admin/LockOrUnLock?id=@i.userid" class="btn btn-danger btn-sm"><i class="fas fa-lock"></i> Khóa</a>
                                        }
                                        @if (i.tbUser.trangthai == 2)
                                        {
                                            <a href="~/Admin/LockOrUnLock?id=@i.userid" class="btn btn-success btn-sm"><i class="fas fa-lock-open"></i> Mở khóa</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        @if (!datas.Any())
        {
            <div style="text-align:center;padding:60px 20px;color:#9ca3af;">
                <div style="font-size:48px;margin-bottom:12px;"><i class="fas fa-inbox" style="color:#9ca3af;"></i></div>
                <p>Chưa có quán ăn nào</p>
            </div>
        }
    </div>
</div>

<script>
    function filterTable(type) {
        var input = document.getElementById('search-' + type);
        var filter = input.value.toUpperCase();
        var table = document.getElementById(type + '-table');
        if (!table) return;
        var tr = table.getElementsByTagName('tr');
        for (var i = 0; i < tr.length; i++) {
            var td = tr[i].getElementsByTagName('td');
            var found = false;
            for (var j = 0; j < td.length; j++) {
                if (td[j] && td[j].textContent.toUpperCase().indexOf(filter) > -1) { found = true; break; }
            }
            tr[i].style.display = found ? '' : 'none';
        }
    }
</script>
