
@{
    ViewBag.Title = "SanPham";
    Layout = "~/Views/Shared/_LayoutPageHome.cshtml";
}
@model List<ShipFood.Models.tbMonAn>
@{
    ShipFood.Models.tbDanhMuc danhmuc = ViewBag.tendanhmuc;
}
<!-- Page Header Start -->
<div class="container-fluid page-header mb-5 wow fadeIn" data-wow-delay="0.1s">
    <div class="container">
        <h1 class="display-3 mb-3 animated slideInDown">Menu ẩm thực</h1>
        <nav aria-label="breadcrumb animated slideInDown">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a class="text-body" href="#">Trang chủ</a></li>
                <li class="breadcrumb-item text-dark" aria-current="page">Danh mục</li>
                <li class="breadcrumb-item text-dark active" aria-current="page">Menu ẩm thực</li>
            </ol>
        </nav>
    </div>
</div>
<!-- Page Header End -->
<!-- Product Start -->
<div class="container-xxl py-5">
    <div class="container">
        <div class="row g-0 gx-5 align-items-end">
            <div class="col-lg-6">
                <div class="section-header text-start mb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 500px;">
                    <h1 class="display-5 mb-3">@danhmuc.tendanhmuc</h1>
                    <p>Khám phá các món ăn hấp dẫn từ danh mục @danhmuc.tendanhmuc — đặt ngay, giao tận nơi trong 30 phút!</p>
                </div>
            </div>
        </div>
        <div class="tab-content">
            <div id="tab-1" class="tab-pane fade show p-0 active">
                <div class="row g-4">
                    @foreach (var item in Model)
                    {
                        <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 col-6 animate-fade-in-up" data-wow-delay="0.1s">
                            <div class="fs-glass-card hover-lift h-100 d-flex flex-column" style="overflow:hidden;">
                                <div class="position-relative bg-light" style="flex:1;">
                                    <img class="img-fluid w-100" style="object-fit:cover; aspect-ratio: 1/1;" src="@TinhToan.HinhAnhUrl(item.hinhanh)" alt="@item.tenmon" loading="lazy" />
                                    <div class="bg-secondary rounded text-white position-absolute start-0 top-0 m-3 py-1 px-2" style="font-size:0.75rem;">New</div>
                                </div>
                        <div class="text-center p-3">
                            <a class="d-block h6 mb-1 text-decoration-none text-dark fw-bold" href="@Url.Action("ChiTietSanPham","Home", new { id = item.mamon })" style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@item.tenmon</a>
                            <span class="text-primary fw-bold" style="font-size:0.9rem;">@item.giatien?.ToString("N0") đ</span>
                        </div>
                        <div class="d-flex border-top mt-auto">
                            <small class="w-50 text-center border-end py-2">
                                <a class="text-body text-decoration-none" href="@Url.Action("ChiTietSanPham","Home", new { id = item.mamon })" style="font-size:0.8rem;"><i class="fa fa-eye text-primary me-1"></i>Chi tiết</a>
                            </small>
                            <small class="w-50 text-center py-2">
                                <a class="text-body text-decoration-none" href="@Url.Action("DetailRestaurant","Home", new { id = item.maquanan })" style="font-size:0.8rem;"><i class="fa fa-shopping-bag text-primary me-1"></i>Đặt món</a>
                            </small>
                        </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Product End -->
