@model List<ShipFood.Models.DonHangDangLam>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutPageShipper.cshtml";
}

<div class="content-body">
    <div class="container-xl">

        <div class="custom-tab-1">
            <nav id="orders-table-tab" class="orders-table-tab app-nav-tabs nav shadow-sm flex-column flex-sm-row">
                <a class="flex-sm-fill text-sm-center nav-link active" id="orders-all-tab" data-toggle="tab" href="#freepick" role="tab" aria-selected="true">FREE-PICK</a>
                <a class="flex-sm-fill text-sm-center nav-link" id="orders-paid-tab" data-toggle="tab" href="#danhsach" role="tab" aria-selected="false">ĐƠN HÀNG</a>

            </nav>
            <div class="tab-content" id="orders-table-tab-content">
                <div id="freepick" class="tab-pane fade active show">
                    <div class="my-post-content pt-3">
                        <div class="full-map-area mb-4" id="shipper-map" style="height:380px; background:#f0f0f0; border-radius:12px;">
                            <!-- Leaflet.js live map: shipper location tracking -->
                        </div>

                        <div class="text-center mb-2">
                            <a href="javascript:void()" class="btn btn-primary">Làm mới</a>
                        </div>
                    </div>
                </div>
                <div id="danhsach" class="tab-pane fade">
                    <div class="container-fluid">
                        <div class="row">
                            <div class="col-12">
                                <div class="table-responsive">
                                    <table class="table table-striped table-bordered first">
                                        <thead style="text-align:center">
                                            <tr>
                                                <th>ID</th>
                                                <th>Ngày</th>
                                                <th>VT quán</th>
                                                <th>VT khách hàng</th>
                                                <th style="width:110px">Thu khách</th>
                                                <th style="width:110px">Ship</th>
                                                <th style="width:120px">Trạng thái</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td data-label="Đơn hàng"><a class="" href="@Url.Action("OrderDetail","Shipper",  new {id = item.madh})">#@item.madh</a></td>

                                                    <td data-label="Ngày">@item.ngaydathang.Value.ToString("dd/MM/yyyy")</td>
                                                    <td data-label="VT quán">@item.diachi</td>
                                                    <td data-label="VT khách hàng">@item.DiaChiQuan</td>
                                                    <td data-label="Thu khách">@item.tongtien?.ToString("N0")</td>
                                                    <td data-label="Ship">@item.phiship?.ToString("N0")</td>
                                                    <td data-label="Trạng thái"><span class="btn btn-sm light btn-warning fs-16">@item.trangthai</span></td>

                                                    <td data-label="">
                                                        <div class="dropdown ml-auto text-right">
                                                            <div class="btn-link" data-toggle="dropdown">
                                                                <svg width="24px" height="24px" viewBox="0 0 24 24" version="1.1">
                                                                    <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                                                        <rect x="0" y="0" width="24" height="24"></rect>
                                                                        <circle fill="#000000" cx="5" cy="12" r="2"></circle>
                                                                        <circle fill="#000000" cx="12" cy="12" r="2"></circle>
                                                                        <circle fill="#000000" cx="19" cy="12" r="2"></circle>
                                                                    </g>
                                                                </svg>
                                                            </div>
                                                            <div class="dropdown-menu dropdown-menu-right">
                                                                <a class="dropdown-item" href="@Url.Action("OrderDetail","Shipper",  new {id = item.madh})">
                                                                    <i class="fas fa-check-square scale5 text-primary mr-2"></i> Chấp nhận đơn
                                                                    hàng
                                                                </a>
                                                                <a class="dropdown-item" href="#"><i class="fas fa-times-circle scale5 text-danger mr-2"></i> Từ chối đơn hàng</a>
                                                            </div>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>

                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="text-center mb-2">
                        <a href="javascript:void()" class="btn btn-primary">Làm mới</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Leaflet.js map initialization for Shipper location tracking
    $(document).ready(function () {
        if (typeof L !== 'undefined' && document.getElementById('shipper-map')) {
            // Default: HCM City center
            var map = L.map('shipper-map').setView([10.8231, 106.6297], 13);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
            }).addTo(map);

            // Get shipper current location via Geolocation API
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(function(pos) {
                    var lat = pos.coords.latitude;
                    var lng = pos.coords.longitude;
                    map.setView([lat, lng], 15);
                    L.marker([lat, lng]).addTo(map)
                        .bindPopup('Vị trí của bạn')
                        .openPopup();

                    // Thông báo toạ độ qua SignalR (nếu đang giao hàng)
                    if (window.shipperConn && window.currentOrderId) {
                        window.shipperConn.invoke('UpdateLocation', window.currentOrderId, lat, lng)
                            .catch(function(err) { console.error('UpdateLocation error:', err); });
                    }
                }, function() {
                    // Fallback: show HCM center
                    L.marker([10.8231, 106.6297]).addTo(map)
                        .bindPopup('Fastship - TP. Hồ Chí Minh')
                        .openPopup();
                });
            }
        }
    });
</script>

