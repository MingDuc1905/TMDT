@{
    ViewBag.Title = "Quên mật khẩu";
    Layout = "~/Views/Shared/_LayoutAuth.cshtml";
}

@section authNavRight {
    <a href="~/Home/Login" class="fs-btn fs-btn-primary" style="padding:7px 18px;border-radius:20px;font-size:13px;font-weight:600;white-space:nowrap;">Đăng nhập</a>
}

<div class="auth-card auth-container">
    <h2 style="font-size:22px;margin-bottom:8px;color:var(--fs-dark);font-weight:600;">Quên mật khẩu</h2>
    <p style="font-size:14px;color:var(--fs-muted);margin-bottom:24px;line-height:1.5;">
        Nhập email đăng ký, Fastship sẽ gửi mật khẩu mới cho bạn.
    </p>

    <form id="authForm" method="post" action="~/Home/Forgot">
        @Html.AntiForgeryToken()
        <label for="forgot-email" class="visually-hidden">Email</label>
        <input type="email" id="forgot-email" name="email" placeholder="Email" autocomplete="email" required />
        <button type="submit" class="forgot-password-submit">Gửi mật khẩu mới</button>
    </form>

    <div class="footer-text" style="margin-top:20px;">
        Bằng cách đăng nhập hoặc đăng ký, bạn đồng ý
        với <a href="#">Điều khoản dịch vụ</a> của Fastship
    </div>
</div>
