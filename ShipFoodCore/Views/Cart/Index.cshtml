@inject ShipFood.Models.dbFoodyEntities _db
@{
    ViewBag.Title = "Giỏ hàng";
    Layout = "~/Views/Shared/_LayoutPageHome.cshtml";
    var cartJson = Context.Session.GetString("cart");
    ShipFood.Models.Cart? cart = cartJson != null ? JsonSerializer.Deserialize<ShipFood.Models.Cart>(cartJson) : null;
}

@section styles {
    <style>
        .cart-wrapper { margin-top: 100px; padding: 32px 0 60px; background: var(--fs-light); min-height: 70vh; }
        @@media (max-width: 768px) {
            .cart-wrapper { margin-top: 80px; padding: 20px 0 40px; }
            .cart-header { padding: 16px 20px; }
            .cart-header h3 { font-size: 17px; }
            .cart-item { flex-wrap: wrap; gap: 10px; padding: 14px 16px; }
            .cart-item img { width: 60px; height: 60px; }
            .cart-item .item-info { min-width: calc(100% - 76px); flex: 1; }
            .cart-item .item-name { font-size: 13px; }
            .cart-item .item-price { font-size: 12px; }
            .qty-control { order: 2; }
            .item-total { min-width: auto; font-size: 13px; order: 3; }
            .delete-btn { order: 4; }
            .cart-summary { padding: 18px; }
            .summary-total { font-size: 16px; }
        }
        @@media (max-width: 576px) {
            .cart-wrapper { margin-top: 70px; padding: 12px 0 30px; }

            /* === MULTI-ROW CART ITEM LAYOUT === */
            .cart-item {
                flex-wrap: wrap;
                gap: 6px;
                padding: 10px 12px;
                position: relative;
            }
            /* Row 1: Image (60px) + Name (flex) + Delete (right) */
            .cart-item img {
                width: 60px;
                height: 60px;
                order: 1;
            }
            .cart-item .item-info {
                order: 2;
                flex: 1;
                min-width: 0;
                padding-right: 4px;
            }
            .cart-item .item-name {
                font-size: 14px;
                font-weight: 600;
                line-height: 1.3;
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
            }
            .cart-item .item-price {
                font-size: 12px;
                margin-top: 2px;
            }
            .delete-btn {
                order: 3;
                align-self: flex-start;
                min-width: 44px;
                min-height: 44px;
                display: flex;
                align-items: center;
                justify-content: center;
                margin-top: 4px;
            }
            /* Row 2 (shared line): Price left, Qty controls right */
            .item-total {
                order: 4;
                width: auto;
                min-width: auto;
                font-size: 14px;
                font-weight: 700;
                color: var(--fs-danger);
                text-align: left;
                padding-top: 6px;
                margin-top: 4px;
                border-top: 1px solid var(--fs-border-soft);
                flex: 0 0 auto;
            }
            .qty-control {
                order: 5;
                margin-left: auto;
                padding-top: 6px;
                margin-top: 4px;
                border-top: 1px solid var(--fs-border-soft);
            }
            .qty-btn {
                width: 44px !important;
                height: 44px !important;
                font-size: 18px !important;
                border-radius: 10px !important;
            }
            .qty-num {
                min-width: 32px;
                font-size: 16px;
                font-weight: 700;
            }

            .btn-checkout-go { font-size: 14px; padding: 12px; }
            .cart-summary { padding: 14px; }
            .restaurant-badge { font-size: 11px; padding: 3px 8px; }
        }
        /* ── Đồng bộ Home theme: border-radius + box-shadow cho Cart ── */
        .cart-wrapper .btn-checkout-go { border-radius: 12px; }
        .cart-wrapper .qty-btn { border-radius: 12px; }
        .cart-wrapper .cart-item img { border-radius: 12px; }
        .cart-wrapper .cart-summary { box-shadow: 0 4px 20px rgba(0,0,0,.07); }
        .cart-wrapper .cart-body { box-shadow: 0 4px 20px rgba(0,0,0,.07); }
        .cart-header { background: linear-gradient(135deg,#3CB815,#27a001); color:var(--fs-white); border-radius: var(--fs-radius, 12px) var(--fs-radius, 12px) 0 0; padding: 20px 28px; }
        .cart-header h3 { margin: 0; font-weight: 700; font-size: 20px; }
        .cart-body { background: var(--fs-white); border-radius: 0 0 16px 16px; box-shadow: 0 4px 20px rgba(0,0,0,.07); overflow: hidden; }
        .cart-item { display: flex; align-items: center; gap: 16px; padding: 18px 24px; border-bottom: 1px solid var(--fs-border-soft); transition: background .15s; }
        .cart-item:hover { background: #fafff9; }
        .cart-item:last-child { border-bottom: none; }
        .cart-item img { width: 80px; height: 80px; object-fit: cover; border-radius: 12px; flex-shrink: 0; border: 1px solid var(--fs-border); }
        .cart-item .item-info { flex: 1; }
        .cart-item .item-name { font-weight: 600; font-size: 15px; color: var(--fs-dark); }
        .cart-item .item-price { color: var(--fs-muted); font-size: 13px; margin-top: 2px; }
        .qty-control { display: flex; align-items: center; gap: 8px; }
        .qty-btn { width: 32px; height: 32px; border: 1.5px solid var(--fs-border); border-radius: 8px; background: var(--fs-white); cursor: pointer; font-size: 16px; font-weight: 600; display: flex; align-items: center; justify-content: center; transition: all .15s; color: var(--fs-body); }
        .qty-btn:hover { border-color: #3CB815; color: #3CB815; background: #f0fff0; }
        .qty-num { min-width: 36px; text-align: center; font-weight: 700; font-size: 16px; }
        .item-total { font-weight: 700; font-size: 15px; color: var(--fs-danger); min-width: 110px; text-align: right; }
        .delete-btn { color: var(--fs-muted-soft); cursor: pointer; padding: 6px; border-radius: 8px; transition: all .15s; border: none; background: none; }
        .delete-btn:hover { color: var(--fs-danger); background: #fff0f0; }
        .cart-summary { background: var(--fs-white); border-radius: var(--fs-radius, 12px); box-shadow: 0 4px 20px rgba(0,0,0,.07); padding: 24px; }
        .summary-row { display: flex; justify-content: space-between; padding: 8px 0; font-size: 14px; }
        .summary-total { display: flex; justify-content: space-between; padding-top: 12px; margin-top: 8px; border-top: 2px solid var(--fs-danger); font-size: 18px; font-weight: 700; color: var(--fs-danger); }
        .btn-checkout-go { display: block; width: 100%; padding: 14px; background: linear-gradient(135deg,#3CB815,#27a001); color:var(--fs-white); border: none; border-radius: var(--fs-radius, 12px); font-size: 15px; font-weight: 700; text-align: center; text-decoration: none; cursor: pointer; transition: opacity .2s; margin-top: 16px; }
        .btn-checkout-go:hover { opacity:.88; color:#fff; text-decoration:none; }
        .empty-cart { text-align: center; padding: 60px 24px; }
        .empty-cart svg { opacity: .25; margin-bottom: 16px; }
        .restaurant-badge { display: inline-flex; align-items: center; gap: 6px; background: #f0fff0; border: 1px solid #c3e6cb; color: var(--fs-success); padding: 4px 12px; border-radius: 20px; font-size: 13px; font-weight: 500; }
        /* ─── popIn animation cho confirm modal ─── */
        @@keyframes popIn { 0%{transform:scale(.8);opacity:0} 100%{transform:scale(1);opacity:1} }
    </style>
}

<div class="cart-wrapper">
    <div class="container">
        @if (TempData["CartError"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>@TempData["CartError"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (cart == null || cart.monAns.Count == 0)
        {
            <div class="cart-body" style="border-radius:16px;">
                <div class="empty-cart">
                    <svg width="80" height="80" viewBox="0 0 24 24" fill="none"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4zM3 6h18M16 10a4 4 0 01-8 0" stroke="#333" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <h4 style="color:var(--fs-muted);font-weight:600;">Giỏ hàng của bạn đang trống</h4>
                    <p style="color:var(--fs-muted-soft);font-size:14px;">Hãy chọn món ăn từ các quán yêu thích</p>
                    <a href="@Url.Action("Index","Home")" class="btn-checkout-go" style="display:inline-block;width:auto;padding:12px 32px;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" style="margin-right:6px;vertical-align:middle;"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" stroke="white" stroke-width="2"/><polyline points="9 22 9 12 15 12 15 22" stroke="white" stroke-width="2"/></svg>
                        Khám phá quán ăn
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="cart-header d-flex align-items-center justify-content-between">
                        <h3>
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" style="margin-right:8px;vertical-align:middle;"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4zM3 6h18" stroke="white" stroke-width="2" stroke-linecap="round"/></svg>
                            Giỏ hàng
                        </h3>
                        @if (cart.maquanan != null)
                        {
                            var quanAn = _db.tbQuanAn.Find(cart.maquanan);
                            if (quanAn != null)
                            {
                                <div class="restaurant-badge" style="background:rgba(255,255,255,.2);border-color:rgba(255,255,255,.4);color:var(--fs-white);">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 3a4 4 0 110 8 4 4 0 010-8zM23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75" stroke="white" stroke-width="2" stroke-linecap="round"/></svg>
                                    @quanAn.tenquanan
                                </div>
                            }
                        }
                    </div>
                    <div class="cart-body" id="cart-items-container">
                        @foreach (var i in cart.monAns)
                        {
                            <div class="cart-item" id="item-row-@i.mamon">
                                <img src="@TinhToan.HinhAnhUrl(i.hinhanh)" alt="@i.tenmon"
                                     onerror="this.src='/Source/Home/img/pizza.jpg'">
                                <div class="item-info">
                                    <div class="item-name">@i.tenmon</div>
                                    <div class="item-price">@i.giatien?.ToString("N0") đ / phần</div>
                                </div>
                                <div class="qty-control">
                                    <button class="qty-btn btn-giam" data-mamon="@i.mamon" title="Giảm">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><line x1="5" y1="12" x2="19" y2="12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
                                    </button>
                                    <span class="qty-num so-luong-@i.mamon">@i.soLuong</span>
                                    <button class="qty-btn btn-tang" data-mamon="@i.mamon" title="Tăng">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><line x1="12" y1="5" x2="12" y2="19" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><line x1="5" y1="12" x2="19" y2="12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
                                    </button>
                                </div>
                                <div class="item-total item-total-@i.mamon">@((i.giatien * i.soLuong)?.ToString("N0")) đ</div>
                                <button onclick="deleteCartItem(@i.mamon, this)" class="delete-btn" title="Xóa món" aria-label="Xóa món @i.tenmon khỏi giỏ hàng">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><polyline points="3 6 5 6 21 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6M10 11v6M14 11v6M9 6V4a1 1 0 011-1h4a1 1 0 011 1v2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                                </button>
                            </div>
                        }
                    </div>
                </div>

                <!-- ===== APRIORI: CÓ THỂ BẠN ĐÃ BỎ QUÊN ===== -->
                @{
                    var aprioriCart = ViewBag.AprioriCartSuggestions as List<ShipFood.Models.tbMonAn>;
                }
                @if (aprioriCart != null && aprioriCart.Any())
                {
                    <div class="col-lg-12 mb-4">
                        <div class="cart-summary">
                            <div style="font-size:15px;font-weight:700;margin-bottom:12px;display:flex;align-items:center;gap:8px;color:var(--fs-dark);">
                                <i class="fas fa-robot" style="font-size:20px;color:#f39c12;"></i>
                                Có thể bạn đã bỏ quên
                                <span style="font-size:10px;background:linear-gradient(135deg,#f39c12,#e67e22);color:var(--fs-white);padding:2px 8px;border-radius:4px;font-weight:600;">AI</span>
                            </div>
                            <p style="font-size:12px;color:var(--fs-muted);margin-bottom:12px;">Khách hàng thường đặt kèm những món này</p>
                            @foreach (var item in aprioriCart)
                            {
                                <div style="display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--fs-border-soft);">
                                    <img src="@TinhToan.HinhAnhUrl(item.hinhanh)" alt="@item.tenmon"
                                         style="width:48px;height:48px;border-radius:8px;object-fit:cover;border:1px solid var(--fs-border);"
                                         onerror="this.src='/Source/Home/img/pizza.jpg'" />
                                    <div style="flex:1;min-width:0;">
                                        <div style="font-weight:600;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@item.tenmon</div>
                                        <div style="font-size:11px;color:var(--fs-muted);">@item.tbQuanAn?.tenquanan</div>
                                        <div style="color:var(--fs-danger);font-weight:700;font-size:13px;">@item.giatien?.ToString("N0")đ</div>
                                    </div>
                                    <a href="@Url.Action("ThemMonAn","Cart",new { maMonAn = item.mamon, soLuong = 1 })"
                                       class="btn btn-sm"
                                       style="background:var(--fs-green);color:#fff;border-radius:8px;font-weight:600;font-size:12px;padding:6px 12px;white-space:nowrap;">
                                        + Thêm
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="col-lg-4">
                    <div class="cart-summary">
                        <div style="font-size:17px;font-weight:700;margin-bottom:16px;display:flex;align-items:center;gap:8px;">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" stroke="#3CB815" stroke-width="2" stroke-linecap="round"/></svg>
                            Tóm tắt đơn hàng
                        </div>
                        <div class="summary-row">
                            <span style="color:var(--fs-muted);">Tổng món ăn</span>
                            <span id="cart-total">@cart.tongTien?.ToString("N0") đ</span>
                        </div>
                        <div class="summary-row">
                            <span style="color:var(--fs-muted);">Phí giao hàng</span>
                            <span>15,000 đ</span>
                        </div>
                        <div class="summary-total">
                            <span>Tổng cộng</span>
                            <span id="cart-grandtotal">@((cart.tongTien + 15000)?.ToString("N0")) đ</span>
                        </div>
                        <!-- ─── MÃ GIẢM GIÁ GỢI Ý ─── -->
                        <div id="cart-coupon-suggestions" class="mt-3 pt-3" style="border-top:1px solid var(--fs-border-soft);">
                            <div style="font-size:12px;font-weight:600;color:var(--fs-green);margin-bottom:8px;">
                                <i class="fas fa-tag me-1"></i>Mã giảm giá gợi ý:
                            </div>
                            <div id="cart-coupon-list" class="d-flex flex-wrap gap-2">
                                <div style="color:var(--fs-muted-soft);font-size:12px;"><i class="fas fa-spinner fa-spin me-1"></i>Đang tải...</div>
                            </div>
                        </div>

                        <a href="@Url.Action("Checkout","Cart")" class="btn-checkout-go">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" style="margin-right:6px;vertical-align:middle;"><path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 001.95-1.57l1.65-7.43H6M10 21a1 1 0 110-2 1 1 0 010 2zM21 21a1 1 0 110-2 1 1 0 010 2z" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            Tiến hành thanh toán
                        </a>
                        <a href="@Url.Action("Index","Home")" style="display:block;text-align:center;color:var(--fs-muted);font-size:13px;margin-top:12px;text-decoration:none;">
                            ← Tiếp tục mua sắm
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section scripts {
<script>
        // ─── Show confirmation modal (thay confirm()) ───
    function showCartConfirm(msg, confirmUrl) {
        var overlay = $('<div class="cart-confirm-overlay" style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.55);z-index:99999;display:flex;align-items:center;justify-content:center;">');
        var box = $('<div style="background:#fff;border-radius:16px;max-width:400px;width:90%;padding:28px 24px;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,.2);animation:popIn .3s ease;">');
        box.append('<div style="width:56px;height:56px;background:#fff3e0;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 12px;"><i class="fas fa-exclamation-triangle" style="font-size:24px;color:#f39c12;"></i></div>');
        box.append('<h5 style="font-weight:700;margin-bottom:8px;">Xác nhận đổi quán</h5>');
        box.append('<p style="font-size:14px;color:#666;margin-bottom:20px;">' + msg + '</p>');
        var btnGroup = $('<div style="display:flex;gap:10px;">');
        btnGroup.append('<button class="btn btn-outline-secondary flex-fill" onclick="$(this).closest(\'.cart-confirm-overlay\').remove();" style="border-radius:10px;padding:10px;">Hủy</button>');
        btnGroup.append('<button class="btn btn-success flex-fill" onclick="window.location.href=\'' + confirmUrl + '\'" style="border-radius:10px;padding:10px;">Xóa & đặt mới</button>');
        box.append(btnGroup);
        overlay.append(box);
        overlay.click(function(e) { if(e.target===this) $(this).remove(); });
        $('body').append(overlay);
    }

    // ─── Show toast notification (dùng chung) ───
    function showCartToast(type, msg) {
        var color = type === 'error' ? '#dc3545' : '#28a745';
        var icon = type === 'error' ? 'fas fa-exclamation-circle' : 'fas fa-check-circle';
        var toast = $('<div style="position:fixed;top:24px;right:24px;z-index:99999;background:' + color + ';color:#fff;padding:14px 20px;border-radius:10px;box-shadow:0 4px 20px rgba(0,0,0,.2);font-size:14px;max-width:360px;"><i class="' + icon + ' me-2"></i>' + msg + '</div>');
        $('body').append(toast);
        setTimeout(function(){ toast.fadeOut(400, function(){ $(this).remove(); }); }, 3500);
    }

    $(document).ready(function () {
    // API JSON endpoints - tr? v? JSON thay vì parse HTML
    var tangApiUrl = '@Url.Action("ApiTangSoLuong","Cart")';
    var giamApiUrl = '@Url.Action("ApiGiamSoLuong","Cart")';
    var urlGetTopCoupons = '@Url.Action("GetTopCoupons","Cart")';

    // ─── Tải mã giảm giá gợi ý ───
    $.getJSON(urlGetTopCoupons, function(res) {
        var $list = $('#cart-coupon-list');
        $list.empty();
        if (res.success && res.coupons && res.coupons.length > 0) {
            res.coupons.forEach(function(c, idx) {
                var isFirst = idx === 0;
                var badge = $('<div style="cursor:pointer;padding:6px 12px;border-radius:8px;font-size:12px;font-weight:600;transition:all .2s;"></div>');
                badge.css({
                    background: isFirst ? 'var(--fs-green)' : 'var(--fs-white)',
                    color: isFirst ? 'var(--fs-white)' : 'var(--fs-body)',
                    border: isFirst ? '1.5px solid var(--fs-green)' : '1.5px solid var(--fs-border)'
                });
                badge.html((isFirst ? '<i class="fas fa-fire" style="margin-right:2px;"></i> ' : '') + c.tenkm + ' <span style="font-weight:400;opacity:.85">(-' + c.phantramgiam + '%)</span>');
                badge.hover(
                    function(){ $(this).css('opacity','.85'); },
                    function(){ $(this).css('opacity','1'); }
                );
                badge.click(function() {
                    window.location.href = '@Url.Action("Checkout","Cart")';
                });
                $list.append(badge);
            });
        } else {
            $list.html('<div style="color:var(--fs-muted-soft);font-size:12px;">Chưa có mã giảm giá khả dụng</div>');
        }
    }).fail(function() {
        $('#cart-coupon-list').html('<div style="color:var(--fs-muted-soft);font-size:12px;">Không tải được mã giảm giá</div>');
    });

    // ─── Xóa món bằng AJAX ───
    window.deleteCartItem = function(maMonAn, btn) {
        if (!confirm('Xóa món này khỏi giỏ hàng?')) return;
        var $row = $(btn).closest('.cart-item');
        var apiUrl = '@Url.Action("ApiXoaMon","Cart")?maMonAn=' + maMonAn;
        $.getJSON(apiUrl, function(res) {
            if (res.success) {
                $row.fadeOut(300, function() { 
                    $(this).remove(); 
                    var remaining = $('.cart-item').length;
                    if (remaining === 0) {
                        location.reload();
                    } else {
                        // Cập nhật badge giỏ hàng nếu còn item
                        var badge = document.getElementById('navCartBadge');
                        if (badge) {
                            var cartResponse = res;
                            if (cartResponse.isEmpty) {
                                badge.textContent = '';
                                badge.style.display = 'none';
                            }
                        }
                    }
                });
                $('#cart-total').text(res.cartTotal);
                $('#cart-grandtotal').text(res.cartGrandTotal);
            } else {
                alert(res.message || 'Lỗi xóa món');
            }
        }).fail(function() { 
            alert('Lỗi kết nối. Vui lòng thử lại.');
            $row.css('opacity', '1');
        });
    };

    $(document).on('click', '.btn-tang, .btn-giam', function(e) {
        e.preventDefault();
        var $btn = $(this);
        var maMonAn = $btn.data('mamon');
        var isTang = $btn.hasClass('btn-tang');
        var url = isTang ? tangApiUrl + '?maMonAn=' + maMonAn + '&soLuong=1' : giamApiUrl + '?maMonAn=' + maMonAn;

        $btn.prop('disabled', true);
        $.getJSON(url, function(res) {
            if (res.success) {
                // C?p nh?t s? lu?ng
                $('.so-luong-' + maMonAn).text(res.soLuong);
                // C?p nh?t giá t?ng món
                $('.item-total-' + maMonAn).text(res.itemTotal);
                // C?p nh?t t?ng ti?n gi? hàng
                $('#cart-total').text(res.cartTotal);
                $('#cart-grandtotal').text(res.cartGrandTotal);
            }
        }).always(function(){ $btn.prop('disabled', false); });
    });

    // ─── XỬ LÝ XUNG ĐỘT QUÁN (Multi-restaurant) ───
    @if (TempData["CartConflict"] as string == "true")
    {
        <text>
        var conflictNewMonId = @(TempData["ConflictNewMonId"] ?? "0");
var conflictNewSoLuong = @(TempData["ConflictNewSoLuong"] ?? "1");
        var conflictUrl = '@Url.Action("ApiForceSwitchRestaurant", "Cart")';

                if (confirm('Giỏ hàng của bạn đã có món ăn thuộc quán khác. Bạn có muốn xóa giỏ hàng cũ để bắt đầu đặt món tại quán mới này không?')) {
            window.location.href = conflictUrl + '?maMonAn=' + conflictNewMonId + '&soLuong=' + conflictNewSoLuong;
        }
        </text>
    }

    // ─── AJAX INTERCEPT: Chuyển form "Thêm" sang AJAX ───
    $(document).on('submit', 'form[action*="Cart/ThemMonAn"]', function(e) {
        e.preventDefault();
        var $form = $(this);
        var maMonAn = $form.find('input[name="maMonAn"]').val();
        var soLuong = $form.find('input[name="soLuong"]').val();
        if (!maMonAn || !soLuong || parseInt(soLuong) <= 0) return;

        var apiUrl = '@Url.Action("ApiThemMonAn", "Cart")' + '?maMonAn=' + maMonAn + '&soLuong=' + soLuong;
        $.getJSON(apiUrl, function(res) {
            if (res.success && !res.conflict) {
                // Thêm thành công → redirect đến giỏ hàng
                if (res.redirect) window.location.href = res.redirect;
            } else if (res.conflict) {
                // Xung đột quán → hỏi người dùng
                if (confirm('Giỏ hàng của bạn đã có món từ "' + res.currentRestaurant + '". Bạn có muốn xóa giỏ hàng cũ để đặt món từ "' + res.newRestaurant + '" không?')) {
                    var forceUrl = '@Url.Action("ApiForceSwitchRestaurant", "Cart")' + '?maMonAn=' + res.maMonAn + '&soLuong=' + res.soLuong;
                    window.location.href = forceUrl;
                }
            } else {
                showCartToast('error', res.message || 'Lỗi khi thêm món vào giỏ hàng');
            }
        }).fail(function() {
            showCartToast('error', 'Lỗi kết nối. Vui lòng thử lại.');
        });
    });
});
</script>
}
