
@inject ShipFood.Models.dbFoodyEntities _db
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutPageRestaurant.cshtml";
    var userJson = Context.Session.GetString("user");
    ShipFood.Models.tbUser? currentUser = userJson != null ? JsonSerializer.Deserialize<tbUser>(userJson) : null;
    ShipFood.Models.tbQuanAn? QuanAn = currentUser != null ? _db.tbQuanAn.Find(currentUser.userid) : null;
}

<style>
    .apriori-insight-card {
        background:#f8f9fa;border-radius:12px;padding:14px 16px;
        border:1px solid #f0f0f0;transition:all .2s;
    }
    .apriori-insight-card:hover {
        border-color:#3CB815;box-shadow:0 4px 16px rgba(60,184,21,.12);
    }
</style>
<div class="container-fluid">
    <div class="form-head d-flex mb-3 align-items-start">
        <div class="me-auto d-none d-lg-block">
            <h2 class="text-black font-w600 mb-0">Thống kê</h2>
            <p class="mb-0">Xin chào quản lí @(QuanAn?.tenquanan ?? "")</p>
        </div>
        <span class="badge bg-light text-muted" id="lastUpdatedBadge" style="font-weight:400;font-size:11px;height:fit-content;">
            <i class="far fa-clock" aria-hidden="true"></i> Cập nhật lúc: --:--
        </span>
    </div>

    <!-- KPI Cards -->
    <div class="row mb-4">
        <div class="col-xl-3 col-sm-6">
            <div class="card" style="border:none;border-radius:12px;box-shadow:0 2px 12px rgba(0,0,0,.06);">
                <div class="card-body d-flex align-items-center">
                    <div style="width:50px;height:50px;border-radius:12px;background:rgba(60,184,21,.12);display:flex;align-items:center;justify-content:center;margin-right:14px;">
                        <i class="fas fa-utensils" style="font-size:20px;color:#3CB815;"></i>
                    </div>
                    <div>
                        <h4 style="margin:0;font-size:22px;font-weight:700;">@(ViewBag.soLuongMonAn ?? 0)</h4>
                        <span style="font-size:12px;color:#888;">Món ăn</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6">
            <div class="card" style="border:none;border-radius:12px;box-shadow:0 2px 12px rgba(0,0,0,.06);">
                <div class="card-body d-flex align-items-center">
                    <div style="width:50px;height:50px;border-radius:12px;background:rgba(246,80,5,.12);display:flex;align-items:center;justify-content:center;margin-right:14px;">
                        <i class="fas fa-money-bill-wave" style="font-size:20px;color:#F65005;"></i>
                    </div>
                    <div>
                        <h4 style="margin:0;font-size:22px;font-weight:700;">@(ViewBag.tongDoanhThu != null ? string.Format("{0:N0}", ViewBag.tongDoanhThu) : "0") <small style="font-size:12px;font-weight:400;">VNĐ</small></h4>
                        <span style="font-size:12px;color:#888;">Doanh thu</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6">
            <div class="card" style="border:none;border-radius:12px;box-shadow:0 2px 12px rgba(0,0,0,.06);">
                <div class="card-body d-flex align-items-center">
                    <div style="width:50px;height:50px;border-radius:12px;background:rgba(52,152,219,.12);display:flex;align-items:center;justify-content:center;margin-right:14px;">
                        <i class="fas fa-clipboard-list" style="font-size:20px;color:#3498db;"></i>
                    </div>
                    <div>
                        <h4 style="margin:0;font-size:22px;font-weight:700;">@(ViewBag.soDonDatHang ?? 0)</h4>
                        <span style="font-size:12px;color:#888;">Đơn hàng</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6">
            <div class="card" style="border:none;border-radius:12px;box-shadow:0 2px 12px rgba(0,0,0,.06);">
                <div class="card-body d-flex align-items-center">
                    <div style="width:50px;height:50px;border-radius:12px;background:rgba(155,89,182,.12);display:flex;align-items:center;justify-content:center;margin-right:14px;">
                        <i class="fas fa-users" style="font-size:20px;color:#9b59b6;"></i>
                    </div>
                    <div>
                        <h4 style="margin:0;font-size:22px;font-weight:700;">@(ViewBag.soLuongKhachHang ?? 0)</h4>
                        <span style="font-size:12px;color:#888;">Khách hàng</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Order Status Summary -->
    <div class="row mb-4">
        <div class="col-xl-4 col-sm-6">
            <div class="card" style="border:none;border-radius:12px;box-shadow:0 2px 12px rgba(0,0,0,.06);">
                <div class="card-body text-center">
                    <i class="fas fa-fire" style="font-size:28px;color:#e67e22;"></i>
                    <h3 style="margin:8px 0 4px;font-weight:700;">@(ViewBag.dhChuanBi ?? 0)</h3>
                    <span style="font-size:13px;color:#888;">Đang chuẩn bị</span>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-sm-6">
            <div class="card" style="border:none;border-radius:12px;box-shadow:0 2px 12px rgba(0,0,0,.06);">
                <div class="card-body text-center">
                    <i class="fas fa-check-circle" style="font-size:28px;color:#3CB815;"></i>
                    <h3 style="margin:8px 0 4px;font-weight:700;">@(ViewBag.dhHoanThanh ?? 0)</h3>
                    <span style="font-size:13px;color:#888;">Hoàn thành</span>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-sm-12">
            <div class="card" style="border:none;border-radius:12px;box-shadow:0 2px 12px rgba(0,0,0,.06);">
                <div class="card-body text-center">
                    <i class="fas fa-times-circle" style="font-size:28px;color:#e74c3c;"></i>
                    <h3 style="margin:8px 0 4px;font-weight:700;">@(ViewBag.dhHuy ?? 0)</h3>
                    <span style="font-size:13px;color:#888;">Đã huỷ</span>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== APRIORI: GỢI Ý BÁN CHÉO THÔNG MINH ===== -->
    @{
        var aprioriInsights = ViewBag.AprioriInsights as List<object>;
    }
    @if (aprioriInsights != null && aprioriInsights.Any())
    {
        <div class="row">
            <div class="col-12 mb-4">
                <div class="card" style="border:none;border-radius:14px;box-shadow:0 4px 20px rgba(0,0,0,.07);overflow:hidden;">
                    <div class="card-header" style="background:linear-gradient(135deg,#3CB815,#27a001);color:#fff;padding:16px 24px;">
                        <div style="display:flex;align-items:center;gap:10px;">
                            <span style="font-size:24px;"><i class="fas fa-robot"></i></span>
                            <div>
                                <h4 style="margin:0;font-weight:700;font-size:16px;">Chiến lược bán chéo từ dữ liệu</h4>
                                <p style="margin:2px 0 0;font-size:12px;opacity:.85;">Phân tích Apriori trên @ViewBag.dhHoanThanh đơn hàng hoàn thành</p>
                            </div>
                            <span style="margin-left:auto;font-size:10px;background:rgba(255,255,255,.2);padding:3px 10px;border-radius:20px;font-weight:600;">AI</span>
                        </div>
                    </div>
                    <div class="card-body" style="padding:20px 24px;">
                        <p style="font-size:13px;color:#888;margin-bottom:16px;">
                            <i class="fas fa-lightbulb text-warning me-1"></i>
                            Những cặp món sau thường được khách đặt cùng nhau. Hãy tạo <strong>Combo khuyến mãi</strong> cho các cặp này để tăng doanh thu!
                        </p>
                        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px;">
                            @foreach (var insight in aprioriInsights)
                            {
                                var i = insight as dynamic;
                                <div class="apriori-insight-card">
                                    <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
                                        <span style="font-weight:700;font-size:15px;">@i.TenMonA</span>
                                        <span style="color:#3CB815;font-weight:700;">+</span>
                                        <span style="font-weight:700;font-size:15px;">@i.TenMonB</span>
                                    </div>
                                    <div style="display:flex;gap:16px;font-size:12px;color:#666;">
                                        <span><strong style="color:#e74c3c;">@i.ConfidenceAtoB%</strong> khách mua @i.TenMonA cũng mua @i.TenMonB</span>
                                    </div>
                                    <div style="display:flex;gap:16px;font-size:11px;color:#999;margin-top:4px;">
                                        <span>Support <strong>@i.Support%</strong></span>
                                        <span>@i.PairCount đơn</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section scripts {
    <!-- ═══ SIGNALR: Lắng nghe kpiRefresh từ server ═══ -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
    (function() {
        function updateLastUpdated() {
            var now = new Date();
            var badge = document.getElementById('lastUpdatedBadge');
            if (badge) badge.innerHTML = '<i class="far fa-clock" aria-hidden="true"></i> Cập nhật lúc: '
                + String(now.getHours()).padStart(2,'0') + ':' + String(now.getMinutes()).padStart(2,'0') + ':' + String(now.getSeconds()).padStart(2,'0');
        }
        updateLastUpdated();

        try {
            var conn = new signalR.HubConnectionBuilder()
                .withUrl('/nhantin')
                .withAutomaticReconnect()
                .build();

            conn.on('kpiRefresh', function() {
                console.log('🔄 Restaurant KPI refresh via SignalR');
                location.reload();
            });

            conn.start().then(function() {
                conn.invoke('JoinRestaurantGroup', @(QuanAn?.userid ?? 0)).catch(function(){});
                console.log('✅ Restaurant SignalR connected');
            }).catch(function(err) {
                console.warn('⚠️ Restaurant SignalR:', err.message);
            });
        } catch (e) {
            console.warn('⚠️ SignalR init failed:', e.message);
        }
    })();
    </script>
}