@using ShipFood.Models
@inject ShipFood.Models.dbFoodyEntities _db

@{
    ViewBag.Title = "Fastship — Đặt món, giao tận nơi tại TP.HCM";
    Layout = "~/Views/Shared/_LayoutPageHome.cshtml";
    List<tbQuanAn> quanAns = ViewBag.quanAns;
    var idDMActive = ViewBag.idDM as int?;

    // Get current user for personalization
    var userJson = Context.Session.GetString("user");
    var currentUser = userJson != null ? System.Text.Json.JsonSerializer.Deserialize<tbUser>(userJson) : null;
}

<!-- ===== PROMO BAND ===== -->
<div class="fs-promo-band position-relative" id="promoBand" role="banner" aria-label="Ưu đãi đặc biệt">
    <i class="fa fa-tag me-1" aria-hidden="true"></i>
    Mùa hè đặc biệt — Giảm 20% cho đơn đầu tiên trong ngày!&nbsp;
    <a href="/Home/DanhMuc">Khám phá ngay <i class="fa fa-arrow-right ms-1"></i></a>
    <button class="fs-promo-dismiss" id="promoDismissBtn" aria-label="Đóng thông báo">
        <i class="fa fa-times" aria-hidden="true"></i>
    </button>
</div>

<!-- ===== HERO CAROUSEL ===== -->
<div class="container-fluid p-0 wow fadeIn" data-wow-delay="0.1s">
    <div id="header-carousel" class="carousel slide">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img class="w-100" src="~/Source/Home/img/banner-1.jpg" alt="Khám phá ẩm thực Sài Gòn cùng Fastship" />
                <div class="carousel-caption">
                    <div class="container">
                        <div class="row justify-content-start">
                            <div class="col-lg-7 col-11">
                                <h1 class="display-2 mb-4 animated fw-800">
                                    Ẩm thực Sài Gòn — giao tận cửa trong 30 phút
                                </h1>
                                <div class="animated">
                                    <a href="/Home/DanhMuc?type=food" class="btn btn-primary rounded-pill py-2 py-sm-3 px-4 px-sm-5 me-2 mb-2">
                                        <i class="fa fa-utensils me-1"></i> Đồ ăn
                                    </a>
                                    <a href="/Home/DanhMuc?type=drink" class="btn btn-secondary rounded-pill py-2 py-sm-3 px-4 px-sm-5 mb-2">
                                        <i class="fa fa-coffee me-1"></i> Đồ uống
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="carousel-item">
                <img class="w-100" src="~/Source/Home/img/banner-2.jpg" alt="Hàng trăm quán ăn ngon tại TP.HCM" />
                <div class="carousel-caption">
                    <div class="container">
                        <div class="row justify-content-start">
                            <div class="col-lg-7 col-11">
                                <h1 class="display-2 mb-4 animated fw-800">
                                    Hơn 200 quán ăn ngon — đặt trong 1 phút
                                </h1>
                                <div class="animated">
                                    <a href="/Home" class="btn btn-primary rounded-pill py-2 py-sm-3 px-4 px-sm-5 me-2 mb-2">Đặt ngay</a>
                                    <a href="/Home/About" class="btn btn-outline-light rounded-pill py-2 py-sm-3 px-4 px-sm-5 mb-2">Tìm hiểu thêm</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#header-carousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Trước</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#header-carousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Tiếp</span>
        </button>
        <!-- Carousel indicators (dots) — visible on mobile only -->
        <div class="carousel-indicators d-sm-none">
            <button type="button" data-bs-target="#header-carousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#header-carousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
        </div>
    </div>
</div>

<!-- ===== STATS ROW — dữ liệu THẬT từ DB ===== -->
<div class="container">
    <div class="fs-stats-row wow fadeInUp" data-wow-delay="0.1s">
        <div class="fs-stat-item fs-reveal">
            <i class="fa fa-store fs-stat-icon" aria-hidden="true"></i>
            <div class="stat-num"><span class="fs-counter" data-count="@(ViewBag.TotalRestaurants ?? 0)">0</span>+</div>
            <div class="stat-label">Quán ăn đối tác</div>
        </div>
        <div class="fs-stat-item fs-reveal" style="--fs-i:1">
            <i class="fa fa-motorcycle fs-stat-icon" aria-hidden="true"></i>
            <div class="stat-num">30′</div>
            <div class="stat-label">Giao hàng trung bình</div>
        </div>
        <div class="fs-stat-item fs-reveal" style="--fs-i:2">
            <i class="fa fa-shopping-bag fs-stat-icon" aria-hidden="true"></i>
            <div class="stat-num"><span class="fs-counter" data-count="@(ViewBag.MonthlyOrders ?? 0)">0</span>+</div>
            <div class="stat-label">Đơn hàng trong tháng</div>
        </div>
        <div class="fs-stat-item fs-reveal" style="--fs-i:3">
            <i class="fa fa-star fs-stat-icon" aria-hidden="true"></i>
            <div class="stat-num">@((ViewBag.AvgRating ?? 0).ToString("0.0"))★</div>
            <div class="stat-label">Đánh giá trung bình</div>
        </div>
    </div>
</div>

<!-- ===== RE-ORDER SECTION (chỉ cho user đã login) ===== -->
@if (currentUser != null)
{
    <div class="container">
        <div class="fs-reorder-section wow fadeInUp" data-wow-delay="0.1s">
            <div class="row align-items-center mb-3">
                <div class="col">
                    <h3><i class="fa fa-history me-2" style="color:var(--fs-green);"></i>Chào mừng trở lại, @currentUser.username!</h3>
                    <p>Đặt lại món yêu thích của bạn chỉ với một chạm.</p>
                </div>
                <div class="col-auto">
                    <a href="/Cart/LichSuDatHang" class="btn btn-outline-success rounded-pill fs-btn-outline-sm px-4 py-2">
                        Lịch sử đơn hàng <i class="fa fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
            <div class="row g-2">
                <div class="col-6 col-md-3">
                    <a href="/Cart/LichSuDatHang" class="fs-reorder-item">
                        <div class="reorder-img d-flex align-items-center justify-content-center" style="background:#e8f5e9;font-size:20px;color:var(--fs-green);">
                            <i class="fa fa-redo"></i>
                        </div>
                        <div class="reorder-info">
                            <div class="reorder-name">Xem đơn gần nhất</div>
                            <div class="reorder-restaurant">Đặt lại dễ dàng</div>
                        </div>
                        <span class="reorder-btn"><i class="fa fa-chevron-right"></i></span>
                    </a>
                </div>
                <div class="col-6 col-md-3">
                    <a href="/Home/DanhMuc" class="fs-reorder-item">
                        <div class="reorder-img d-flex align-items-center justify-content-center" style="background:#fff3e0;font-size:20px;color:#e67e22;">
                            <i class="fa fa-compass"></i>
                        </div>
                        <div class="reorder-info">
                            <div class="reorder-name">Khám phá món mới</div>
                            <div class="reorder-restaurant">Gợi ý từ AI</div>
                        </div>
                        <span class="reorder-btn"><i class="fa fa-chevron-right"></i></span>
                    </a>
                </div>
                <div class="col-6 col-md-3">
                    <a href="/Cart" class="fs-reorder-item">
                        <div class="reorder-img d-flex align-items-center justify-content-center" style="background:#fce4ec;font-size:20px;color:#e74c3c;">
                            <i class="fa fa-shopping-bag"></i>
                        </div>
                        <div class="reorder-info">
                            <div class="reorder-name">Giỏ hàng</div>
                            <div class="reorder-restaurant">Tiếp tục đặt món</div>
                        </div>
                        <span class="reorder-btn"><i class="fa fa-chevron-right"></i></span>
                    </a>
                </div>
                <div class="col-6 col-md-3">
                    <a href="/Cart/LichSuDatHang" class="fs-reorder-item">
                        <div class="reorder-img d-flex align-items-center justify-content-center" style="background:#e3f2fd;font-size:20px;color:#1976d2;">
                            <i class="fa fa-clock"></i>
                        </div>
                        <div class="reorder-info">
                            <div class="reorder-name">Lịch sử</div>
                            <div class="reorder-restaurant">Theo dõi đơn hàng</div>
                        </div>
                        <span class="reorder-btn"><i class="fa fa-chevron-right"></i></span>
                    </a>
                </div>
            </div>
        </div>
    </div>
}

<!-- ===== RESTAURANT LIST SECTION ===== -->
<div class="container-xxl py-4 pb-5">
    <div class="container">
        <!-- Section header — dùng class thay inline style -->
        <div class="row align-items-end mb-4 fs-reveal">
            <div class="col">
                <h2 class="fs-section-title">
                    Quán ăn nổi bật tại TP.HCM
                </h2>
                <p class="fs-section-sub">
                    Khám phá văn hoá ẩm thực Sài Gòn — hàng trăm hương vị, giao tận nơi
                </p>
            </div>
            <div class="col-auto d-none d-md-block">
                <a href="/Home/DanhMuc" class="btn btn-outline-success fs-btn-outline-sm px-4">
                    Xem tất cả <i class="fa fa-arrow-right ms-1"></i>
                </a>
            </div>
        </div>

        <!-- ===== DUAL-FILTER BAR: FILTERBAR VIEWCOMPONENT ===== -->
        @await Component.InvokeAsync("FilterBar", new {
            categoryId = ViewBag.idDM,
            q = ViewBag.txtSearch
        })

        <!-- ===== SEARCH RESULTS CONTAINER (cho filter AJAX) ===== -->
        <div id="searchResults"></div>

        <!-- Category filter pills — 🍽 → FA icon -->
        <!-- ponytail: class "wow" gây ẩn element khi wow.js chưa init → thêm fallback visible -->
        <div class="fs-category-row" id="categoryRow" style="opacity:1!important;visibility:visible!important;">
            <a href="/Home" class="fs-category-pill @(idDMActive == null ? "active" : "")">
                <i class="fa fa-th-list me-1"></i> Tất cả
            </a>
            @{
                foreach (var dm in _db.tbDanhMuc)
                {
                    var isActive = idDMActive.HasValue && idDMActive.Value == dm.madanhmuc;
                    <a href="/Home?idDM=@dm.madanhmuc" class="fs-category-pill @(isActive ? "active" : "")">
                        @dm.tendanhmuc
                    </a>
                }
            }
        </div>

        <!-- Cards grid + social proof badges -->
        <div class="row g-3 g-md-4 mt-1">
            @if (quanAns != null && quanAns.Count > 0)
            {
                int cardIdx = 0;
                foreach (var item in quanAns)
                {
                    cardIdx++;
                    <div class="col-xl-3 col-lg-4 col-6 fs-reveal" style="--fs-i:@cardIdx">
                        <a href="@Url.Action("DetailRestaurant","Home", new { id = item.userid })" class="text-decoration-none" aria-label="Xem chi tiết @item.tenquanan">
                            <div class="product-item">
                                <div class="product-img-wrap">
                                    <img src="@TinhToan.HinhAnhUrl(item.hinhanh)" alt="@item.tenquanan" loading="lazy" />
                                    <!-- Social proof: "Đang thịnh hành" badge -->
                                    <div class="fs-order-count-badge">
                                        <span class="fs-trending-dot"></span>
                                        Đang thịnh hành
                                    </div>
                                </div>
                                <div class="product-body">
                                    <div class="product-title">@item.tenquanan</div>
                                    <div class="product-address">
                                        <i class="fa fa-map-marker-alt me-1 text-green" style="font-size:11px;"></i>@item.diachi
                                    </div>
                                </div>
                                <div class="product-footer">
                                    <div class="pf-cell">
                                        <i class="fa fa-star"></i>@item.diemdanhgia
                                    </div>
                                    <div class="pf-cell">
                                        <i class="fa fa-comment-alt text-muted"></i>&nbsp;@item.soluotdanhgia bình luận
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <div style="font-size:48px;"><i class="fa fa-utensils" aria-hidden="true"></i></div>
                    <h5 class="mt-3 text-muted">Không tìm thấy quán ăn phù hợp</h5>
                    <p class="text-muted small">Thử tìm kiếm với từ khoá khác hoặc chọn danh mục khác.</p>
                    <a href="/Home" class="btn btn-success rounded-pill px-4 mt-2">Xem tất cả quán</a>
                </div>
            }
                                </div>
                            </div>
                        </a>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <div style="font-size:48px;"><i class="fa fa-utensils" aria-hidden="true"></i></div>
                    <h5 class="mt-3 text-muted">Không tìm thấy quán ăn phù hợp</h5>
                    <p class="text-muted small">Thử tìm kiếm với từ khoá khác hoặc chọn danh mục khác.</p>
                    <a href="/Home" class="btn btn-success rounded-pill px-4 mt-2">Xem tất cả quán</a>
                </div>
            }
        </div>

        <!-- Mobile: Xem tất cả button -->
        <div class="text-center mt-4 d-md-none">
            <a href="/Home/DanhMuc" class="btn btn-outline-success rounded-pill px-5 fs-btn-outline-sm">
                Xem tất cả quán <i class="fa fa-arrow-right ms-1"></i>
            </a>
        </div>
    </div>
</div>

<!-- ===== APRIORI: GỢI Ý COMBO TỪ AI HÔM NAY ===== -->
@{
    var aprioriCombo = ViewBag.AprioriCombo as List<ShipFood.Models.tbMonAn>;
}
@if (aprioriCombo != null && aprioriCombo.Any())
{
    <div class="container-xxl py-4">
        <div class="container">
            <div class="row align-items-end mb-4 fs-reveal">
                <div class="col">
                    <h2 class="fs-section-title-sm">
                        <i class="fa fa-robot me-2" style="color:#f39c12;"></i>Gợi ý Combo từ AI hôm nay
                    </h2>
                    <p class="fs-section-sub-sm">
                        Dựa trên phân tích <strong>hàng ngàn đơn hàng</strong> thực tế — những món thường được đặt cùng nhau
                    </p>
                </div>
            </div>
            <div class="row g-3">
                @{ int aiIdx = 0; }
                @foreach (var item in aprioriCombo)
                {
                    aiIdx++;
                    <div class="col-xl-2 col-lg-3 col-md-4 col-6 fs-reveal" style="--fs-i:@aiIdx">
                        <a href="@Url.Action("DetailRestaurant","Home", new { id = item.maquanan })" class="text-decoration-none">
                            <div class="product-item">
                                <div class="product-img-wrap">
                                    <img src="@TinhToan.HinhAnhUrl(item.hinhanh)" alt="@item.tenmon" loading="lazy" />
                                    <div class="fs-ai-badge">
                                        <i class="fa fa-robot"></i> AI
                                    </div>
                                </div>
                                <div class="product-body-compact">
                                    <div class="product-title">@item.tenmon</div>
                                    <div class="product-address">
                                        <i class="fa fa-map-marker-alt me-1 text-green"></i>@item.tbQuanAn?.tenquanan
                                    </div>
                                    <div class="fs-price">Giá từ: @item.tbBienTheMonAns?.Min(b => b.giatien)?.ToString("N0")đ</div>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
}

<!-- ===== HIGHLIGHT BAND — FA icons thay emoji ===== -->
<div class="fs-highlight-band fs-reveal">
    <div class="container">
        <div class="row align-items-center gy-4">
            <div class="col-lg-7">
                <span class="fs-section-badge">MÙA HÈ SÀI GÒN 2026</span>
                <h2 class="text-white mb-3">Hôm nay có gì ngon?<br>Đặt ngay — giao nhanh.</h2>
                <p>Từ cơm tấm Sài Gòn đến trà sữa Quận 1, Fastship đưa hương vị thành phố đến tận bàn của bạn.</p>
                <a href="/Home/DanhMuc" class="btn btn-outline-light rounded-pill px-5 py-2 mt-2">Khám phá thực đơn <i class="fa fa-arrow-right ms-1"></i></a>
            </div>
            <div class="col-lg-5 text-center d-none d-lg-block">
                <!-- Visual accent grid — FA icons thay emoji -->
                <div class="fs-highlight-grid">
                    <div class="fs-highlight-grid-item">
                        <i class="fa fa-utensils hg-icon"></i>
                        <div class="hg-label">Cơm - Bún - Phở</div>
                    </div>
                    <div class="fs-highlight-grid-item">
                        <i class="fa fa-coffee hg-icon"></i>
                        <div class="hg-label">Trà - Cà phê</div>
                    </div>
                    <div class="fs-highlight-grid-item">
                        <i class="fa fa-briefcase hg-icon"></i>
                        <div class="hg-label">Cơm văn phòng</div>
                    </div>
                    <div class="fs-highlight-grid-item highlight-green">
                        <i class="fa fa-motorcycle hg-icon" style="color:#fff;"></i>
                        <div class="hg-label">Giao nhanh 30′</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ===== HOW IT WORKS — value proposition improved ===== -->
<div class="fs-how-section">
    <div class="container">
        <div class="text-center mb-5 fs-reveal">
            <h2 class="fs-section-title">Đặt món dễ như thế này</h2>
            <p class="fs-section-sub">Ba bước đơn giản để có bữa ăn ngon tại nhà</p>
        </div>
        <div class="row gy-4 justify-content-center">
            <div class="col-lg-3 col-md-4 col-sm-6 fs-reveal" style="--fs-i:1">
                <div class="fs-how-card">
                    <div class="fs-how-icon"><i class="fa fa-search"></i></div>
                    <h5>1. Chọn quán</h5>
                    <p class="fs-how-value">
                        Duyệt <span class="fs-how-highlight">hàng trăm quán ăn</span> tại TP.HCM,
                        lọc theo danh mục hoặc tìm theo tên.
                    </p>
                </div>
            </div>
            <div class="col-lg-3 col-md-4 col-sm-6 fs-reveal" style="--fs-i:2">
                <div class="fs-how-card">
                    <div class="fs-how-icon"><i class="fa fa-shopping-bag"></i></div>
                    <h5>2. Thêm vào giỏ</h5>
                    <p class="fs-how-value">
                        Chọn món bạn thích, điều chỉnh số lượng và
                        <span class="fs-how-highlight">áp dụng mã KM</span>.
                    </p>
                </div>
            </div>
            <div class="col-lg-3 col-md-4 col-sm-6 fs-reveal" style="--fs-i:3">
                <div class="fs-how-card">
                    <div class="fs-how-icon"><i class="fa fa-motorcycle"></i></div>
                    <h5>3. Nhận hàng</h5>
                    <p class="fs-how-value">
                        Shipper giao đến tận tay trong
                        <span class="fs-how-highlight">30 phút</span>.
                        Thanh toán tiền mặt hoặc chuyển khoản.
                    </p>
                </div>
            </div>
        </div>
        <div class="text-center mt-4">
            <a href="/Home/Signup" class="btn btn-success rounded-pill px-5 py-2 fs-btn-outline" style="font-size:15px;">
                Đăng ký miễn phí <i class="fa fa-arrow-right ms-1"></i>
            </a>
        </div>
    </div>
</div>

@section scripts {
<script>
    // Header scroll shadow (subtle, trước khi nav fixed)
    window.addEventListener('scroll', function () {
        var h = document.getElementById('fsHeader');
        if (h) h.classList.toggle('scrolled', window.scrollY > 10);
    });

    // Promo band dismiss — fade-out animation thay vì đột ngột biến mất
    document.addEventListener('DOMContentLoaded', function() {
        var dismissBtn = document.getElementById('promoDismissBtn');
        var promoBand = document.getElementById('promoBand');
        if (dismissBtn && promoBand) {
            dismissBtn.addEventListener('click', function() {
                promoBand.classList.add('fade-out');
                setTimeout(function() { promoBand.style.display = 'none'; }, 300);
            });
        }
    });
</script>
}
