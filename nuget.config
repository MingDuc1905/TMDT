<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!-- globalPackagesFolder removed: /root/.nuget/packages gây lỗi CI/CD do 
       không có quyền ghi trên GitHub Actions runner (user runner ≠ root) -->
</configuration>
