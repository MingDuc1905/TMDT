@{
    ViewBag.Title = "Đánh giá khách hàng";
    Layout = "~/Views/Shared/_LayoutPageRestaurant.cshtml";
    List<ShipFood.Models.tbDanhGia> danhgias = ViewBag.danhgias ?? new List<ShipFood.Models.tbDanhGia>();

    double avgScore = danhgias.Any() ? danhgias.Average(d => d.diemdanhgia ?? 0) : 0;
    int totalReviews = danhgias.Count;
    var dist = new int[6]; // index 1-5
    foreach (var d in danhgias) { var s = d.diemdanhgia ?? 0; if (s >= 1 && s <= 5) dist[s]++; }
}

<style>
    .review-card { background: #fff; border: 1.5px solid #f0f0f0; border-radius: 14px; padding: 20px; transition: box-shadow .2s; margin-bottom: 16px; }
    .review-card:hover { box-shadow: 0 4px 20px rgba(0,0,0,.08); }
    .star-fill { color: #f39c12; }
    .star-empty { color: #dee2e6; }
    .rating-bar { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
    .bar-track { flex: 1; height: 8px; background: #f0f0f0; border-radius: 4px; overflow: hidden; }
    .bar-fill { height: 100%; background: linear-gradient(135deg,#f39c12,#e67e22); border-radius: 4px; }
    .avatar-circle { width: 44px; height: 44px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 18px; color: #fff; flex-shrink: 0; }
    .badge-score { display: inline-block; padding: 2px 10px; border-radius: 20px; font-size: 12px; font-weight: 600; }
    .badge-score.s5 { background:#d4edda;color:#155724; }
    .badge-score.s4 { background:#d1ecf1;color:#0c5460; }
    .badge-score.s3 { background:#fff3cd;color:#856404; }
    .badge-score.s2,.badge-score.s1 { background:#f8d7da;color:#721c24; }
</style>

<div class="container-fluid">
    <div class="form-head d-flex mb-4 align-items-start">
        <div class="mr-auto d-none d-lg-block">
            <h2 class="text-black font-w600 mb-1">⭐ Đánh giá từ khách hàng</h2>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="javascript:void(0)" class="text-primary">Dashboard</a></li>
                <li class="breadcrumb-item active">Phản hồi khách hàng</li>
            </ol>
        </div>
    </div>

    @if (totalReviews == 0)
    {
        <div class="text-center py-5" style="background:#fff;border-radius:16px;padding:60px;">
            <div style="font-size:64px;margin-bottom:16px;">💬</div>
            <h4 class="text-muted">Chưa có đánh giá nào</h4>
            <p class="text-muted">Khách hàng chưa để lại đánh giá cho quán bạn.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Thống kê tổng quan -->
            <div class="col-xl-4 col-lg-5">
                <div class="card" style="border-radius:16px;border:none;box-shadow:0 2px 16px rgba(0,0,0,.07);">
                    <div class="card-body p-4">
                        <h5 class="font-w600 mb-4">📊 Tổng quan đánh giá</h5>
                        <div class="text-center mb-4">
                            <div style="font-size:56px;font-weight:800;color:#f39c12;line-height:1;">@avgScore.ToString("0.0")</div>
                            <div style="font-size:24px;color:#f39c12;letter-spacing:3px;margin:6px 0;">
                                @for (int s = 1; s <= 5; s++)
                                {
                                    <span class="@(s <= (int)Math.Round(avgScore) ? "star-fill" : "star-empty")">★</span>
                                }
                            </div>
                            <div class="text-muted" style="font-size:14px;">@totalReviews đánh giá</div>
                        </div>

                        @for (int star = 5; star >= 1; star--)
                        {
                            int count = dist[star];
                            double pct = totalReviews > 0 ? count * 100.0 / totalReviews : 0;
                            <div class="rating-bar">
                                <span style="font-size:13px;width:16px;text-align:right;font-weight:600;">@star</span>
                                <span class="star-fill" style="font-size:13px;">★</span>
                                <div class="bar-track">
                                    <div class="bar-fill" style="width:@pct.ToString("0")%;"></div>
                                </div>
                                <span style="font-size:12px;color:#888;width:28px;">@count</span>
                            </div>
                        }

                        <hr class="mt-4"/>
                        <div class="row text-center g-2">
                            <div class="col-4">
                                <div style="font-size:22px;font-weight:700;color:#28a745;">@dist[5]+@dist[4]</div>
                                <div style="font-size:11px;color:#888;">Tích cực</div>
                            </div>
                            <div class="col-4">
                                <div style="font-size:22px;font-weight:700;color:#f39c12;">@dist[3]</div>
                                <div style="font-size:11px;color:#888;">Trung bình</div>
                            </div>
                            <div class="col-4">
                                <div style="font-size:22px;font-weight:700;color:#dc3545;">@(dist[1]+dist[2])</div>
                                <div style="font-size:11px;color:#888;">Tiêu cực</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Danh sách đánh giá -->
            <div class="col-xl-8 col-lg-7">
                <div class="card" style="border-radius:16px;border:none;box-shadow:0 2px 16px rgba(0,0,0,.07);">
                    <div class="card-header border-0 pb-0 pt-4 px-4 d-flex align-items-center justify-content-between">
                        <h5 class="font-w600 mb-0">Tất cả đánh giá</h5>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-secondary" onclick="filterReviews(0)">Tất cả</button>
                            <button class="btn btn-sm btn-outline-warning" onclick="filterReviews(5)">5⭐</button>
                            <button class="btn btn-sm btn-outline-info" onclick="filterReviews(4)">4⭐</button>
                            <button class="btn btn-sm btn-outline-danger" onclick="filterReviews(1)">Thấp</button>
                        </div>
                    </div>
                    <div class="card-body p-4" id="review-container">
                        @foreach (var rv in danhgias.OrderByDescending(d => d.madg))
                        {
                            var tenkh = rv.tbChiTietDonHang?.tbDonHang?.tbThongTinDatHang?.tbKhachHang?.tenkh ?? "Khách hàng";
                            var tenmon = rv.tbChiTietDonHang?.tbMonAn?.tenmon ?? "";
                            var diem = rv.diemdanhgia ?? 0;
                            var badgeClass = diem >= 5 ? "s5" : diem == 4 ? "s4" : diem == 3 ? "s3" : "s1";
                            var bgColors = new[] { "#3CB815","#007bff","#e74c3c","#f39c12","#9b59b6","#17a2b8" };
                            var bg = bgColors[rv.madg % bgColors.Length];
                            var initial = tenkh.Length > 0 ? tenkh[0].ToString().ToUpper() : "K";

                            <div class="review-card" data-score="@diem">
                                <div class="d-flex align-items-center gap-3 mb-3">
                                    <div class="avatar-circle" style="background:@bg;">@initial</div>
                                    <div class="flex-1" style="min-width:0;">
                                        <div style="font-weight:700;font-size:15px;">@tenkh</div>
                                        @if (!string.IsNullOrEmpty(tenmon))
                                        {
                                            <div style="font-size:12px;color:#888;">
                                                <span style="background:#f8f9fa;padding:2px 8px;border-radius:20px;">@tenmon</span>
                                            </div>
                                        }
                                    </div>
                                    <div class="text-end">
                                        <span class="badge-score @badgeClass">@diem ★</span>
                                        <div style="font-size:11px;color:#ccc;margin-top:2px;">
                                            @for (int s = 1; s <= 5; s++)
                                            {
                                                <span class="@(s <= diem ? "star-fill" : "star-empty")" style="font-size:13px;">★</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(rv.nhanxet))
                                {
                                    <p style="color:#555;font-size:14px;line-height:1.7;margin:0;padding:12px;background:#f8f9fa;border-radius:8px;border-left:3px solid @bg;">
                                        "@rv.nhanxet"
                                    </p>
                                }
                                else
                                {
                                    <p style="color:#bbb;font-size:13px;font-style:italic;margin:0;">Không có nhận xét</p>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<script>
function filterReviews(score) {
    var cards = document.querySelectorAll('.review-card');
    cards.forEach(function(c) {
        var s = parseInt(c.dataset.score);
        if (score === 0 || score === 5 && s >= 4 || score === 4 && s === 4 || score === 1 && s <= 2) {
            c.style.display = '';
        } else {
            c.style.display = 'none';
        }
    });
    if (score === 0) cards.forEach(function(c){ c.style.display = ''; });
}
</script>
