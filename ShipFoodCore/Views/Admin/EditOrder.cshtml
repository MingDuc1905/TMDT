@model ShipFood.Models.tbDonHang
@{
    ViewBag.Title = "Sửa đơn hàng";
    Layout = "~/Views/Shared/_LayoutPageAdmin.cshtml";
    var shippers = ViewBag.Shippers as List<ShipFood.Models.tbShipper> ?? new();
    var statusList = ViewBag.StatusList as string[] ?? new[] { "Đã đặt", "Đang xử lý", "Đang giao", "Đã lấy", "Hoàn thành", "Đã hủy" };
}

<style>
    .edit-page { max-width: 700px; margin: 0 auto; padding: 24px; }
    .form-card { background: white; border-radius: 14px; padding: 32px; border: 1px solid #f0f0f0; }
    .form-card .form-group { margin-bottom: 24px; }
    .form-card label { font-weight: 600; font-size: 14px; color: #374151; display: block; margin-bottom: 6px; }
    .form-card .form-control, .form-card .form-select {
        border-radius: 10px; border: 1.5px solid #e5e7eb;
        padding: 10px 14px; font-size: 14px; width: 100%;
    }
    .form-card .form-control:focus, .form-card .form-select:focus {
        border-color: #3CB815; box-shadow: 0 0 0 3px rgba(60,184,21,.12); outline: none;
    }
    .order-info {
        background: #f8f9fa; border-radius: 12px; padding: 16px; margin-bottom: 24px;
    }
    .order-info .row-item { display: flex; justify-content: space-between; padding: 6px 0; font-size: 14px; }
    .order-info .label { color: #6b7280; }
    .order-info .value { font-weight: 600; color: #1a1a2e; }
</style>

<div class="content-body">
    <div class="container-fluid">
        <div class="page-header">
            <h2><i class="fas fa-edit" style="color:#3CB815;margin-right:8px;"></i>Sửa đơn hàng #@Model.madh</h2>
            <div>
                <a href="@Url.Action("OrderDetail","Admin", new { id = Model.madh })" class="btn btn-outline me-2">
                    <i class="fas fa-eye"></i> Chi tiết
                </a>
                <a href="@Url.Action("Order","Admin")" class="btn btn-outline">
                    <i class="fas fa-arrow-left"></i> Quay lại
                </a>
            </div>
        </div>

        <div class="edit-page">
            <div class="form-card">
                <!-- Thông tin đơn hàng -->
                <div class="order-info">
                    <div class="row-item">
                        <span class="label">Nhà hàng</span>
                        <span class="value">@Model.tbQuanAn?.tenquanan</span>
                    </div>
                    <div class="row-item">
                        <span class="label">Khách hàng</span>
                        <span class="value">@Model.tbThongTinDatHang?.tennguoinhan</span>
                    </div>
                    <div class="row-item">
                        <span class="label">Tổng tiền</span>
                        <span class="value">@Model.tongtien?.ToString("N0")đ</span>
                    </div>
                    <div class="row-item">
                        <span class="label">Ngày đặt</span>
                        <span class="value">@Model.ngaydathang?.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    <div class="row-item">
                        <span class="label">Trạng thái hiện tại</span>
                        <span class="value" style="color:#3CB815;">@Model.trangthai</span>
                    </div>
                </div>

                @using (Html.BeginForm("EditOrder", "Admin", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("madh", Model.madh)

                    <div class="form-group">
                        <label for="trangthai"><i class="fas fa-thumbtack" style="margin-right:4px;color:#6b7280;"></i>Trạng thái đơn hàng</label>
                        <select name="trangthai" id="trangthai" class="form-select">
                            <option value="">— Giữ nguyên —</option>
                            @foreach (var s in statusList)
                            {
                                <option value="@s" selected="@(s == Model.trangthai)">@s</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="mashipper"><i class="fas fa-truck" style="margin-right:4px;color:#6b7280;"></i>Gán shipper</label>
                        <select name="mashipper" id="mashipper" class="form-select">
                            <option value="">— Giữ nguyên —</option>
                            @foreach (var sh in shippers)
                            {
                                <option value="@sh.userid" selected="@(sh.userid == Model.mashipper)">
                                    @sh.tenshipper @(sh.tbUser != null ? $"({sh.tbUser.sdt})" : "")
                                </option>
                            }
                        </select>
                        @if (!shippers.Any())
                        {
                            <small style="color:#dc2626;"><i class="fas fa-exclamation-triangle" style="margin-right:4px;"></i>Không có shipper nào đang hoạt động</small>
                        }
                    </div>

                    <div class="d-flex gap-3 mt-4">
                        <button type="submit" class="btn btn-success" style="flex:1;padding:12px;">
                            <i class="fas fa-save me-2"></i> Lưu thay đổi
                        </button>
                        <a href="@Url.Action("Order","Admin")" class="btn btn-outline" style="flex:0 0 auto;padding:12px 24px;">
                            <i class="fas fa-times me-2"></i> Hủy
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
