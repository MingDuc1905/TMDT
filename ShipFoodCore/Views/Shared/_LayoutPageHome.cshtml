@using ShipFood.Models
@inject ShipFood.Models.dbFoodyEntities _db
@{
    var userJson = Context.Session.GetString("user");
    ShipFood.Models.tbUser? user = userJson != null ? JsonSerializer.Deserialize<tbUser>(userJson) : null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Fastship — Khám phá & đặt món, giao tận nơi tại TP.HCM</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta name="keywords" content="đặt đồ ăn, giao thức ăn, quán ăn Sài Gòn, Fastship" />
    <meta name="description" content="Fastship — nền tảng đặt món và giao hàng nhanh tại TP. Hồ Chí Minh. Hàng trăm quán ăn, giao trong 30 phút." />
    <link href="~/Source/Home/css/chat.css" rel="stylesheet" />
    <!-- Favicon + PWA -->
    <link href="~/Source/Home/img/favicon.ico" rel="icon" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#3CB815" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    @if (user != null)
    {
        <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
        <meta http-equiv="Pragma" content="no-cache" />
        <meta http-equiv="Expires" content="0" />
    }

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Roboto:wght@400;500&display=swap" rel="stylesheet" />

    <!-- Font Awesome 5 (CDN) — dùng CDN cloudflare, ko cần fallback local vì FA6 không tồn tại trong repo -->
    <!-- Font Awesome 5 (CDN) — load m?t CDN duy nh?t + onerror fallback -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet" onerror="var s=document.createElement('link');s.rel='stylesheet';s.href='https://use.fontawesome.com/releases/v5.10.0/css/all.css';document.head.appendChild(s);console.warn('FA CDN fallback loaded from use.fontawesome.com');" />

    <!-- Libraries Stylesheet -->
    <link href="~/Source/Home/lib/animate/animate.min.css" rel="stylesheet" />
    <link href="~/Source/Home/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet" />
    <!-- Bootstrap — dùng local file (da duoc Cache-Control qua Program.cs) -->
    <link href="~/Source/Home/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Template Stylesheet -->
    <link href="~/Source/Home/css/style.css" rel="stylesheet" />

    <!-- Sweetgreen-inspired overrides -->
    <link href="~/Source/Home/css/layout-sg.css" rel="stylesheet" />

    <!-- Global Design System v4.0 -->
    <link href="~/Source/Shared/css/fastship-design-tokens.css" rel="stylesheet" />
    <link href="~/Source/Shared/css/fastship-animations.css" rel="stylesheet" />

    <!-- ─── Common color CSS variables (ponytail: reuse --fs-* tokens) ─── -->
    <style>
        .fs-hover-green:hover { border-color: var(--fs-green, #3CB815) !important; background: var(--fs-green-bg, rgba(60,184,21,.07)) !important; }
        .fs-hover-danger:hover { background: #fef2f2 !important; border-color: #ef4444 !important; }
        .fs-trans-x:hover { transform: translateX(4px); }
        .fs-card-hover:hover { border-color: #3CB815 !important; box-shadow: 0 2px 12px rgba(60,184,21,.15) !important; }
        .fs-btn-hover-green:hover { background: #2ea310 !important; border-color: #2ea310 !important; }

        /* ─── User dropdown fix: không bị ẩn trong collapse ─── */
        .fs-user-dropdown-toggle {
            font-size: 13.5px; font-weight: 600; border: 1.5px solid var(--fs-green);
            border-radius: 24px; padding: 6px 14px 6px 8px; color: #1a1a2e;
            background: #fff; transition: all .2s; box-shadow: none; line-height: 1;
        }
        .fs-user-dropdown-toggle:hover, .fs-user-dropdown-toggle:focus, .fs-user-dropdown-toggle:active {
            background: rgba(60,184,21,.07) !important; border-color: var(--fs-green) !important;
            box-shadow: none !important; color: #1a1a2e !important;
        }
        .fs-user-dropdown-toggle.dropdown-toggle::after { margin-left: 4px; }
        .fs-user-dropdown-menu {
            border-radius: 12px; border: 1px solid #f0f0f0; padding: 6px 0;
            box-shadow: 0 8px 32px rgba(0,0,0,.12); z-index: 1070 !important;
            max-height: none !important; 
            overflow: visible !important;
            transform: none !important;
        }
        .fs-user-dropdown-menu .dropdown-item { border-radius: 8px; margin: 0 6px; padding: 8px 12px; font-size: 14px; transition: background .15s; }
        .fs-user-dropdown-menu .dropdown-item:hover { background: rgba(60,184,21,.08); }
        /* Fix dropdown inside Bootstrap collapse: không bị clip */
        .navbar-collapse.show .dropdown .fs-user-dropdown-menu,
        .navbar-collapse.collapsing .dropdown .fs-user-dropdown-menu {
            position: absolute !important;
            overflow: visible !important;
        }
        @@media (min-width: 992px) {
            .navbar-nav .dropdown { position: relative; }
            .navbar-nav .dropdown .fs-user-dropdown-menu { right: 0; left: auto; top: 100%; }
        }
    </style>

    <!-- Auto aria-hidden cho FA icons (fix P11 — khỏi sửa từng icon th? công) -->
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('i.fa, i.fas, i.far, i.fab, i.fal').forEach(function(el) {
            if (!el.hasAttribute('aria-hidden') && !el.getAttribute('aria-label')) {
                el.setAttribute('aria-hidden', 'true');
            }
        });
    });
    </script>

    <!-- ═══ Dark mode: CSS variables override (toggle ? layout) ═══ -->
    <style>
        html[data-theme="dark"] body {
            background: #1a1a2e !important;
            color: #e5e7eb !important;
        }
        html[data-theme="dark"] .fs-header,
        html[data-theme="dark"] .fs-footer,
        html[data-theme="dark"] .checkout-card,
        html[data-theme="dark"] .order-summary,
        html[data-theme="dark"] .wallet-mini-stat,
        html[data-theme="dark"] .tx-item { background: #1f2937 !important; border-color: #374151 !important; }
        html[data-theme="dark"] .navbar-light .navbar-nav .nav-link { color: #e5e7eb !important; }
        html[data-theme="dark"] .text-muted { color: #9ca3af !important; }
        html[data-theme="dark"] .dropdown-menu { background: #1f2937 !important; border-color: #374151 !important; }
        html[data-theme="dark"] .dropdown-item { color: #e5e7eb !important; }
        html[data-theme="dark"] .dropdown-item:hover { background: #374151 !important; }
    </style>

    <!-- ═══ Global JS error boundary (9.4) — catch l?i JS ko ch?p UI crash ═══ -->
    <script>
    window.addEventListener('error', function(e) {
        console.error('[Global Error]', e.error || e.message);
        // Không b?t silent — ch? log, UI v?n ch?y
    });
    window.addEventListener('unhandledrejection', function(e) {
        console.error('[Unhandled Promise]', e.reason);
        e.preventDefault();
    });
    </script>

    @RenderSection("styles", required: false)
</head>

<body>
    <!-- Login state cho JS (cart-local.js cần biết user đã login chưa) -->
    <script>window._IS_LOGGED_IN = @(user != null ? "true" : "false");</script>

    <!-- Skip-to-content link cho keyboard users -->
    <a href="#main-content" class="skip-link">Bỏ qua điều hướng, đến nội dung chính</a>

    <!-- Skeleton Loading (replaces old spinner) -->
    <div id="fs-loading-skeleton" class="fs-skeleton-overlay" aria-hidden="true">
        <div class="fs-skel-header">
            <div class="fs-skel-logo fs-skeleton"></div>
            <div class="fs-skel-search fs-skeleton"></div>
            <div class="fs-skel-nav fs-skeleton"></div>
        </div>
        <div class="fs-skel-hero">
            <div class="fs-skel-hero-img fs-skeleton"></div>
            <div class="fs-skel-hero-text">
                <div class="fs-skeleton" style="height:24px;width:60%;margin-bottom:12px"></div>
                <div class="fs-skeleton" style="height:16px;width:40%"></div>
            </div>
        </div>
        <div class="fs-skel-cards">
            <div class="fs-skel-card fs-skeleton"></div>
            <div class="fs-skel-card fs-skeleton"></div>
            <div class="fs-skel-card fs-skeleton"></div>
            <div class="fs-skel-card fs-skeleton"></div>
        </div>
    </div>
    <!-- Skeleton End -->

    <!-- ===== NAVBAR (z-index: 1050) ===== -->
    <header class="fs-header" id="fsHeader" style="position:sticky;top:0;z-index:1050;background:#fff;box-shadow:0 2px 12px rgba(0,0,0,.06);">
        <!-- Top info bar (desktop only) -->
        <div class="fs-topbar d-none d-lg-block">
            <div class="container-fluid px-5">
                <div class="row align-items-center">
                    <div class="col-lg-6 text-start">
                        <small><i class="fa fa-map-marker-alt me-1"></i>48 Cao Thắng, Quận 3, TP. Hồ Chí Minh</small>
                        <small class="ms-4"><i class="fa fa-envelope me-1"></i>fastship@contact.com</small>
                    </div>
                    <div class="col-lg-6 text-end">
                        <div class="top-bar-right">
                            <span>Theo dõi chúng tôi:</span>
                            <a href="https://facebook.com/fastship" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                                <svg aria-hidden="true" viewBox="0 0 36 36" width="12" height="12" fill="currentColor"><path d="M15 35.8C6.5 34.3 0 26.9 0 18 0 8.1 8.1 0 18 0s18 8.1 18 18c0 8.9-6.5 16.3-15 17.8l-1-.8h-4zm10-12.8.8-5H21v-3.5c0-1.4.5-2.5 2.7-2.5H26V7.4c-1.3-.2-2.7-.4-4-.4-4.1 0-7 2.5-7 7v4h-4.5v5H15v12.7q1.5.3 3 .3c1.5 0 2-.1 3-.3V23z"/></svg>
                            </a>
                            <a href="https://instagram.com/fastship" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                                <svg aria-hidden="true" viewBox="0 0 100 100" width="12" height="12" fill="currentColor"><path d="M50.092 67.942a17.85 17.85 0 1 0 0-35.7 17.85 17.85 0 0 0 0 35.7m0-7.14a10.71 10.71 0 1 0 0-21.42 10.71 10.71 0 0 0 0 21.42"/><path d="M75.042 30.474a5.355 5.355 0 1 1-10.71 0 5.355 5.355 0 0 1 10.71 0"/><path d="M14.426 48.698c0-11.995 0-17.993 2.335-22.577a21.42 21.42 0 0 1 9.36-9.36c4.584-2.335 10.582-2.335 22.577-2.335h2.856c11.995 0 17.993 0 22.577 2.335a21.42 21.42 0 0 1 9.36 9.36c2.335 4.584 2.335 10.582 2.335 22.577v2.856c0 11.995 0 17.993-2.335 22.577a21.42 21.42 0 0 1-9.36 9.36c-4.584 2.335-10.582 2.335-22.577 2.335h-2.856c-11.995 0-17.993 0-22.577-2.335a21.42 21.42 0 0 1-9.36-9.36c-2.335-4.584-2.335-10.582-2.335-22.577zm34.272-27.132h2.856c6.115 0 10.274.007 13.487.268 3.131.257 4.73.72 5.848 1.289a14.28 14.28 0 0 1 6.24 6.24c.572 1.117 1.036 2.717 1.286 5.848.264 3.213.271 7.372.271 13.487v2.856c0 6.115-.007 10.274-.268 13.487-.257 3.131-.72 4.73-1.289 5.848a14.28 14.28 0 0 1-6.24 6.24c-1.117.572-2.717 1.036-5.848 1.286-3.213.264-7.372.271-13.487.271h-2.856c-6.115 0-10.274-.007-13.487-.268-3.131-.257-4.73-.72-5.848-1.289a14.28 14.28 0 0 1-6.24 6.24c-.572-1.117-1.036-2.717-1.286-5.848-.267-3.213-.271-7.372-.271-13.487v-2.856c0-6.115.007-10.274.268-13.487.257-3.131.72-4.73 1.289-5.848a14.28 14.28 0 0 1 6.24-6.24c1.117-.572 2.717-1.036 5.848-1.286 3.213-.264 7.372-.271 13.487-.271"/></svg>
                            </a>
                            <a href="https://tiktok.com/@@fastship" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
                                <svg aria-hidden="true" viewBox="0 0 100 100" width="12" height="12" fill="currentColor"><path d="M92.26 23.33a28.09 28.09 0 0 1-16.53-5.34 28.07 28.07 0 0 1-9.88-13.32 28.09 28.09 0 0 1-1.44-5.59H49.31v61.36a15.6 15.6 0 0 1-4.23 10.56 15.6 15.6 0 0 1-22.13 0 15.6 15.6 0 0 1 0-22.13 15.6 15.6 0 0 1 14.52-4.23V45.07A31.2 31.2 0 0 0 28 43.53 31.2 31.2 0 0 0 0 74.73a31.2 31.2 0 0 0 17.88 28.09 31.2 31.2 0 0 0 33.5-6.6 31.2 31.2 0 0 0 9.27-22.13V27.93a43.66 43.66 0 0 0 25.36 8.67V23.33h-1.59z"/></svg>
                            </a>
                            <a href="https://youtube.com/@@fastship" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
                                <svg aria-hidden="true" viewBox="0 0 256 180" width="12" height="12" fill="currentColor"><path d="M250.346 28.075A32.18 32.18 0 0 0 227.69 5.418C207.824 0 127.87 0 127.87 0S47.912.164 28.046 5.582A32.18 32.18 0 0 0 5.39 28.24c-6.009 35.298-8.34 89.084.165 122.97a32.18 32.18 0 0 0 22.656 22.657c19.866 5.418 99.822 5.418 99.822 5.418s79.955 0 99.82-5.418a32.18 32.18 0 0 0 22.657-22.657c6.338-35.348 8.291-89.1-.164-123.134Z"/><path fill="currentColor" d="m102.421 128.06 66.328-38.418-66.328-38.418z"/></svg>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main nav -->
        <nav class="fs-nav navbar navbar-expand-lg navbar-light" aria-label="Điều hướng chính">
            <div class="container-fluid px-3 px-lg-5">
                <!-- Logo -->
                <a href="/Home" class="navbar-brand fs-logo" aria-label="Fastship trang chủ">
                    <span class="logo-f">F</span><span class="logo-ast">ast</span><span class="logo-ship">ship</span>
                </a>

                <!-- ═══ MOBILE HEADER: always visible icons (login/logout, cart, hamburger) ═══ -->
                <div class="d-flex d-lg-none align-items-center ms-auto ms-lg-0 gap-2 me-1" style="position:relative; z-index:1080;">
                    @if (user != null)
                    {
                        <!-- Avatar dropdown (mobile) -->
                        <div class="dropdown">
                            <button class="btn p-0 border-0 dropdown-toggle" type="button"
                                    data-bs-toggle="dropdown" data-bs-display="static" data-bs-auto-close="true" aria-expanded="false"
                                    style="width:44px;height:44px;border-radius:50%;background:var(--fs-green);color:#fff;font-size:16px;font-weight:700;display:flex;align-items:center;justify-content:center;box-shadow:none;">
                                @user.username.Substring(0,1).ToUpper()
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end fs-user-dropdown-menu" style="min-width:200px;">
                                <li><span class="dropdown-item-text px-3 py-2" style="font-size:12px;color:#888;">Xin chào,</span></li>
                                <li><span class="dropdown-item-text px-3 pb-2 fw-bold" style="font-size:15px;">@user.username</span></li>
                                <li><hr class="dropdown-divider" style="margin:4px 16px;"></li>
                                <li><a class="dropdown-item d-flex align-items-center gap-2 px-3 py-2" href="/Cart/LichSuDatHang"><i class="fa fa-history" style="width:18px;color:#6b7280;"></i> Lịch sử đơn hàng</a></li>
                                <li><a class="dropdown-item d-flex align-items-center gap-2 px-3 py-2" href="/Home/Wallet"><i class="fa fa-wallet" style="width:18px;color:var(--fs-green);"></i> Ví tiền</a></li>
                                <li><a class="dropdown-item d-flex align-items-center gap-2 px-3 py-2" href="/Home/Profile"><i class="fa fa-user" style="width:18px;color:#6b7280;"></i> Hồ sơ</a></li>
                                @if (user.loaitaikhoan.Equals("Quán ăn"))
                                {
                                    <li><a class="dropdown-item d-flex align-items-center gap-2 px-3 py-2" href="/Restaurant"><i class="fa fa-store" style="width:18px;color:#6b7280;"></i> Quản lý quán</a></li>
                                }
                                @if (user.loaitaikhoan.Equals("Shipper"))
                                {
                                    <li><a class="dropdown-item d-flex align-items-center gap-2 px-3 py-2" href="/Shipper"><i class="fa fa-truck" style="width:18px;color:#6b7280;"></i> Bảng điều khiển</a></li>
                                }
                                @if (user.loaitaikhoan.Equals("Admin"))
                                {
                                    <li><a class="dropdown-item d-flex align-items-center gap-2 px-3 py-2" href="/Admin"><i class="fa fa-shield-alt" style="width:18px;color:#6b7280;"></i> Quản trị</a></li>
                                }
                                <li><hr class="dropdown-divider" style="margin:4px 16px;"></li>
                                <li><a href="/Home/Logout" onclick="sessionStorage.clear(); localStorage.clear();" class="dropdown-item d-flex align-items-center gap-2 px-3 py-2" style="color:#ef4444;"><i class="fa fa-sign-out-alt" style="width:18px;"></i> Đăng xuất</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a href="/Home/Login" class="fs-mobile-login-btn fs-nav-hover" aria-label="Đăng nhập" title="Đăng nhập"
                           style="display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:50%;color:#3CB815;font-size:18px;border:1.5px solid rgba(60,184,21,.3);text-decoration:none;">
                            <i class="fa fa-sign-in-alt" aria-hidden="true"></i>
                        </a>
                    }
                    <a class="fs-cart-btn" href="/Cart" aria-label="Giỏ hàng" id="navCartBtnMobile" style="position:relative; width:44px; height:44px; display:flex; align-items:center; justify-content:center; font-size:18px;">
                        <i class="fa fa-shopping-bag"></i>
                        <span class="fs-cart-badge" id="navCartBadgeMobile" style="display:none;position:absolute;top:-6px;right:-6px;background:#dc3545;color:#fff;width:20px;height:20px;border-radius:50%;font-size:11px;align-items:center;justify-content:center;font-weight:700;">0</span>
                    </a>
                    <button type="button" class="d-lg-none navbar-toggler border-0" data-bs-toggle="collapse" data-bs-target="#navbarCollapse" aria-controls="navbarCollapse" aria-expanded="false" aria-label="Mở menu">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                </div>

                <!-- Search (visible inline on desktop) -->
                @{
                    var selectedIdDM = ViewBag.idDM as int?;
                    List<tbDanhMuc> allDanhMuc = new List<tbDanhMuc>();
                    try { allDanhMuc = _db.tbDanhMuc.ToList(); } catch { /* DB unavailable — skip category filter */ }
                }
                <div class="fs-search-wrap d-none d-lg-flex mx-auto">
                    <form action="/Home" method="get" class="fs-search-form" role="search" aria-label="Tìm quán ăn">
                        <select name="idDM" aria-label="Chọn danh mục">
                            <option value="">Tất cả</option>
                            @foreach (var item in allDanhMuc)
                            {
                                if (selectedIdDM.HasValue && selectedIdDM.Value == item.madanhmuc)
                                {
                                    <option value="@item.madanhmuc" selected>@item.tendanhmuc</option>
                                }
                                else
                                {
                                    <option value="@item.madanhmuc">@item.tendanhmuc</option>
                                }
                            }
                        </select>
                        <input type="text" value="@ViewBag.txtSearch" name="txtSearch" placeholder="Tìm món ăn, quán ăn..." aria-label="Từ khoá tìm kiếm" id="mainSearchInput" />
                        <button type="submit" aria-label="Tìm kiếm"><i class="fa fa-search me-1"></i>Tìm</button>
                    </form>
                </div>

                <!-- Collapse menu -->
                <div class="collapse navbar-collapse" id="navbarCollapse">
                    <!-- Mobile search inside collapse -->
                    <div class="d-lg-none px-2 py-2">
                        <form action="/Home" method="get" class="fs-search-form-mobile" role="search">
                            <div class="input-group">
                                <select name="idDM" class="form-select form-select-sm fs-select-mobile" aria-label="Danh mục">
                                    <option value="">Tất cả</option>
                                    @foreach (var item in allDanhMuc)
                                    {
                                        if (selectedIdDM.HasValue && selectedIdDM.Value == item.madanhmuc)
                                        {
                                            <option value="@item.madanhmuc" selected>@item.tendanhmuc</option>
                                        }
                                        else
                                        {
                                            <option value="@item.madanhmuc">@item.tendanhmuc</option>
                                        }
                                    }
                                </select>
                                <input type="text" value="@ViewBag.txtSearch" name="txtSearch" class="form-control form-control-sm" placeholder="Tìm quán ăn..." />
                                <button type="submit" class="btn btn-success btn-sm px-3"><i class="fa fa-search"></i></button>
                            </div>
                        </form>
                    </div>

                    <!-- Nav links -->
                    <div class="navbar-nav ms-auto p-2 p-lg-0 align-items-lg-center">
                        <a href="/Home" class="nav-item nav-link">Trang chủ</a>
                        <a href="/Home/DanhMuc" class="nav-item nav-link">Menu ẩm thực</a>                            @if (user != null)
                            {                        
                            <!-- ═══ DESKTOP: user dropdown ═══ -->
                            <div class="d-none d-lg-flex align-items-center ms-lg-2 dropdown">
                                <button class="btn dropdown-toggle d-flex align-items-center gap-1 px-2 py-1 fs-user-dropdown-toggle" type="button"
                                        data-bs-toggle="dropdown" data-bs-display="static" data-bs-auto-close="outside" aria-expanded="false">
                                    <span style="width:30px;height:30px;border-radius:50%;background:var(--fs-green);color:#fff;display:inline-flex;align-items:center;justify-content:center;font-weight:700;font-size:12px;">@user.username.Substring(0,1).ToUpper()</span>
                                    <span class="d-none d-lg-inline" style="font-size:13px;font-weight:500;line-height:1;color:#1a1a2e;">@user.username</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end fs-user-dropdown-menu" style="min-width:200px;">
