@model ShipFood.Models.tbUser
@{
    ViewBag.Title = "Hồ sơ";
    Layout = "~/Views/Shared/_LayoutPageHome.cshtml";
    var kh = ViewBag.KhachHang as ShipFood.Models.tbKhachHang;
}
<style>
    .profile-page { max-width: 700px; margin: 100px auto 0; padding: 24px; }
    .profile-card { background: #fff; border-radius: 20px; box-shadow: 0 4px 20px rgba(0,0,0,.07); padding: 32px; }
    .profile-header { text-align: center; margin-bottom: 28px; }
    .profile-avatar { width: 80px; height: 80px; border-radius: 50%; background: var(--fs-green); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 32px; font-weight: 700; margin: 0 auto 12px; }
    .profile-header h3 { font-weight: 700; color: #1a1a2e; margin: 0; }
    .profile-header p { font-size: 13px; color: #6b7280; margin: 4px 0 0; }
    .form-group { margin-bottom: 20px; }
    .form-group label { display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px; }
    .form-group .form-control { width: 100%; padding: 10px 14px; border: 1.5px solid #e5e7eb; border-radius: 12px; font-size: 14px; transition: border-color .2s; }
    .form-group .form-control:focus { border-color: var(--fs-green); box-shadow: 0 0 0 3px rgba(60,184,21,.12); outline: none; }
    .btn-save { background: linear-gradient(135deg, var(--fs-green), #27a001); color: #fff; border: none; border-radius: 12px; padding: 12px 32px; font-size: 15px; font-weight: 600; cursor: pointer; transition: opacity .2s; width: 100%; }
    .btn-save:hover { opacity: .88; }
    .alert { border-radius: 12px; padding: 12px 16px; margin-bottom: 16px; font-size: 14px; }
    .alert-success { background: #f0fdf4; color: #16a34a; border: 1px solid #bbf7d0; }
    .alert-danger { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; }
</style>

<div class="profile-page">
    @if (TempData["ProfileSuccess"] != null)
    {
        <div class="alert alert-success"><i class="fas fa-check-circle me-1"></i>@TempData["ProfileSuccess"]</div>
    }
    @if (TempData["ProfileError"] != null)
    {
        <div class="alert alert-danger"><i class="fas fa-exclamation-circle me-1"></i>@TempData["ProfileError"]</div>
    }

    <div class="profile-card">
        <div class="profile-header">
            <div class="profile-avatar">@(Model?.username?.Substring(0,1)?.ToUpper() ?? "?")</div>
            <h3>@(kh?.tenkh ?? Model?.username ?? "Khách hàng")</h3>
            <p><i class="fa fa-envelope me-1"></i>@Model?.email</p>
        </div>

        <form method="post" action="~/Home/Profile">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label>Họ tên</label>
                <input type="text" class="form-control" name="hoten" value="@(kh?.tenkh ?? "")" placeholder="Nguyễn Văn A" />
            </div>
            <div class="form-group">
                <label>Email</label>
                <input type="email" class="form-control" name="email" value="@Model?.email" readonly style="background:#f9fafb;" />
            </div>
            <div class="form-group">
                <label>Số điện thoại</label>
                <input type="text" class="form-control" name="sdt" value="@Model?.sdt" placeholder="0912345678" maxlength="11" />
            </div>
            <!-- ponytail: tbKhachHang ko có diachi, bỏ qua. Dùng tbThongTinDatHang nếu cần -->
            <hr />
            <p class="text-muted small mb-3"><i class="fas fa-lock me-1"></i>Đổi mật khẩu (để trống nếu không muốn thay đổi)</p>
            <div class="form-group">
                <label>Mật khẩu hiện tại</label>
                <input type="password" class="form-control" name="oldPwd" placeholder="Nhập mật khẩu hiện tại" />
            </div>
            <div class="form-group">
                <label>Mật khẩu mới</label>
                <input type="password" class="form-control" name="newPwd" placeholder="Tối thiểu 8 ký tự" />
            </div>
            <div class="form-group">
                <label>Xác nhận mật khẩu</label>
                <input type="password" class="form-control" name="confirmPwd" placeholder="Nhập lại mật khẩu mới" />
            </div>
            <button type="submit" class="btn-save"><i class="fas fa-save me-2"></i>Lưu thay đổi</button>
        </form>
    </div>
</div>
