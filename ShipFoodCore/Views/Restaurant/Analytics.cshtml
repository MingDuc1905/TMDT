@{
    ViewBag.Title = "Phan tich kinh doanh";
    Layout = "~/Views/Shared/_LayoutPageRestaurant.cshtml";
    var datas = ViewBag.datas as List<ShipFood.Models.DataAnalytic> ?? new List<ShipFood.Models.DataAnalytic>();
    var dataDanhMucs = ViewBag.dataDanhMucs as List<ShipFood.Models.DataAnalyticDanhMuc> ?? new List<ShipFood.Models.DataAnalyticDanhMuc>();
    var doanhThu = ViewBag.doanhThu as double? ?? 0;
}

<div class="container-fluid">
    <div class="form-head d-flex mb-4 align-items-start">
        <div class="me-auto d-none d-lg-block">
            <h2 class="text-black font-w600 mb-1">Phan tich kinh doanh</h2>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Restaurant")" class="text-primary">Dashboard</a></li>
                <li class="breadcrumb-item active">Phan tich</li>
            </ol>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm" style="border-radius:16px;">
                <div class="card-body d-flex align-items-center gap-3 p-4">
                    <div style="width:52px;height:52px;border-radius:14px;background:linear-gradient(135deg,#3CB815,#27a001);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <i class="fas fa-dollar-sign text-white" style="font-size:22px;" aria-hidden="true"></i>
                    </div>
                    <div>
                        <div style="font-size:11px;color:#888;font-weight:600;text-transform:uppercase;letter-spacing:.5px;">Doanh thu</div>
                        <div style="font-size:26px;font-weight:800;color:var(--fs-dark);margin-top:2px;">@doanhThu.ToString("N0")d</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm" style="border-radius:16px;">
                <div class="card-body d-flex align-items-center gap-3 p-4">
                    <div style="width:52px;height:52px;border-radius:14px;background:linear-gradient(135deg,#007bff,#0056b3);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <i class="fas fa-utensils text-white" style="font-size:22px;" aria-hidden="true"></i>
                    </div>
                    <div>
                        <div style="font-size:11px;color:#888;font-weight:600;text-transform:uppercase;letter-spacing:.5px;">Mon da ban</div>
                        <div style="font-size:26px;font-weight:800;color:var(--fs-dark);margin-top:2px;">@datas.Sum(d => d.soLuongBanDuoc ?? 0)</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm" style="border-radius:16px;">
                <div class="card-body d-flex align-items-center gap-3 p-4">
                    <div style="width:52px;height:52px;border-radius:14px;background:linear-gradient(135deg,#f39c12,#e67e22);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <i class="fas fa-star text-white" style="font-size:22px;" aria-hidden="true"></i>
                    </div>
                    <div>
                        <div style="font-size:11px;color:#888;font-weight:600;text-transform:uppercase;letter-spacing:.5px;">Danh gia</div>
                        <div style="font-size:26px;font-weight:800;color:var(--fs-dark);margin-top:2px;">
                            @{
                                var ratings = datas.Where(d => d.soDanhGia > 0).Select(d => d.diemDanhGia).ToList();
                                var avg = ratings.Any() ? ratings.Average().Value.ToString("0.0") : "-";
                            }
                            @avg <span style="font-size:14px;color:#888;font-weight:400;">/ 5</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        @if (dataDanhMucs.Any())
        {
            <div class="col-xl-5">
                <div class="card border-0 shadow-sm" style="border-radius:16px;">
                    <div class="card-header border-0 pt-4 px-4">
                        <h5 class="font-w600 mb-0">Thong ke theo danh muc</h5>
                    </div>
                    <div class="card-body px-4 pb-4">
                        @foreach (var dm in dataDanhMucs.OrderByDescending(d => d.doanhThu))
                        {
                            <div class="d-flex align-items-center justify-content-between mb-3 pb-3" style="border-bottom:1px solid #f0f0f0;">
                                <div class="d-flex align-items-center gap-3" style="min-width:0;">
                                    <img src="@TinhToan.HinhAnhUrl(dm.hinhAnh)" style="width:44px;height:44px;border-radius:10px;object-fit:cover;" alt="@dm.tenDanhMuc" onerror="this.src='/Source/Home/img/pizza.jpg'" />
                                    <div style="min-width:0;">
                                        <div style="font-weight:600;font-size:14px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@dm.tenDanhMuc</div>
                                        <div style="font-size:12px;color:#888;">@dm.soLuongMonAn mon . @dm.tongSoLuongBanRa da ban</div>
                                    </div>
                                </div>
                                <div style="font-weight:700;font-size:15px;color:var(--fs-green);white-space:nowrap;">@(dm.doanhThu?.ToString("N0") ?? "0")d</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <div class="@(dataDanhMucs.Any() ? "col-xl-7" : "col-12")">
            <div class="card border-0 shadow-sm" style="border-radius:16px;">
                <div class="card-header border-0 pt-4 px-4 d-flex align-items-center justify-content-between">
                    <h5 class="font-w600 mb-0">Thong ke mon an</h5>
                    <span style="font-size:12px;color:#888;">Sap xep theo so luong ban</span>
                </div>
                <div class="card-body px-4 pb-4">
                    @if (!datas.Any())
                    {
                        <div class="text-center py-5" style="color:#888;">
                            <div style="font-size:48px;margin-bottom:12px;">📭</div>
                            <div>Chua co du lieu ban hang</div>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table align-middle mb-0" style="font-size:14px;">
                                <thead style="background:#f8f9fa;font-size:12px;text-transform:uppercase;letter-spacing:.5px;color:#888;">
                                    <tr>
                                        <th style="padding:12px 8px;">Mon</th>
                                        <th style="padding:12px 8px;">Danh muc</th>
                                        <th style="padding:12px 8px;text-align:center;">Da ban</th>
                                        <th style="padding:12px 8px;text-align:center;">Danh gia</th>
                                        <th style="padding:12px 8px;text-align:right;">Gia</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var i in datas)
                                    {
                                        <tr>
                                            <td style="padding:10px 8px;">
                                                <div class="d-flex align-items-center gap-3">
                                                    <img src="@TinhToan.HinhAnhUrl(i.hinhAnh)" style="width:40px;height:40px;border-radius:10px;object-fit:cover;" alt="@i.tenMonAn" onerror="this.src='/Source/Home/img/pizza.jpg'" />
                                                    <div>
                                                        <div style="font-weight:600;">@i.tenMonAn</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td style="padding:10px 8px;color:#888;font-size:13px;">@i.tenDanhMuc</td>
                                            <td style="padding:10px 8px;text-align:center;font-weight:600;">@i.soLuongBanDuoc</td>
                                            <td style="padding:10px 8px;text-align:center;">
                                                @if (i.soDanhGia > 0)
                                                {
                                                    <span style="color:#f39c12;">
                                                        @for (int s = 1; s <= 5; s++)
                                                        {
                                                            <span style="font-size:12px;">@(s <= i.diemDanhGia ? "★" : "☆")</span>
                                                        }
                                                        <span style="color:#888;font-size:11px;margin-left:4px;">(@i.soDanhGia)</span>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span style="color:#ccc;font-size:12px;">Chua co</span>
                                                }
                                            </td>
                                            <td style="padding:10px 8px;text-align:right;font-weight:600;color:var(--fs-green);">@(i.giaTien?.ToString("N0") ?? "-")d</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
