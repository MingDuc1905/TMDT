@using ShipFood.Models
@inject ShipFood.Models.dbFoodyEntities _db
@{
    var userJson = Context.Session.GetString("user");
    ShipFood.Models.tbUser? user = userJson != null ? JsonSerializer.Deserialize<tbUser>(userJson) : null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Fastship — Khám phá & đặt món, giao tận nơi tại TP.HCM</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta name="keywords" content="đặt đồ ăn, giao thức ăn, quán ăn Sài Gòn, Fastship" />
    <meta name="description" content="Fastship — nền tảng đặt món và giao hàng nhanh tại TP. Hồ Chí Minh. Hàng trăm quán ăn, giao trong 30 phút." />
    <link href="~/Source/Home/css/chat.css" rel="stylesheet" />
    <!-- Favicon -->
    <link href="~/Source/Home/img/favicon.ico" rel="icon" />

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Roboto:wght@400;500&display=swap" rel="stylesheet" />

    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet" />

    <!-- Libraries Stylesheet -->
    <link href="~/Source/Home/lib/animate/animate.min.css" rel="stylesheet" />
    <link href="~/Source/Home/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet" />

    <!-- Customized Bootstrap Stylesheet -->
    <link href="~/Source/Home/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Template Stylesheet -->
    <link href="~/Source/Home/css/style.css" rel="stylesheet" />

    <!-- Sweetgreen-inspired overrides -->
    <link href="~/Source/Home/css/layout-sg.css" rel="stylesheet" />

    @RenderSection("styles", required: false)
</head>

<body>
    <!-- Skeleton Loading (replaces old spinner) -->
    <div id="fs-loading-skeleton" class="fs-skeleton-overlay" aria-hidden="true">
        <div class="fs-skel-header">
            <div class="fs-skel-logo fs-skeleton"></div>
            <div class="fs-skel-search fs-skeleton"></div>
            <div class="fs-skel-nav fs-skeleton"></div>
        </div>
        <div class="fs-skel-hero">
            <div class="fs-skel-hero-img fs-skeleton"></div>
            <div class="fs-skel-hero-text">
                <div class="fs-skeleton" style="height:24px;width:60%;margin-bottom:12px"></div>
                <div class="fs-skeleton" style="height:16px;width:40%"></div>
            </div>
        </div>
        <div class="fs-skel-cards">
            <div class="fs-skel-card fs-skeleton"></div>
            <div class="fs-skel-card fs-skeleton"></div>
            <div class="fs-skel-card fs-skeleton"></div>
            <div class="fs-skel-card fs-skeleton"></div>
        </div>
    </div>
    <!-- Skeleton End -->

    <!-- ===== NAVBAR ===== -->
    <header class="fs-header" id="fsHeader">
        <!-- Top info bar (desktop only) -->
        <div class="fs-topbar d-none d-lg-block">
            <div class="container-fluid px-5">
                <div class="row align-items-center">
                    <div class="col-lg-6 text-start">
                        <small><i class="fa fa-map-marker-alt me-1"></i>48 Cao Thắng, Quận 3, TP. Hồ Chí Minh</small>
                        <small class="ms-4"><i class="fa fa-envelope me-1"></i>fastship@contact.com</small>
                    </div>
                    <div class="col-lg-6 text-end">
                        <small class="me-2">Theo dõi chúng tôi:</small>
                        <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="ms-3" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                        <a href="#" class="ms-3" aria-label="TikTok"><i class="fab fa-tiktok"></i></a>
                        <a href="#" class="ms-3" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main nav -->
        <nav class="fs-nav navbar navbar-expand-lg navbar-light" aria-label="Điều hướng chính">
            <div class="container-fluid px-3 px-lg-5">
                <!-- Logo -->
                <a href="/Home" class="navbar-brand fs-logo" aria-label="Fastship trang chủ">
                    <span class="logo-f">F</span><span class="logo-ast">ast</span><span class="logo-ship">ship</span>
                </a>

                <!-- Mobile right: cart + toggler -->
                <div class="d-flex d-lg-none align-items-center ms-auto gap-2 me-2">
                    <a class="fs-cart-btn" href="/Cart" aria-label="Giỏ hàng">
                        <i class="fa fa-shopping-bag"></i>
                    </a>
                    <button type="button" class="navbar-toggler border-0" data-bs-toggle="collapse" data-bs-target="#navbarCollapse" aria-controls="navbarCollapse" aria-expanded="false" aria-label="Mở menu">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                </div>

                <!-- Search (visible inline on desktop) -->
                @{
                    var selectedIdDM = ViewBag.idDM as int?;
                    List<tbDanhMuc> allDanhMuc = new List<tbDanhMuc>();
                    try { allDanhMuc = _db.tbDanhMuc.ToList(); } catch { /* DB unavailable — skip category filter */ }
                }
                <div class="fs-search-wrap d-none d-lg-flex">
                    <form action="/Home" method="get" class="fs-search-form" role="search" aria-label="Tìm quán ăn">
                        <select name="idDM" aria-label="Chọn danh mục">
                            <option value="">Tất cả</option>
                            @foreach (var item in allDanhMuc)
                            {
                                if (selectedIdDM.HasValue && selectedIdDM.Value == item.madanhmuc)
                                {
                                    <option value="@item.madanhmuc" selected>@item.tendanhmuc</option>
                                }
                                else
                                {
                                    <option value="@item.madanhmuc">@item.tendanhmuc</option>
                                }
                            }
                        </select>
                        <input type="text" value="@ViewBag.txtSearch" name="txtSearch" placeholder="Tìm quán ăn, món ăn..." aria-label="Từ khoá tìm kiếm" />
                        <button type="submit" aria-label="Tìm kiếm"><i class="fa fa-search me-1"></i>Tìm</button>
                    </form>
                </div>

                <!-- Collapse menu -->
                <div class="collapse navbar-collapse" id="navbarCollapse">
                    <!-- Mobile search inside collapse -->
                    <div class="d-lg-none px-2 py-2">
                        <form action="/Home" method="get" class="fs-search-form-mobile" role="search">
                            <div class="input-group">
                                <select name="idDM" class="form-select form-select-sm fs-select-mobile" aria-label="Danh mục">
                                    <option value="">Tất cả</option>
                                    @foreach (var item in allDanhMuc)
                                    {
                                        if (selectedIdDM.HasValue && selectedIdDM.Value == item.madanhmuc)
                                        {
                                            <option value="@item.madanhmuc" selected>@item.tendanhmuc</option>
                                        }
                                        else
                                        {
                                            <option value="@item.madanhmuc">@item.tendanhmuc</option>
                                        }
                                    }
                                </select>
                                <input type="text" value="@ViewBag.txtSearch" name="txtSearch" class="form-control form-control-sm" placeholder="Tìm quán ăn..." />
                                <button type="submit" class="btn btn-success btn-sm px-3"><i class="fa fa-search"></i></button>
                            </div>
                        </form>
                    </div>

                    <!-- Nav links -->
                    <div class="navbar-nav ms-auto p-2 p-lg-0 align-items-lg-center">
                        <a href="/Home" class="nav-item nav-link">Trang chủ</a>
                        <a href="/Home/DanhMuc" class="nav-item nav-link">Menu ẩm thực</a>

                        @if (user != null)
                        {
                            <div class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-1" href="#" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="fs-avatar-xs">@user.username.Substring(0,1).ToUpper()</span>
                                    <span class="d-none d-lg-inline">@user.username</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><span class="dropdown-item-text text-muted small">Xin chào, <strong>@user.username</strong></span></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" href="/Cart/LichSuDatHang"><i class="fa fa-history me-2 text-muted"></i>Lịch sử đơn hàng</a></li>
                                    @if (user.loaitaikhoan.Equals("Quán ăn"))
                                    {
                                        <li><a class="dropdown-item" href="/Restaurant"><i class="fa fa-store me-2 text-muted"></i>Quản lý quán</a></li>
                                    }
                                    <li><a class="dropdown-item text-danger" href="/Home/Logout"><i class="fa fa-sign-out-alt me-2"></i>Đăng xuất</a></li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <div class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fa fa-user me-1"></i><span class="d-lg-none">Tài khoản</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" href="/Home/Login"><i class="fa fa-sign-in-alt me-2 text-muted"></i>Đăng nhập</a></li>
                                    <li><a class="dropdown-item" href="/Home/Signup"><i class="fa fa-user-plus me-2 text-muted"></i>Đăng ký</a></li>
                                </ul>
                            </div>
                        }

                        <a class="fs-cart-btn d-none d-lg-flex ms-2" href="/Cart" aria-label="Giỏ hàng">
                            <i class="fa fa-shopping-bag"></i>
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <!-- ===== END NAVBAR ===== -->

    <!-- Main content -->
    <main id="main-content">
        @RenderBody()
    </main>

    <!-- ===== FOOTER sweetgreen-style ===== -->
    <footer class="fs-footer">
        <!-- Newsletter band -->
        <div class="fs-footer-newsletter">
            <div class="container">
                <div class="row align-items-center justify-content-between gy-3">
                    <div class="col-md-6">
                        <h5 class="mb-1 fw-700">Nhận ưu đãi & thực đơn mới nhất</h5>
                        <p class="mb-0 text-muted small">Đăng ký để không bỏ lỡ món mới, khuyến mãi hấp dẫn.</p>
                    </div>
                    <div class="col-md-6">
                        <form class="fs-newsletter-form" novalidate>
                            <div class="input-group">
                                <input type="email" class="form-control" placeholder="Email của bạn..." aria-label="Email đăng ký nhận tin" required />
                                <button class="btn btn-success" type="submit">Đăng ký</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer grid -->
        <div class="fs-footer-main">
            <div class="container">
                <div class="row gy-4">
                    <!-- Brand -->
                    <div class="col-lg-3 col-md-6">
                        <a href="/Home" class="fs-logo mb-3 d-inline-block">
                            <span class="logo-f">F</span><span class="logo-ast">ast</span><span class="logo-ship">ship</span>
                        </a>
                        <p class="small text-muted mb-3">Nền tảng đặt món và giao hàng nhanh tại TP. Hồ Chí Minh. Hàng trăm quán ăn ngon, giao trong 30 phút.</p>
                        <div class="fs-social-links">
                            <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                            <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                            <a href="#" aria-label="TikTok"><i class="fab fa-tiktok"></i></a>
                            <a href="#" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
                        </div>
                    </div>

                    <!-- Khám phá -->
                    <div class="col-lg-2 col-md-3 col-6">
                        <h6 class="fs-footer-heading">Khám phá</h6>
                        <ul class="list-unstyled fs-footer-links">
                            <li><a href="/Home">Trang chủ</a></li>
                            <li><a href="/Home/DanhMuc">Menu ẩm thực</a></li>
                            <li><a href="/Cart">Giỏ hàng</a></li>
                            <li><a href="/Cart/LichSuDatHang">Lịch sử đơn</a></li>
                        </ul>
                    </div>

                    <!-- Tài khoản -->
                    <div class="col-lg-2 col-md-3 col-6">
                        <h6 class="fs-footer-heading">Tài khoản</h6>
                        <ul class="list-unstyled fs-footer-links">
                            @if (user == null)
                            {
                                <li><a href="/Home/Login">Đăng nhập</a></li>
                                <li><a href="/Home/Signup">Đăng ký</a></li>
                            }
                            else
                            {
                                <li><a href="/Cart/LichSuDatHang">Đơn hàng của tôi</a></li>
                                <li><a href="/Home/Logout">Đăng xuất</a></li>
                            }
                        </ul>
                    </div>

                    <!-- Hỗ trợ -->
                    <div class="col-lg-2 col-md-3 col-6">
                        <h6 class="fs-footer-heading">Hỗ trợ</h6>
                        <ul class="list-unstyled fs-footer-links">
                            <li><a href="/Home/Contact">Liên hệ</a></li>
                            <li><a href="/Home/About">Về chúng tôi</a></li>
                            <li><a href="#">Chính sách bảo mật</a></li>
                            <li><a href="#">Điều khoản sử dụng</a></li>
                        </ul>
                    </div>

                    <!-- Liên hệ -->
                    <div class="col-lg-3 col-md-3 col-6">
                        <h6 class="fs-footer-heading">Liên hệ</h6>
                        <ul class="list-unstyled fs-footer-links fs-contact-list">
                            <li><i class="fa fa-map-marker-alt"></i>48 Cao Thắng, Quận 3, TP. Hồ Chí Minh</li>
                            <li><i class="fa fa-phone-alt"></i><a href="tel:19001234">1900 1234</a></li>
                            <li><i class="fa fa-envelope"></i><a href="mailto:fastship@contact.com">fastship@contact.com</a></li>
                            <li><i class="fa fa-clock"></i>7:00 — 23:00, Thứ 2 — Chủ nhật</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer bottom bar -->
        <div class="fs-footer-bottom">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-md-6 text-center text-md-start">
                        <small>&copy; @DateTime.Now.Year Fastship. Bảo lưu mọi quyền.</small>
                    </div>
                    <div class="col-md-6 text-center text-md-end mt-2 mt-md-0">
                        <small>Được làm với <i class="fa fa-heart text-danger"></i> tại Sài Gòn &nbsp;|&nbsp;
                            <a href="#">Chính sách bảo mật</a> &nbsp;|&nbsp;
                            <a href="#">Điều khoản</a>
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </footer>
    <!-- ===== END FOOTER ===== -->

    <!-- Back to top -->
    <a href="#" class="btn btn-success back-to-top" aria-label="Lên đầu trang"><i class="fa fa-angle-up"></i></a>

    <!-- JavaScript Libraries -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Source/Home/lib/wow/wow.min.js"></script>
    <script src="~/Source/Home/lib/easing/easing.min.js"></script>
    <script src="~/Source/Home/lib/waypoints/waypoints.min.js"></script>
    <script src="~/Source/Home/lib/owlcarousel/owl.carousel.min.js"></script>

    <!-- Template Javascript -->
    <script src="~/Source/Home/js/main.js"></script>
    @RenderSection("scripts", required: false)

    <!-- ─── Task 2d: Search Autocomplete Debounce 300ms ─── -->
    <script>
    (function() {
        var searchInput = document.querySelector('input[name="txtSearch"]');
        var searchForm = document.querySelector('.fs-search-form');
        if (!searchInput || !searchForm) return;

        var debounceTimer;
        var autocompleteBox = document.createElement('div');
        autocompleteBox.className = 'fs-autocomplete';
        autocompleteBox.style.cssText = 'position:absolute;top:100%;left:0;right:0;background:#fff;border:1px solid #e5e7eb;border-radius:0 0 12px 12px;box-shadow:0 8px 24px rgba(0,0,0,0.1);z-index:9999;display:none;max-height:360px;overflow-y:auto;';
        searchForm.style.position = 'relative';
        searchForm.appendChild(autocompleteBox);

        searchInput.addEventListener('input', function() {
            clearTimeout(debounceTimer);
            var q = this.value.trim();
            if (q.length < 2) { autocompleteBox.style.display = 'none'; return; }

            debounceTimer = setTimeout(function() {
                $.ajax({
                    url: '/Home/SearchAutocomplete',
                    type: 'GET',
                    data: { q: q },
                    success: function(res) {
                        if (!res || !res.length) {
                            autocompleteBox.style.display = 'none';
                            return;
                        }
                        autocompleteBox.innerHTML = '';
                        res.forEach(function(item) {
                            var a = document.createElement('a');
                            a.href = '/Home/DetailRestaurant/' + item.id;
                            a.className = 'd-flex align-items-center gap-3 px-3 py-2 text-decoration-none';
                            a.style.cssText = 'display:flex;align-items:center;gap:12px;padding:8px 16px;text-decoration:none;color:#333;border-bottom:1px solid #f0f0f0;transition:background .15s;';
                            a.onmouseenter = function(){ this.style.background = '#f5f6fa'; };
                            a.onmouseleave = function(){ this.style.background = ''; };
                            a.innerHTML = '<div style="width:40px;height:40px;border-radius:8px;overflow:hidden;flex-shrink:0;background:#eee;display:flex;align-items:center;justify-content:center;font-size:18px;">' + (item.icon || '🍽') + '</div>'
                                + '<div style="flex:1;min-width:0">'
                                + '<div style="font-size:14px;font-weight:600;color:#111;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + escHtml(item.name) + '</div>'
                                + '<div style="font-size:12px;color:#888;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + escHtml(item.address || '') + '</div>'
                                + '</div>'
                                + '<span style="font-size:13px;color:#3CB815;font-weight:600;white-space:nowrap;">' + (item.rating || '') + '</span>';
                            autocompleteBox.appendChild(a);
                        });
                        autocompleteBox.style.display = 'block';
                    },
                    error: function() { autocompleteBox.style.display = 'none'; }
                });
            }, 300); // ─── 300ms debounce ───
        });

        // Hide on click outside
        document.addEventListener('click', function(e) {
            if (!searchForm.contains(e.target)) autocompleteBox.style.display = 'none';
        });

        // Hide on form submit
        searchForm.addEventListener('submit', function() { autocompleteBox.style.display = 'none'; });

        function escHtml(str) {
            if (!str) return '';
            var d = document.createElement('div'); d.textContent = str; return d.innerHTML;
        }
    })();
    </script>

    <!-- Chat Widget -->
    @await Html.PartialAsync("_ChatWidget")
</body>
</html>
