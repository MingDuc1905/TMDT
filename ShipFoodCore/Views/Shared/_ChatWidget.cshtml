@{
    var userJson = Context.Session.GetString("user");
    ShipFood.Models.tbUser? user = userJson != null ? JsonSerializer.Deserialize<tbUser>(userJson) : null;
    var loggedIn = user != null && user.userid > 0;
}

<style>
.chat-toggle {
    position: fixed; bottom: 24px; right: 24px; z-index: 9999;
    width: 56px; height: 56px; border-radius: 50%;
    background: var(--fs-green, #3CB815); color: #fff; border: none; cursor: pointer;
    box-shadow: 0 4px 16px rgba(60,184,21,0.35);
    display: flex; align-items: center; justify-content: center;
    font-size: 24px; transition: transform .2s, box-shadow .2s;
    font-family: var(--fs-font, 'Inter', sans-serif);
}
.chat-toggle:hover { transform: scale(1.08); box-shadow: 0 6px 24px rgba(60,184,21,0.45); }
.chat-toggle .badge {
    position: absolute; top: -4px; right: -4px;
    background: #e74c3c; color: #fff; border-radius: 50%;
    width: 20px; height: 20px; font-size: 11px; display: flex;
    align-items: center; justify-content: center; border: 2px solid #fff;
}

.chat-box {
    position: fixed; bottom: 96px; right: 24px; z-index: 9998;
    width: 360px; max-height: 520px; background: #fff;
    border-radius: var(--fs-radius, 12px); box-shadow: 0 8px 40px rgba(0,0,0,0.12);
    flex-direction: column; overflow: hidden;
    font-family: var(--fs-font, 'Inter', sans-serif);
    display: none;
}
.chat-box.active {
    display: flex;
}

.chat-box-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 16px;
    background: linear-gradient(135deg, var(--fs-green, #3CB815), var(--fs-green-dark, #2ea310));
    color: #fff;
}
.chat-box-header h6 { margin: 0; font-size: 14px; font-weight: 600; font-family: var(--fs-font, 'Inter', sans-serif); }
.chat-box-header small { font-size: 11px; opacity: .8; font-family: var(--fs-font, 'Inter', sans-serif); }
.chat-box-header .close-btn { cursor: pointer; font-size: 20px; opacity: .7; transition: opacity .15s; }
.chat-box-header .close-btn:hover { opacity: 1; }

.chat-tabs {
    display: flex; background: var(--fs-light, #f8f9fa); border-bottom: 1px solid var(--fs-border, #e5e7eb);
}
.chat-tab {
    flex: 1; padding: 10px; text-align: center; cursor: pointer;
    font-size: 13px; font-weight: 500; color: var(--fs-muted, #6b7280);
    border-bottom: 2px solid transparent; transition: all .2s;
    background: none; border-top: 0; border-left: 0; border-right: 0; position: relative;
    font-family: var(--fs-font, 'Inter', sans-serif);
}
.chat-tab:hover { color: var(--fs-dark, #1a1a2e); }
.chat-tab.active { color: var(--fs-green, #3CB815); border-bottom-color: var(--fs-green, #3CB815); background: #fff; }
.chat-tab .tab-badge {
    position: absolute; top: 4px; right: 20%;
    background: #e74c3c; color: #fff; border-radius: 50%;
    width: 18px; height: 18px; font-size: 10px; display: none;
    align-items: center; justify-content: center; font-weight: 600;
}
.chat-tab .tab-badge.show { display: flex; }

.chat-section { display: none; flex-direction: column; flex: 1; }
.chat-section.active { display: flex; }

.chat-msgs {
    flex: 1; overflow-y: auto; padding: 12px 14px;
    background: var(--fs-light-soft, #f3f4f6); min-height: 200px; max-height: 280px;
}
.chat-msgs::-webkit-scrollbar { width: 4px; }
.chat-msgs::-webkit-scrollbar-thumb { background: rgba(0,0,0,.12); border-radius: 4px; }
.chat-msgs .msg {
    margin-bottom: 8px; max-width: 88%;
    padding: 8px 12px; border-radius: 12px;
    font-size: 13px; line-height: 1.5; word-wrap: break-word;
    font-family: var(--fs-font, 'Inter', sans-serif);
}
.chat-msgs .msg.bot, .chat-msgs .msg.admin {
    background: #fff; border: 1px solid var(--fs-border, #e5e7eb);
    margin-right: auto; color: var(--fs-dark, #1a1a2e);
}
.chat-msgs .msg.user, .chat-msgs .msg.customer {
    background: var(--fs-green, #3CB815); color: #fff; margin-left: auto;
}
.chat-msgs .msg .label {
    font-size: 10px; opacity: .65; display: block; margin-bottom: 2px;
}
.chat-msgs .msg .quick-btn {
    display: inline-block; padding: 4px 10px; margin: 2px;
    background: var(--fs-green-bg, rgba(60,184,21,.07)); color: var(--fs-green, #3CB815);
    border: 1px solid rgba(60,184,21,.2); border-radius: 16px; cursor: pointer;
    font-size: 11px; font-weight: 500; transition: all .15s;
}
.chat-msgs .msg .quick-btn:hover { background: var(--fs-green, #3CB815); color: #fff; }
.chat-msgs .msg .msg-time {
    font-size: 10px; color: var(--fs-muted-soft, #9ca3af); margin-top: 4px; display: block;
}
.chat-msgs .msg.customer .msg-time { color: rgba(255,255,255,0.6); }

.chat-input {
    display: flex; padding: 10px 12px; background: #fff;
    border-top: 1px solid var(--fs-border, #e5e7eb); gap: 6px;
}
.chat-input input {
    flex: 1; border: 1.5px solid var(--fs-border, #e5e7eb); border-radius: 20px;
    padding: 8px 14px; outline: none; font-size: 13px;
    font-family: var(--fs-font, 'Inter', sans-serif);
    transition: border-color .2s;
}
.chat-input input:focus { border-color: var(--fs-green, #3CB815); }
.chat-input button {
    background: var(--fs-green, #3CB815); color: #fff; border: none;
    border-radius: 50%; width: 36px; height: 36px;
    cursor: pointer; display: flex; align-items: center;
    justify-content: center; font-size: 13px; flex-shrink: 0;
    transition: background .2s;
}
.chat-input button:hover { background: var(--fs-green-dark, #2ea310); }
.chat-input button:disabled { background: var(--fs-muted-soft, #9ca3af); cursor: default; }

.chat-typing {
    display: flex; gap: 4px; padding: 8px 12px; background: #fff;
    border-radius: 12px; border: 1px solid var(--fs-border, #e5e7eb);
    margin-bottom: 8px; width: fit-content;
}
.chat-typing span {
    width: 6px; height: 6px; background: var(--fs-green, #3CB815); border-radius: 50%;
    animation: fsTyping 1.4s infinite ease-in-out;
}
.chat-typing span:nth-child(2) { animation-delay: .2s; }
.chat-typing span:nth-child(3) { animation-delay: .4s; }
@@keyframes fsTyping {
    0%,60%,100% { opacity: .3; transform: scale(.8); }
    30% { opacity: 1; transform: scale(1.1); }
}

.chat-login-msg {
    text-align: center; padding: 30px 16px; color: var(--fs-muted-soft, #9ca3af); font-size: 14px;
    font-family: var(--fs-font, 'Inter', sans-serif);
}
.chat-login-msg a { color: var(--fs-green, #3CB815); font-weight: 600; }

.admin-order-select {
    padding: 8px 12px; background: var(--fs-light, #f8f9fa); border-bottom: 1px solid var(--fs-border, #e5e7eb);
}
.admin-order-select select {
    width: 100%; padding: 6px 10px; border: 1.5px solid var(--fs-border, #e5e7eb);
    border-radius: 8px; font-size: 12px; outline: none;
    font-family: var(--fs-font, 'Inter', sans-serif);
    transition: border-color .2s;
}
.admin-order-select select:focus { border-color: var(--fs-green, #3CB815); }
.admin-status {
    padding: 4px 12px; font-size: 11px; color: var(--fs-muted, #6b7280);
    background: var(--fs-green-bg, rgba(60,184,21,.07)); border-bottom: 1px solid var(--fs-border, #e5e7eb);
    display: flex; align-items: center; gap: 6px;
}
.admin-status .dot {
    width: 6px; height: 6px; background: var(--fs-green, #3CB815); border-radius: 50%;
    display: inline-block; animation: fsPulse 1.5s infinite;
}
@@keyframes fsPulse {
    0%,100% { opacity: 1; }
    50% { opacity: .4; }
}
</style>

<button class="chat-toggle" id="chatToggle" aria-label="Mở chat hỗ trợ FastShip" title="Chat hỗ trợ">
    <i class="fas fa-comment-dots" aria-hidden="true"></i>
    <span class="badge" id="chatBadge" style="display:none;" aria-hidden="true">0</span>
</button>

<div class="chat-box" id="chatBox">
    <div class="chat-box-header">
        <div>
            <h6><i class="fas fa-comment me-1"></i>FastShip</h6>
            <small>Trực tuyến 24/7</small>
        </div>
        <span class="close-btn close-chat">&times;</span>
    </div>

    <div class="chat-tabs">
        <button class="chat-tab active" id="tabAi" onclick="switchTab('ai')">AI Chat</button>
        @if (loggedIn) {
            <button class="chat-tab" id="tabAdmin" onclick="switchTab('admin')">
                Hỗ trợ
                <span class="tab-badge" id="adminTabBadge">0</span>
            </button>
        }
    </div>

    <!-- AI Chat -->
    <div class="chat-section active" id="sectionAi">
        <div class="chat-msgs" id="aiMsgs">
            <div class="msg bot">👋 Chào bạn! Tôi là trợ lý FastShip. Có thể giúp gì cho bạn?</div>
        </div>
        <div class="chat-input">
            @Html.AntiForgeryToken()
            <input type="text" id="aiInput" placeholder="Nhập tin nhắn..." onkeypress="if(event.key==='Enter') sendAi()" />
            <button id="aiBtn" onclick="sendAi()"><i class="fas fa-paper-plane"></i></button>
        </div>
    </div>

    <!-- Admin Chat -->
    <div class="chat-section" id="sectionAdmin">
        @if (loggedIn) {
            <div class="admin-status">
                <span class="dot"></span> Đã kết nối với hỗ trợ viên
            </div>
            <div class="admin-order-select">
                <select id="adminOrderSelect" onchange="joinAdminChat()">
                    <option value="0">-- Yêu cầu hỗ trợ chung --</option>
                </select>
            </div>
            <div class="chat-msgs" id="adminMsgs">
                <div class="msg admin"><span class="label">FastShip</span>Chào bạn! Chọn đơn hàng hoặc gửi yêu cầu chung, admin sẽ trả lời sớm.</div>
            </div>
            <div class="chat-input">
                <input type="text" id="adminInput" placeholder="Nhập tin nhắn..." onkeypress="if(event.key==='Enter') sendAdmin()" />
                <button id="adminBtn" onclick="sendAdmin()"><i class="fas fa-paper-plane"></i></button>
            </div>
        } else {
            <div class="chat-login-msg">
                <i class="fas fa-lock" style="font-size:28px;opacity:.25;margin-bottom:10px"></i><br/>
                <a href="~/Home/Login">Đăng nhập</a> để chat với hỗ trợ viên
            </div>
        }
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script>
    var currentTab = 'ai';
    function switchTab(tab) {
        currentTab = tab;
        document.querySelectorAll('.chat-tab').forEach(function(t){t.classList.remove('active');});
        document.querySelectorAll('.chat-section').forEach(function(s){s.classList.remove('active');});
        document.getElementById('tab' + tab.charAt(0).toUpperCase() + tab.slice(1)).classList.add('active');
        document.getElementById('section' + tab.charAt(0).toUpperCase() + tab.slice(1)).classList.add('active');
        
        if (tab === 'admin') {
            // Clear badge khi mở tab admin
            document.getElementById('adminTabBadge').classList.remove('show');
            document.getElementById('adminTabBadge').textContent = '0';
            // Load l?ch s? tin nh?n
            loadMyMessages();
            if (!adminConn || adminConn.state === 'Disconnected') connectAdmin();
        }
    }

    // ─── SỬA DỨT ĐIỂM LỖI KẸT CHAT: Event Delegation + class .active ───
    $(document).ready(function() {
        // Dùng event delegation trên document để bọc toàn bộ
        $(document).on('click', '.chat-toggle', function(e) {
            e.stopPropagation();
            $('#chatBox').addClass('active');
            $(this).fadeOut(100);
            // Clear badge
            var badge = document.getElementById('chatBadge');
            if (badge) badge.style.display = 'none';
            if (currentTab === 'admin') {
                var adminBadge = document.getElementById('adminTabBadge');
                if (adminBadge) { adminBadge.classList.remove('show'); adminBadge.textContent = '0'; }
            }
        });

        $(document).on('click', '.close-chat, .chat-box-header .close-btn', function(e) {
            e.stopPropagation();
            $('#chatBox').removeClass('active');
            $('.chat-toggle').fadeIn(100);
        });

        // Click outside chat box → đóng (trừ khi click vào toggle)
        $(document).on('click', function(e) {
            var $box = $('#chatBox');
            if (!$box.hasClass('active')) return;
            var $toggle = $('.chat-toggle');
            if (!$box[0].contains(e.target) && !$toggle[0].contains(e.target)) {
                $box.removeClass('active');
                $toggle.fadeIn(100);
            }
        });
    });

    // ====== AI Chat ======
    function getToken() { return $('input[name="__RequestVerificationToken"]').val(); }

    function sendAi() {
        var input = document.getElementById('aiInput');
        var msg = input.value.trim();
        if (!msg) return;
        addMsg('aiMsgs', msg, 'user');
        input.value = '';
        document.getElementById('aiBtn').disabled = true;
        showTyping('aiMsgs');
        $.ajax({
            url: '@Url.Action("SendMessage", "Chatbot")', type: 'POST', data: { message: msg },
            headers: { 'RequestVerificationToken': getToken() },
            success: function(r) { hideTyping(); addBotMsg(r.reply, r.quickReplies); },
            error: function() { hideTyping(); addMsg('aiMsgs', '❌ Lỗi, vui lòng thử lại.', 'bot'); },
            complete: function() { document.getElementById('aiBtn').disabled = false; }
        });
    }

    function addMsg(containerId, text, type) {
        var c = document.getElementById(containerId);
        var d = document.createElement('div'); d.className = 'msg ' + type;
        var time = new Date().toLocaleTimeString('vi-VN', {hour:'2-digit',minute:'2-digit'});
        d.innerHTML = escHtml(text).replace(/\n/g, '<br/>') + '<span class="msg-time">' + time + '</span>';
        c.appendChild(d); c.scrollTop = c.scrollHeight;
    }

    function addBotMsg(text, quickReplies) {
        hideTyping();
        var c = document.getElementById('aiMsgs');
        var d = document.createElement('div'); d.className = 'msg bot';
        var formatted = escHtml(text).replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>').replace(/\n/g, '<br/>');
        d.innerHTML = formatted;
        if (quickReplies && quickReplies.length) {
            var wrap = document.createElement('div'); wrap.style.marginTop = '6px';
            quickReplies.forEach(function(q){
                var b = document.createElement('span'); b.className = 'quick-btn';
                b.textContent = q; b.onclick = function(){ document.getElementById('aiInput').value=q; sendAi(); };
                wrap.appendChild(b);
            });
            d.appendChild(wrap);
        }
        c.appendChild(d); c.scrollTop = c.scrollHeight;
    }

    function showTyping(containerId) {
        var c = document.getElementById(containerId);
        var d = document.createElement('div'); d.className = 'chat-typing'; d.id = 'typing';
        for (var i=0;i<3;i++) d.appendChild(document.createElement('span'));
        c.appendChild(d); c.scrollTop = c.scrollHeight;
    }
    function hideTyping() { var e = document.getElementById('typing'); if(e) e.remove(); }

    // ====== Admin Chat ======
    var adminConn = null, adminUserId = @(loggedIn ? user!.userid : 0), adminOrderId = 0, adminConnPromise = null;
    var adminName = '@(loggedIn ? user!.username : "")';

    @if (loggedIn) {
    <text>
    $.ajax({
        url: '@Url.Action("GetUserOrders", "AdminChat")', type: 'GET',
        success: function(orders) {
            var sel = document.getElementById('adminOrderSelect');
            if (orders && orders.length) orders.forEach(function(o){
                var opt = document.createElement('option'); opt.value = o.madh;
                opt.textContent = '#' + o.madh + ' - ' + (o.tenquanan || '') + ' - ' + (o.tongtien ? Number(o.tongtien).toLocaleString() : '0') + 'đ';
                sel.appendChild(opt);
            });
        }
    });

    // L?ng nghe s? ki?n unreadCountUpdate real-time t? SignalR hub
    // (listener ???c d?ng ký trong connectAdmin() d??i dây, sau khi adminConn ???c kh?i t?o)
    // Check l?n ??u khi load (AJAX, không c?n SignalR)
    initUnreadCheck();
    </text>
    }

    // Hàm hi?n badge khi có tin nh?n m?i (tách riêng ?? tái s? d?ng)
    function showMsgBadge() {
        if (currentTab !== 'admin') {
            var badge = document.getElementById('adminTabBadge');
            var cur = parseInt(badge.textContent) || 0;
            badge.textContent = cur + 1 > 9 ? '9+' : cur + 1;
            badge.classList.add('show');
            document.getElementById('chatBadge').textContent = cur + 1 > 9 ? '9+' : cur + 1;
            document.getElementById('chatBadge').style.display = 'flex';
        }
    }

    function updateBadgeCount(count) {
        count = count || 0;
        if (currentTab !== 'admin' && count > 0) {
            document.getElementById('adminTabBadge').textContent = count > 9 ? '9+' : count;
            document.getElementById('adminTabBadge').classList.add('show');
            document.getElementById('chatBadge').textContent = count > 9 ? '9+' : count;
            document.getElementById('chatBadge').style.display = 'flex';
        }
    }

    // Hàm ki?m tra l?n ??u (không dùng polling)
    function initUnreadCheck() {
        if (adminUserId <= 0) return;
        $.ajax({
            url: '@Url.Action("GetUnreadCount", "AdminChat")', type: 'GET',
            success: function(res) { updateBadgeCount(res.count || 0); }
        });
    }
    window.initUnreadCheck = initUnreadCheck;

    function connectAdmin() {
        if (adminConn && adminConn.state === 'Connected') return Promise.resolve();
        if (adminConnPromise) return adminConnPromise;
        adminConn = new signalR.HubConnectionBuilder().withUrl('/nhantin').withAutomaticReconnect().build();

        // ═══ Nh?n tin nh?n t? Admin ═══
        adminConn.on('adminMessage', function(msg, orderId, sender) {
            if (orderId === adminOrderId || (orderId === 0 && adminOrderId === 0)) {
                addMsg('adminMsgs', msg, 'admin');
            }
            showMsgBadge();
        });

        // ═══ Nh?n tin nh?n tr?c ti?p t? Shipper (qua SendDirectMessage) ═══
        adminConn.on('directMessage', function(msg, senderName, senderRole, connId) {
            if (senderRole === 'Shipper') {
                addMsg('adminMsgs', '📦 [Ship] ' + (senderName || 'Shipper') + ': ' + msg, 'admin');
            } else {
                addMsg('adminMsgs', msg, 'admin');
            }
            showMsgBadge();
        });

        // ═══ Nh?n tin nh?n t? Shipper (qua CustomerSendMessage API) ═══
        adminConn.on('shipperMessage', function(msg, orderId, senderName, shipperId) {
            if (orderId === adminOrderId || adminOrderId === 0) {
                addMsg('adminMsgs', '📦 ' + (senderName || 'Shipper') + ': ' + msg, 'admin');
            }
            showMsgBadge();
        });

        // ═══ Nh?n tin nh?n t? Customer (echo t? API) — b? qua tin c?a chính mình tránh double ═══
        adminConn.on('customerMessage', function(msg, orderId, senderName, customerId) {
            if (customerId === adminUserId) return; // tin c?a chính mình, ?ã hi?n local r?i
            if (orderId === adminOrderId || adminOrderId === 0) {
                addMsg('adminMsgs', msg, 'customer');
            }
        });

        // ═══ C?p nh?t s? tin ch?a ??c ═══
        adminConn.on('unreadCountUpdate', function(count) {
            updateBadgeCount(count);
        });

        adminConn.onclose(function(){ adminConnPromise = null; });
        adminConn.onreconnected(function(){ rejoinAdminGroup(); });

        adminConnPromise = adminConn.start().then(function(){
            return adminConn.invoke('JoinCustomerSupportGroup', adminUserId);
        }).then(function(){
            if (adminOrderId > 0) return adminConn.invoke('JoinOrderGroup', adminOrderId);
        }).catch(function(){});
        return adminConnPromise;
    }

    function rejoinAdminGroup() {
        if (!adminConn || adminConn.state !== 'Connected') return;
        adminConn.invoke('JoinCustomerSupportGroup', adminUserId).catch(function(){});
        if (adminOrderId > 0) adminConn.invoke('JoinOrderGroup', adminOrderId).catch(function(){});
    }

    function loadMyMessages() {
        if (adminUserId <= 0) return;
        $.ajax({
            url: '@Url.Action("GetMyMessages", "AdminChat")', type: 'GET',
            data: { orderId: adminOrderId },
            success: function(res) {
                if (!res.success) return;
                var container = document.getElementById('adminMsgs');
                container.innerHTML = '';
                if (!res.data || res.data.length === 0) {
                    addMsg('adminMsgs', adminOrderId > 0
                        ? '📦 Đang hỗ trợ đơn #' + adminOrderId + '. Admin sẽ trả lời sớm!'
                        : '💬 Gửi yêu cầu hỗ trợ chung. Admin sẽ trả lời sớm!', 'admin');
                } else {
                    res.data.forEach(function(msg) {
                        var roleClass = msg.sender === "Khách hàng" || msg.sender === "Shipper" ? "customer" : "admin";
                        var senderLabel = msg.sender === "Admin" ? "Admin" : "Bạn";
                        var c = document.getElementById('adminMsgs');
                        var d = document.createElement('div'); d.className = 'msg ' + roleClass;
                        d.innerHTML = '<span class="label">' + senderLabel + '</span>' + escHtml(msg.content).replace(/\n/g, '<br/>');
                        c.appendChild(d);
                    });
                    container.scrollTop = container.scrollHeight;
                }
            }
        });
    }

    function joinAdminChat() {
        var sel = document.getElementById('adminOrderSelect');
        adminOrderId = parseInt(sel.value);
        if (adminConn) {
            (function retry(){
                if (adminConn.state === 'Connected') {
                    adminConn.invoke('JoinCustomerSupportGroup', adminUserId).catch(function(){});
                    if (adminOrderId > 0) adminConn.invoke('JoinOrderGroup', adminOrderId).catch(function(){});
                } else setTimeout(retry, 500);
            })();
        }
        // Load l?ch s? tin nh?n cho order ?ã ch?n
        loadMyMessages();
    }

    function sendAdmin() {
        var input = document.getElementById('adminInput');
        var msg = input.value.trim();
        if (!msg) return;
        
        // Hi?n th? tin nh?n ngay l?p t?c
        var c = document.getElementById('adminMsgs');
        var d = document.createElement('div'); d.className = 'msg customer';
        var time = new Date().toLocaleTimeString('vi-VN', {hour:'2-digit',minute:'2-digit'});
        d.innerHTML = '<span class="label">Bạn</span>' + escHtml(msg).replace(/\n/g, '<br/>') + '<span class="msg-time">' + time + '</span>';
        c.appendChild(d); c.scrollTop = c.scrollHeight;
        
        input.value = ''; document.getElementById('adminBtn').disabled = true;
        
        var token = getToken();
        $.ajax({
            url: '@Url.Action("CustomerSendMessage", "AdminChat")', type: 'POST',
            data: { orderId: adminOrderId, message: msg, __RequestVerificationToken: token },
            headers: { 'RequestVerificationToken': token },
            success: function(r) {
                if (r && r.success === false) {
                    addMsg('adminMsgs', '⚠️ ' + (r.error || 'Không gửi được tin nhắn'), 'admin');
                }
            },
            error: function(xhr) {
                var errMsg = '❌ Lỗi gửi tin nhắn';
                try { var r = JSON.parse(xhr.responseText); if (r && r.error) errMsg = '❌ ' + r.error; } catch(e){}
                if (xhr.status === 403) errMsg = '❌ Phiên đăng nhập hết hạn. Vui lòng tải lại trang.';
                if (xhr.status === 0) errMsg = '❌ Mất kết nối mạng.';
                addMsg('adminMsgs', errMsg, 'admin');
            },
            complete: function(){ document.getElementById('adminBtn').disabled = false; }
        });
    }

    // ─── Refresh AntiForgeryToken ───
    function refreshAntiForgeryToken() {
        $.ajax({
            url: '@Url.Action("RefreshToken", "Home")', type: 'GET',
            success: function(r) {
                if (r && r.token) {
                    // Update token input value
                    $('input[name="__RequestVerificationToken"]').val(r.token);
                }
            }
        });
    }
    // Tự động refresh token mỗi 15 phút (trước khi token hết hạn ~20-30 phút)
    setInterval(refreshAntiForgeryToken, 15 * 60 * 1000);

    function escHtml(str) {
        if (!str) return '';
        var d = document.createElement('div'); d.textContent = str; return d.innerHTML;
    }
</script>
