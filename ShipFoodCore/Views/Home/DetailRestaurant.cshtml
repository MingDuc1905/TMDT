    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <span class="close" data-bs-dismiss="modal">x</span>
            <div class="modal-header txt-bold font13"><span class="txt-red">service_by_fastchip</span> Thông báo</div>
            <div class="modal-body"><p class="font15 max-width-750"></p></div>
            <div class="modal-footer content-right">
                <button type="button" class="btn btn-gray" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-red" data-bs-dismiss="modal">Ok</button>
            </div>
