                    </li>
                    <li>
                        <a class="has-arrow ai-icon" href="@Url.Action("WalletManager","Admin")" aria-expanded="false">
                            <span class="nav-text"><i class="fas fa-wallet"></i> Ví tiền</span>
                        </a>
                    </li>
                    <li>
                        <a class="has-arrow ai-icon" href="@Url.Action("Index","AdminChat")" aria-expanded="false">
