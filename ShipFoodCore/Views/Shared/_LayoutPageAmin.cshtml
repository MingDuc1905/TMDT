                        </a>
                    </li>
                </ul>

              
            </div>
        </div>
        <!--**********************************
              Sidebar end
          ***********************************-->
        <!--**********************************
              Content body start
          ***********************************-->
        @RenderBody()
        <!--**********************************
              Content body end
          ***********************************-->
    </div>
    <!--**********************************
        Main wrapper end
    ***********************************-->
    <!--**********************************
        Scripts
    ***********************************-->
    <!-- Required vendors -->
    <script src="~/Source/Admin/vendor/global/global.min.js"></script>
    <script src="~/Source/Admin/vendor/bootstrap-select/dist/js/bootstrap-select.min.js"></script>
    <script src="~/Source/Admin/vendor/chart.js/Chart.bundle.min.js"></script>
    <script src="~/Source/Restaurant/js/custom.min.js"></script>
