@{
    ViewBag.Title = "DetailRestaurant";
    Layout = "~/Views/Shared/_LayoutPageHome.cshtml";
}

@section styles {
    <link href="~/Source/Home/css/test_details.css" rel="stylesheet" />
    <link href="~/Source/Home/css/details.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/Source/Home/css/base.css" />
    <style>
        .app { max-width: 1200px; margin: 100px auto 0; padding: 0 16px; }
        .menu-restaurant-detail { width: 78%; }
        .item-restaurant-row { height: auto !important; margin-bottom: 20px; }
        .item-restaurant-more .row { flex-wrap: nowrap; align-items: center; }
        @@media (max-width: 768px) {
            .menu-restaurant-detail { width: 100%; }
            .now-menu-restaurant { width: 100% !important; }
            .item-restaurant-more .row { flex-direction: column; align-items: flex-start; }
            .app { margin-top: 80px; }
            .now-detail-restaurant .detail-restaurant-img { width: 100%; height: auto; float: none; }
            .now-detail-restaurant .detail-restaurant-info { width: 100%; float: none; padding: 16px 0; }
            .now-detail-restaurant .name-restaurant { font-size: 18px; white-space: normal; }
            .now-menu-restaurant .menu-restaurant-category { position: relative; width: 100%; margin-bottom: 12px; }
            .menu-restaurant-category .scrollbar-container { max-height: none; overflow-x: auto; display: flex; flex-wrap: nowrap; gap: 6px; padding: 4px 0; }
            .menu-restaurant-category .list-category .item { display: inline-block; white-space: nowrap; margin: 0; }
            .menu-restaurant-detail { width: 100%; padding: 6px 10px; }
            .item-restaurant-row .row { flex-direction: column; }
            .item-restaurant-row .item-restaurant-img { margin-bottom: 8px; }
            .item-restaurant-row .item-restaurant-info { width: 100%; }
            .item-restaurant-row .item-restaurant-name { font-size: 14px; }
            .item-restaurant-row .item-restaurant-desc { font-size: 12px; }
            .item-restaurant-more .row { flex-direction: row; align-items: center; justify-content: space-between; width: 100%; }
            .adding-food-cart form { display: flex; align-items: center; gap: 6px; }
            .adding-food-cart input[type="number"] { width: 50px; }
            .menu-restaurant-list .search-items .input-group input { font-size: 13px; }
            .now-detail-restaurant .utility-restaurant .utility-item { width: 100%; float: none; margin-bottom: 10px; }
            .now-detail-restaurant .utility-restaurant .utility-item:after { display: none; }
            #reviews-section { padding: 16px !important; }
            #review-list { grid-template-columns: 1fr !important; }
            .now-detail-restaurant .rating .number-rating { font-size: 12px; }
        }
        @@media (max-width: 576px) {
            .app { margin-top: 70px; padding: 0 8px; }
            .now-detail-restaurant .detail-restaurant-img img { width: 100%; height: auto; max-height: 200px; object-fit: cover; }
            .now-detail-restaurant .name-restaurant { font-size: 16px; line-height: 1.3; }
            .now-detail-restaurant .address-restaurant { font-size: 12px; }
            .item-restaurant-row .current-price { font-size: 14px; }
            .item-restaurant-row .item-restaurant-total { font-size: 10px; }
            .adding-food-cart .btn { padding: 6px 12px; font-size: 12px; }
            .menu-restaurant-list .title-menu strong { font-size: 14px; }
        }

        /* ============================================================
           STICKY CATEGORY BAR (Mobile) — sticks below header when scrolling
           ============================================================ */
        @@media (max-width: 768px) {
            .menu-restaurant-category.is-sticky {
                position: -webkit-sticky;
                position: sticky;
                top: 68px; /* below header height */
                z-index: 50;
                background: var(--fs-white);
                border-bottom: 1px solid var(--fs-border);
                box-shadow: 0 2px 8px rgba(0,0,0,.05);
                margin: 0 -16px;
                padding: 0 16px;
                transition: box-shadow .2s ease;
            }
            .menu-restaurant-category.is-sticky.scrolled {
                box-shadow: 0 4px 16px rgba(0,0,0,.1);
            }
        }
        @@media (max-width: 576px) {
            .menu-restaurant-category.is-sticky { top: 60px; }
        }

        /* ============================================================
           FLOATING ACTION BUTTON (Mobile) — opens category Bottom Sheet
           ============================================================ */
        .fs-category-fab {
            position: fixed;
            bottom: 24px;
            right: 16px;
            z-index: 999;
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: linear-gradient(135deg, #3CB815, #2ea310);
            color: var(--fs-white);
            border: none;
            box-shadow: 0 4px 16px rgba(60,184,21,.35);
            cursor: pointer;
            display: none; /* hidden on desktop */
            align-items: center;
            justify-content: center;
            font-size: 22px;
            transition: transform .2s ease, box-shadow .2s ease;
            -webkit-tap-highlight-color: transparent;
        }
        .fs-category-fab:active {
            transform: scale(.92);
        }
        .fs-category-fab .fab-badge {
            position: absolute;
            top: -4px;
            right: -4px;
            background: var(--fs-danger);
            color: var(--fs-white);
            font-size: 11px;
            font-weight: 700;
            width: 22px;
            height: 22px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 2px 6px rgba(231,76,60,.4);
        }
        @@media (max-width: 768px) {
            .fs-category-fab { display: flex; }
        }
        @@media (max-width: 576px) {
            .fs-category-fab {
                width: 48px;
                height: 48px;
                font-size: 18px;
                bottom: 16px;
                right: 12px;
            }
        }

        /* ============================================================
           BOTTOM SHEET — category list overlay
           ============================================================ */
        .fs-bottom-sheet-overlay {
            position: fixed;
            inset: 0;
            z-index: 9998;
            background: rgba(0,0,0,.45);
            opacity: 0;
            visibility: hidden;
            transition: opacity .3s ease, visibility .3s ease;
            -webkit-tap-highlight-color: transparent;
        }
        .fs-bottom-sheet-overlay.active {
            opacity: 1;
            visibility: visible;
        }

        .fs-bottom-sheet {
            position: fixed;
            left: 0;
            right: 0;
            bottom: 0;
            z-index: 9999;
            max-height: 60vh;
            background: var(--fs-white);
            border-radius: 20px 20px 0 0;
            box-shadow: 0 -8px 40px rgba(0,0,0,.15);
            transform: translateY(100%);
            transition: transform .35s cubic-bezier(.32,.72,0,1);
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }
        .fs-bottom-sheet.active {
            transform: translateY(0);
        }

        /* Smooth scroll cho #reviews-section */
        html {
            scroll-behavior: smooth;
        }
        @@media (prefers-reduced-motion: reduce) {
            html {
                scroll-behavior: auto;
            }
        }

        /* Drag Handle */
        .fs-bs-handle {
            flex-shrink: 0;
            display: flex;
            justify-content: center;
            padding: 10px 0 6px;
        }
        .fs-bs-handle::after {
            content: '';
            width: 32px;
            height: 4px;
            background: var(--fs-border);
            border-radius: 4px;
        }

        /* Header */
        .fs-bs-header {
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 20px 12px;
            border-bottom: 1px solid var(--fs-border-soft);
        }
        .fs-bs-header h3 {
            font-size: 17px;
            font-weight: 700;
            color: var(--fs-dark);
            margin: 0;
        }
        .fs-bs-close {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border: none;
            background: var(--fs-light);
            color: var(--fs-muted);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            transition: background .2s;
        }
        .fs-bs-close:active { background: var(--fs-border); }

        /* List */
        .fs-bs-list {
            flex: 1;
            overflow-y: auto;
            padding: 8px 12px 24px;
            -webkit-overflow-scrolling: touch;
        }
        .fs-bs-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 14px;
            border-radius: 12px;
            cursor: pointer;
            transition: background .15s;
            -webkit-tap-highlight-color: transparent;
            text-decoration: none;
            color: inherit;
        }
        .fs-bs-item:active { background: #f0fff0; }
        .fs-bs-item.active {
            background: #f0fff0;
            border: 1.5px solid #3CB815;
        }
        .fs-bs-item .bs-item-icon { font-size: 20px; flex-shrink: 0; }
        .fs-bs-item .bs-item-name { flex: 1; font-weight: 600; font-size: 14px; }
        .fs-bs-item .bs-item-count {
            background: var(--fs-light);
            padding: 2px 10px;
            border-radius: 12px;
            font-size: 12px;
            color: var(--fs-muted);
            font-weight: 500;
        }
        .fs-bs-item.active .bs-item-count {
            background: #3CB815;
            color: var(--fs-white);
        }
    </style>
}

@{
    var khuyenMais = (ViewBag.KhuyenMais as List<ShipFood.Models.tbMonAnKhuyenMai>) ?? new List<ShipFood.Models.tbMonAnKhuyenMai>();
    var muaKem = ViewBag.MuaKem as List<ShipFood.Models.tbMonAn>;
    var trendingNow = ViewBag.TrendingNow as List<ShipFood.Models.tbMonAn>;
}

<div class="app">
    <div class="wrapper">
        <div class="now-detail-restaurant clearfix">
            <div class="container">
                <div class="detail-restaurant-img">
                    <img src="@TinhToan.HinhAnhUrl(Model.hinhanh)" alt="Không tìm thấy ảnh" class="" loading="lazy" onerror="this.src='/Source/Home/img/pizza.jpg'" />
                </div>
                <div class="detail-restaurant-info">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a class="breadcrumb-link" href="/">Trang chủ</a></li>
                            <li class="breadcrumb-item"><a class="breadcrumb-link" href="/Home">TP. Hồ Chí Minh</a></li>
                            <li class="breadcrumb-item active" aria-current="page">@Model.tenquanan</li>
                        </ol>
                    </nav>
                    <div class="kind-restaurant">
                        <div class="tag-preferred" data-bs-toggle="modal" data-bs-target="#modal-preferred-merchant">
                            <i class="fa-solid fa-thumbs-up" aria-hidden="true"></i>Yêu thích
                        </div>
                        <span>Quán ăn<span>-<a class="link-brand" title="Cơm Thố Thiên Phúc" rel="nofollow" href="/thuong-hieu/com-tho-thien-phuc">Chi nhánh</a></span></span>
                    </div>
                    <h1 class="name-restaurant">@Model.tenquanan</h1>
                    <div class="address-restaurant">@Model.diachi</div>
                    <div class="rating">
                        <div class="stars">
                            @for (int i = 0; i < (int)(Model.diemdanhgia ?? 0); ++i)
                            {
                                <span class="full"><i class="fas fa-star"></i></span>
                            }
                        </div>
                        <span class="number-rating">@Model.soluotdanhgia</span>đánh giá trên Fastship
                    </div>
                    <div class="view-more-rating">
                        <a href="#reviews-section" rel="noopener noreferrer" class="number-review">Xem thêm lượt đánh giá từ Fastship <i class="fa fa-arrow-down"></i></a>
                    </div>
                    <div class="status-restaurant">
                        <div class="opentime-status"><span class="stt online" title="@Model.trangthai"></span></div>
                        <div class="time"><i class="far fa-clock"></i>07:30 - 21:30</div>
                    </div>
                    <div class="cost-restaurant"><i class="fas fa-dollar-sign"></i>35.000 - 75.000</div>
                    <div class="share-social clearfix">
                        <div class="share-social-box">
                            <div class="fb-like" data-layout="button" data-action="like" data-size="small" data-show-faces="false" data-share="true" data-colorscheme="light" data-kid-directed-site="false"></div>
                        </div>
                    </div>
                    <div class="utility-restaurant clearfix">
                        <div class="utility-item">
                            <div class="utility-title">Phí dịch vụ</div>
                            <div class="utility-content"><span class="txt-bold txt-red"> 0.0% Phí phục vụ </span></div>
                            <span class="icon icon-partner-vi" data-bs-toggle="modal" data-bs-target="#modal-verify-merchant"></span>
                        </div>
                        <div class="utility-item">
                            <div class="utility-title">Dịch vụ bởi</div>
                            <div class="utility-content"><span class="txt-bold txt-red">Fastship</span></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="container relative clearfix">
                <div class="now-menu-restaurant" style="width:90%">
                    <div class="menu-restaurant-tab"><div class="item active">Thực đơn</div></div>
                    <div class="menu-restaurant-content-tab">
                        <div class="menu-restaurant-container">
                            <div class="menu-restaurant-category">
                                <div class="list-category" id="scroll-spy">
                                    <div class="scrollbar-container ps">
                                        <a href="@Url.Action("DetailRestaurant", new { id = ViewBag.maquan })">
                                            <div class="item">
                                                <span title="Tất cả" class="item-link @(ViewBag.idDM == null ? "active" : "")">Tất cả</span>
                                            </div>
                                        </a>
                                        @foreach (var thucdon in ViewBag.ThucDon)
                                        {
                                            var searchKey = !string.IsNullOrEmpty(ViewBag.searchKey as string) ? ViewBag.searchKey : null;
                                            var href = Url.Action("DetailRestaurant", "Home", new { id = ViewBag.maquan, idDM = thucdon.madanhmuc, searchKey = searchKey });
                                            <a href="@href">
                                                <div class="item">
                                                    <span id="cat-@thucdon.madanhmuc" title="@thucdon.tendanhmuc" class="item-link @(ViewBag.idDM == thucdon.madanhmuc ? "active" : "")">@thucdon.tendanhmuc</span>
                                                </div>
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="menu-restaurant-detail" style="width:78%">
                                <div class="menu-restaurant-list">
                                    <div class="search-items">
                                        <form action="~/Home/DetailRestaurant" style="margin-bottom:16px;">
                                            <input type="hidden" name="id" value="@ViewBag.maquan"/>
                                            <div style="display:flex;align-items:center;gap:0;border:1.5px solid var(--fs-border);border-radius:10px;overflow:hidden;background:#fff;">
                                                <span style="padding:0 0 0 12px;display:flex;align-items:center;color:var(--fs-muted-soft);font-size:13px;">
                                                    <i class="fas fa-search"></i>
                                                </span>
                                                <input type="text" name="searchKey" placeholder="Tìm món..." value="@ViewBag.searchKey"
                                                       style="flex:1;border:none;padding:9px 10px;font-size:14px;outline:none;background:transparent;" />
                                                <button type="submit"
                                                        style="padding:9px 20px;background:var(--fs-green);color:#fff;border:none;font-size:13px;font-weight:600;cursor:pointer;transition:background .15s;">Tìm</button>
                                            </div>
                                        </form>
                                    </div>
                                    <div class="menu-group" id="section-group-menu--1" style="height: auto; left: 0px; position: relative; top: 0px; width: 100%; padding-bottom: 8px;">
                                        <div class="title-menu" style="display: flex; justify-content: space-between; align-items: center;">
                                            <strong>Danh sách món</strong>
                                            @{
                                                var daMuaMonAnIds = ViewBag.DaMuaMonAnIds as HashSet<int>;
                                                var userJson = Context.Session.GetString("user");
                                                var isLoggedIn = !string.IsNullOrEmpty(userJson);
                                            }
                                            @if (isLoggedIn && daMuaMonAnIds != null && daMuaMonAnIds.Any())
                                            {                                                    <label style="font-size:13px;cursor:pointer;user-select:none;">
                                                        <input type="checkbox" id="filter-da-mua" onchange="toggleDaMuaFilter()" />
                                                        <span style="color:var(--fs-danger);">❤ Đã mua</span>
                                                </label>
                                            }
                                        </div>
                                    </div>
                                    @foreach (ShipFood.Models.tbMonAn item in ViewBag.DanhSachMonAn)
                                    {
                                        // ponytail: cast item về tbMonAn để DLR không bị RuntimeBinderException với extension methods LINQ
                                        var khuyenMai = khuyenMais?.FirstOrDefault(km => km.tbBienTheMonAn?.mamon == item.mamon);
                                        var giaGoc = item.tbBienTheMonAns?.FirstOrDefault()?.giatien;
                                        var giaKhuyenMai = giaGoc;
                                        if (khuyenMai != null && khuyenMai.phantramgiam > 0)
                                        {
                                            giaKhuyenMai = giaGoc - (giaGoc * khuyenMai.phantramgiam / 100);
                                        }
                                        var daMua = daMuaMonAnIds != null && daMuaMonAnIds.Contains(item.mamon);
                                        var allVariants = item.tbBienTheMonAns?.ToList() ?? new List<ShipFood.Models.tbBienTheMonAn>();
                                        var firstVariantId = allVariants.Count > 0 ? allVariants[0].id : (int?)item.mamon;
                                        // ponytail: item row keys for consistent flex layout
                                        var rowItemId = "item-" + item.mamon;
                                        <div class="item-restaurant-row @(daMua ? "item-da-mua" : "")" id="@rowItemId" style="display:block;position:relative;width:100%;margin-bottom:20px;">
                                            <div class="row" style="flex-wrap:nowrap;align-items:flex-start;gap:0;">
                                                <!-- Column 1: Image + badge -->
                                                <div class="col-auto item-restaurant-img" style="position:relative;flex-shrink:0;padding-right:0;">
                                                    <button class="inline" style="padding:0;border:none;background:none;@(!item.conhang ? "filter:grayscale(1);opacity:.7;" : "")">
                                                        <img src="@TinhToan.HinhAnhUrl(item.hinhanh)" alt="@item.tenmon"
                                                             style="width:72px;height:72px;border-radius:10px;object-fit:cover;display:block;"
                                                             loading="lazy" onerror="this.src='/Source/Home/img/pizza.jpg'" />
                                                    </button>
                                                    @if (!item.conhang)
                                                    {
                                                        <span style="position:absolute;top:-2px;left:-2px;background:#e74c3c;color:var(--fs-white);padding:3px 8px;font-size:10px;font-weight:700;border-radius:10px 0 10px 0;box-shadow:0 2px 6px rgba(231,76,60,.4);display:flex;align-items:center;gap:3px;">
                                                            🔥 Cháy hàng
                                                        </span>
                                                    }
                                                    else if (khuyenMai != null)
                                                    {
                                                        <span style="position:absolute;top:-2px;left:-2px;background:var(--fs-danger);color:var(--fs-white);padding:3px 8px;font-size:10px;font-weight:700;border-radius:10px 0 10px 0;box-shadow:0 2px 6px rgba(231,76,60,.4);display:flex;align-items:center;gap:3px;">
                                                            <i class="fa fa-fire" style="font-size:9px;"></i>-@khuyenMai.phantramgiam%
                                                        </span>
                                                    }
                                                </div>
                                                <!-- Column 2: Info (flex-shrink) -->
                                                <div class="col item-restaurant-info" style="min-width:0;flex:1;padding-left:14px;padding-right:12px;">
                                                    <h2 class="item-restaurant-name" style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;">
                                                        <span style="font-size:15px;font-weight:700;color:var(--fs-dark);">@item.tenmon</span>
                                                        @if (daMua)
                                                        {
                                                            <span style="font-size:10px;background:var(--fs-danger);color:var(--fs-white);padding:1px 7px;border-radius:4px;font-weight:600;white-space:nowrap;">Đã mua</span>
                                                        }
                                                    </h2>
                                                    <div class="item-restaurant-desc" style="font-size:13px;color:var(--fs-muted);margin:2px 0 4px;line-height:1.4;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;">@item.mota</div>
                                                    <div class="item-restaurant-total" style="font-size:11px;color:var(--fs-muted-soft);">Đã được đặt <strong>100+</strong> lần&nbsp;|&nbsp;<i class="fa fa-thumbs-up" style="color:var(--fs-green);"></i>&nbsp;3</div>
                                                </div>
                                                <!-- Column 3: Price + Size + Add-to-cart (right-aligned block) -->
                                                <div class="col-auto item-restaurant-more" style="flex-shrink:0;display:flex;flex-direction:column;align-items:flex-end;gap:8px;padding-left:0;min-width:140px;">
                                                    <!-- Price -->
                                                    <div class="product-price" style="text-align:right;line-height:1.1;">
                                                        @if (khuyenMai != null && khuyenMai.phantramgiam > 0)
                                                        {
                                                            <div class="old-price" style="text-decoration:line-through;color:var(--fs-muted-soft);font-size:12px;">@giaGoc?.ToString("N0")<sup style="font-size:9px;top:-0.3em;">đ</sup></div>
                                                        }
                                                        <div class="current-price current-price-@item.mamon" style="color:@(khuyenMai != null ? "var(--fs-danger)" : "var(--fs-dark)");font-size:17px;font-weight:700;">
                                                            @(khuyenMai != null ? giaKhuyenMai?.ToString("N0") : item.tbBienTheMonAns?.FirstOrDefault()?.giatien?.ToString("N0"))<sup style="font-size:11px;top:-0.4em;">đ</sup>
                                                        </div>
                                                    </div>
                                                    <!-- Size chips (multi-variant) -->
                                                    @if (item.tbBienTheMonAns != null && item.tbBienTheMonAns.Count > 1)
                                                    {
                                                        <div class="fs-size-selector" data-mamon="@item.mamon" style="display:flex;gap:5px;flex-wrap:wrap;justify-content:flex-end;">
                                                            @for (int vi = 0; vi < allVariants.Count; vi++)
                                                            {
                                                                var variant = allVariants[vi];
                                                                var isFirst = vi == 0;
                                                                <button type="button"
                                                                        class="fs-size-chip@(isFirst ? " active" : "")"
                                                                        data-bientheid="@variant.id"
                                                                        data-mamon="@item.mamon"
                                                                        data-giatien="@variant.giatien"
                                                                        data-size="@variant.size"
                                                                        onclick="selectSize(this)"
                                                                        style="padding:5px 12px;border-radius:16px;border:1.5px solid @(isFirst ? "#3CB815" : "var(--fs-border)");background:@(isFirst ? "#3CB815" : "#fff");color:@(isFirst ? "#fff" : "#555");font-size:11px;font-weight:600;cursor:pointer;transition:all .15s;white-space:nowrap;">
                                                                    @(variant.size ?? "M") @variant.giatien?.ToString("N0")<sup style="font-size:9px;top:-0.2em;">đ</sup>
                                                                </button>
                                                            }
                                                        </div>
                                                    }
                                                    <!-- Quantity + Add to cart -->
                                                    <div class="adding-food-cart" style="display:flex;align-items:center;gap:6px;flex-shrink:0;">
                                                        <form action="~/Cart/ThemMonAn" method="get" onsubmit="return validateCartForm(this)" style="display:flex;align-items:center;gap:6px;margin:0;">
                                                            <input name="soLuong" type="number" value="1" min="1"
                                                                   style="width:48px;height:32px;padding:2px 4px;border:1.5px solid var(--fs-border);border-radius:8px;font-size:13px;font-weight:600;text-align:center;" />
                                                            <input name="maMonAn" type="hidden" value="@firstVariantId" class="maMonAnInput-@item.mamon" />
                                                            <button type="submit" class="btn @(item.conhang ? "btn-success" : "btn-secondary") add-to-cart-btn"
                                                                    data-mamon="@item.mamon"
                                                                    data-soluong="1"
                                                                    onclick="return @(item.conhang ? "optimisticAddToCart(this, event)" : "false")"
                                                                    style="height:32px;padding:4px 16px;font-size:13px;font-weight:600;border-radius:8px;white-space:nowrap;"
                                                                    @(!item.conhang ? "disabled" : "")>@(item.conhang ? "Thêm" : "Hết hàng")</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    <!-- Recommendation: Thường được mua kèm -->
                                    @if (muaKem != null && muaKem.Any())
                                    {
                                        <div class="menu-group" style="margin-top: 30px;">
                                            <div class="title-menu"><strong><i class="fas fa-shopping-cart" style="color:#3CB815;"></i> Thường được mua kèm</strong></div>
                                            @foreach (var item in muaKem)
                                            {
                                                <div class="item-restaurant-row" style="display:flex;align-items:center;padding:10px 0;border-bottom:1px solid var(--fs-border-soft);">
                                                    <div style="width:50px;height:50px;margin-right:12px;">
                                                        <img src="@TinhToan.HinhAnhUrl(item.hinhanh)" alt="@item.tenmon" style="width:50px;height:50px;border-radius:8px;object-fit:cover;" loading="lazy" onerror="this.src='/Source/Home/img/pizza.jpg'" />
                                                    </div>
                                                    <div style="flex:1;">
                                                        <strong>@item.tenmon</strong>
                                                        <div style="color:var(--fs-danger);font-weight:600;">@item.tbBienTheMonAns?.FirstOrDefault()?.giatien?.ToString("N0")đ</div>
                                                    </div>
                                                    <div>
                                                        <a href="@Url.Action("DetailRestaurant", new { id = item.maquanan })" class="btn btn-sm btn-outline-success">Xem</a>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }

                                    <!-- Recommendation: Gợi ý theo khung giờ -->
                                    @if (trendingNow != null && trendingNow.Any())
                                    {
                                        <div class="menu-group" style="margin-top: 20px;">
                                            <div class="title-menu"><strong><i class="fas fa-clock" style="color:#f39c12;"></i> Gợi ý cho khung giờ này</strong></div>
                                            <div style="display: flex; gap: 12px; overflow-x: auto; padding: 10px 0;">
                                                @foreach (var item in trendingNow)
                                                {
                                                    <div style="min-width:160px;border:1px solid var(--fs-border);border-radius:10px;padding:12px;text-align:center;">
                                                        <img src="@TinhToan.HinhAnhUrl(item.hinhanh)" alt="@item.tenmon" style="width:80px;height:80px;border-radius:8px;object-fit:cover;" loading="lazy" onerror="this.src='/Source/Home/img/pizza.jpg'" />
                                                        <div style="margin-top: 8px;"><strong>@item.tenmon</strong></div>
                                                        <div style="color:var(--fs-danger);font-weight:600;">@item.tbBienTheMonAns?.FirstOrDefault()?.giatien?.ToString("N0")đ</div>
                                                        <a href="@Url.Action("DetailRestaurant", new { id = item.maquanan })" class="btn btn-sm btn-success mt-2">Đặt ngay</a>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ========== FAB + BOTTOM SHEET (MOBILE ONLY) ========== -->
        <!-- Floating Action Button -->
        <button class="fs-category-fab" id="categoryFab" aria-label="Danh mục món ăn" onclick="openCategorySheet()">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
            <span class="fab-badge" id="categoryFabBadge">0</span>
        </button>

        <!-- Bottom Sheet Overlay -->
        <div class="fs-bottom-sheet-overlay" id="categorySheetOverlay" onclick="closeCategorySheet()"></div>

        <!-- Bottom Sheet -->
        <div class="fs-bottom-sheet" id="categorySheet">
            <div class="fs-bs-handle"></div>
            <div class="fs-bs-header">
                <h3><i class="fas fa-list" style="color:var(--fs-green);"></i> Danh mục món ăn</h3>
                <button class="fs-bs-close" onclick="closeCategorySheet()" aria-label="Đóng">✕</button>
            </div>
            <div class="fs-bs-list" id="categorySheetList">
                <!-- Populated by JavaScript -->
            </div>
        </div>        <!-- ========== CUSTOMER REVIEWS SECTION ========== -->
        <div class="container" style="margin-top: 40px; margin-bottom: 60px;">
            <div id="reviews-section" style="background:#fff; border-radius:16px; padding:32px; box-shadow:0 2px 16px rgba(0,0,0,.07);">

                <!-- Header + Stats -->
                <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;margin-bottom:24px;">
                    <div>                                        <h3 style="font-weight:700;margin:0;color:var(--fs-dark);">⭐ Đánh giá từ khách hàng</h3>
                        <p style="color:var(--fs-muted);font-size:14px;margin:4px 0 0;">Nhận xét thực tế từ những người đã đặt hàng</p>
                    </div>
                    <div id="review-stats" style="display:flex;align-items:center;gap:20px;">
                        <div style="text-align:center;">
                            <div id="avg-score" style="font-size:40px;font-weight:800;color:var(--fs-warning);line-height:1;">—</div>
                            <div id="star-display" style="color:var(--fs-warning);font-size:18px;letter-spacing:2px;">☆☆☆☆☆</div>
                            <div id="total-reviews" style="font-size:12px;color:var(--fs-muted);">Đang tải...</div>
                        </div>
                    </div>
                </div>

                <!-- Review cards -->
                <div id="review-list" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;">
                    <div style="text-align:center;padding:40px;color:var(--fs-muted-soft);grid-column:1/-1;">
                        <div style="font-size:32px;margin-bottom:8px;">⏳</div>
                        Đang tải đánh giá...
                    </div>
                </div>

                <!-- Load more -->
                <div id="load-more-wrap" style="text-align:center;margin-top:20px;display:none;">
                    <button id="btn-load-more" onclick="loadMoreReviews()"
                        style="padding:10px 32px;border:2px solid var(--fs-green);background:var(--fs-white);color:var(--fs-green);border-radius:30px;font-weight:600;cursor:pointer;transition:all .2s;">
                        Xem thêm đánh giá
                    </button>
                </div>

                @Html.AntiForgeryToken()

                <!-- Viết đánh giá (chỉ hiện khi đã mua và đăng nhập) -->
                @{
                    var userJsonReview = Context.Session.GetString("user");
                    var isLoggedInReview = !string.IsNullOrEmpty(userJsonReview);
                    var daMuaForReview = ViewBag.DaMuaMonAnIds as HashSet<int>;
                    bool canReview = isLoggedInReview && daMuaForReview != null && daMuaForReview.Any();
                }
                @if (canReview)
                {
                    <div style="margin-top:28px;border-top:2px solid var(--fs-border-soft);padding-top:24px;">
                        <h4 style="font-weight:700;margin-bottom:16px;color:var(--fs-dark);">✍️ Viết đánh giá của bạn</h4>
                        <div style="background:var(--fs-light);border-radius:12px;padding:20px;">
                            <div style="margin-bottom:12px;">
                                <label style="font-weight:600;font-size:14px;">Chọn món muốn đánh giá:</label>
                                <select id="review-mactdh" class="form-select mt-1" style="max-width:400px;">
                                    <option value="">-- Chọn món đã mua --</option>
                                </select>
                            </div>
                            <div style="margin-bottom:12px;">
                                <label style="font-weight:600;font-size:14px;">Điểm đánh giá:</label>
                                <div id="star-picker" style="display:flex;gap:6px;margin-top:8px;font-size:28px;cursor:pointer;">
                                    <span class="star-opt" data-val="1">☆</span>
                                    <span class="star-opt" data-val="2">☆</span>
                                    <span class="star-opt" data-val="3">☆</span>
                                    <span class="star-opt" data-val="4">☆</span>
                                    <span class="star-opt" data-val="5">☆</span>
                                </div>
                                <input type="hidden" id="review-diem" value="0">
                            </div>
                            <div style="margin-bottom:16px;">
                                <label style="font-weight:600;font-size:14px;">Nhận xét (tuỳ chọn):</label>
                                <textarea id="review-nhanxet" class="form-control mt-1" rows="3" placeholder="Chia sẻ cảm nhận của bạn..." maxlength="500" style="border-radius:8px;"></textarea>
                                <div style="font-size:11px;color:var(--fs-muted-soft);text-align:right;margin-top:2px;"><span id="char-count">0</span>/500</div>
                            </div>
                            <div id="review-feedback" style="display:none;margin-bottom:12px;font-size:14px;padding:10px 14px;border-radius:8px;"></div>
                            <button onclick="submitReview()"
                                style="padding:10px 28px;background:linear-gradient(135deg,#3CB815,#27a001);color:var(--fs-white);border:none;border-radius:8px;font-weight:600;cursor:pointer;font-size:14px;">
                                Gửi đánh giá
                            </button>
                        </div>
                    </div>
                }
                else if (!isLoggedInReview)
                {
                    <div style="margin-top:20px;text-align:center;padding:20px;background:var(--fs-light);border-radius:12px;">
                        <p style="color:var(--fs-muted);margin-bottom:12px;">Đăng nhập để viết đánh giá</p>
                        <a href="@Url.Action("Login","Home")" class="fs-btn fs-btn-primary" style="padding:10px 24px;border-radius:8px;">Đăng nhập</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal alerts -->
<div class="modal fade modal-alert" id="modal-delivery-alert-MenuAlertModal" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-noti" role="document">
        <div class="modal-content">
            <span class="close" data-bs-dismiss="modal">x</span>
            <div class="modal-header txt-bold font13"><span class="txt-red">Fastship</span> Thông báo</div>
            <div class="modal-body"><div class="col col-12"><p class="font15"><span></span></p></div></div>
            <div class="modal-footer content-right"><button type="button" class="btn btn-red" data-bs-dismiss="modal">Ok</button></div>
        </div>
