    <!-- ═══ PWA: Service Worker + Dark Mode Toggle ═══ -->
    <script>
    // ponytail: Tự động xoá Service Worker cũ rác và ép tải mới bằng timestamp để không bao giờ bị kẹt Cache 24h
    if ('serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then(function(registrations) {
            for(let registration of registrations) {
                registration.unregister();
            }
        });
        navigator.serviceWorker.register('/sw.js?v=' + new Date().getTime()).catch(function(err) {
            console.warn('SW registration failed:', err);
        });
    }
    // ponytail: dark mode toggle
    function toggleDarkMode() {
        var html = document.documentElement;
        var current = html.getAttribute('data-theme') || 'light';
        var next = current === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', next);
        localStorage.setItem('fastship-theme', next);
    }
    (function() {
        var saved = localStorage.getItem('fastship-theme');
        if (saved === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
    })();
    </script>

    <!-- ═══ Lazy loading cho t?t c? <img> (native browser support) ═══ -->
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('img:not([loading])').forEach(function(img) {
            img.setAttribute('loading', 'lazy');
        });
    });
    </script>
    
