
@inject ShipFood.Models.dbFoodyEntities _db
@{
    ViewBag.Title = "Index";
    var userJson = Context.Session.GetString("user");
    var currentUser = userJson != null ? JsonSerializer.Deserialize<tbUser>(userJson) : null;
    ShipFood.Models.tbQuanAn? QuanAn = currentUser != null ? _db.tbQuanAn.Find(currentUser.userid) : null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Fastship - Khám phá, đặt hàng, giao tân nơi</title>
    <!-- Favicon icon -->
    <link href="~/Source/Home/img/favicon.ico" rel="icon" />
    <link href="~/Source/Restaurant/vendor/bootstrap-select/dist/css/bootstrap-select.min.css" rel="stylesheet" />
    <link href="~/Source/Restaurant/vendor/datatables/css/jquery.dataTables.min.css" rel="stylesheet" />
    <link href="~/Source/Restaurant/css/style-restaurant.css" rel="stylesheet" />
    <!-- Font Awesome 5 (CDN) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" onerror="var s=document.createElement('link');s.rel='stylesheet';s.href='https://use.fontawesome.com/releases/v5.10.0/css/all.css';document.head.appendChild(s);console.warn('FA CDN fallback');" />
    <!-- Bootstrap 5.3 (CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">
    <!-- Global Design System v4.0 -->
    <link href="~/Source/Shared/css/fastship-design-tokens.css" rel="stylesheet" />
    <link href="~/Source/Shared/css/fastship-animations.css" rel="stylesheet" />
    <link href="~/Source/Shared/css/fs-dashboard-overrides.css" rel="stylesheet" />
    <style>
        /* ── Restaurant-specific - minimal overrides ── */
        @@media (max-width: 576px) {
            .form-head .me-auto { margin-right: 0; }
            h2.text-black { font-size: 1.2rem; }
        }
    </style>
</head>

<body>
    <!--*******************
        Preloader start
    ********************-->
    <div id="preloader">
        <div class="sk-three-bounce">
            <div class="sk-child sk-bounce1"></div>
            <div class="sk-child sk-bounce2"></div>
            <div class="sk-child sk-bounce3"></div>
        </div>
    </div>
    <!--*******************
        Preloader end
    ********************-->
    <!--**********************************
        Main wrapper start
    ***********************************-->
    <div id="main-wrapper">
        <!--**********************************
              Nav header start
          ***********************************-->
        <div class="nav-header">
            <a href="index.html" class="brand-logo">
                <!-- <img class="logo-abbr" src="~/Source/Restaurant/images/logo.png" alt="" /> -->
                <img class="logo-compact" src="~/Source/Restaurant/images/FASTSHIP.png" alt="" />
                <img class="brand-title" src="~/Source/Restaurant/images/FASTSHIP.png" alt="" />
            </a>

            <div class="nav-control">
                <div class="hamburger"><span class="line"></span><span class="line"></span><span class="line"></span></div>
            </div>
        </div>
        <!--**********************************
              Nav header end
          ***********************************-->
        <!--**********************************
              Chat box start
          ***********************************-->
        <!--**********************************
              Chat box End
          ***********************************-->
        <!--**********************************
              Header start
          ***********************************-->
        <!-- header z-index: 1050 (over filter bar 1000) -->
        <div class="header" style="z-index:1050;">
            <div class="header-content">
                <nav class="navbar navbar-expand">
                    <div class="collapse navbar-collapse justify-content-between">
                        <div class="header-left d-none d-md-flex align-items-center ps-3">
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb mb-0 bg-transparent p-0" style="font-size: 14px;">
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Restaurant")" class="text-muted"><i class="fas fa-home me-1"></i>Quản lý quán</a></li>
                                    @if (!string.IsNullOrEmpty(ViewBag.Title))
                                    {
                                        <li class="breadcrumb-item active" aria-current="page" style="color: var(--fs-green); font-weight: 500;">@ViewBag.Title</li>
                                    }
                                </ol>
                            </nav>
                        </div>

                        <ul class="navbar-nav header-right">
                            <li class="nav-item dropdown notification_dropdown">
                                <a class="nav-link dz-fullscreen primary p-3" href="#">
                                    <svg id="Capa_1"
                                         enable-background="new 0 0 482.239 482.239"
                                         height="22"
                                         viewBox="0 0 482.239 482.239"
                                         width="22"
                                         xmlns="http://www.w3.org/2000/svg">
                                        <path d="m0 17.223v120.56h34.446v-103.337h103.337v-34.446h-120.56c-9.52 0-17.223 7.703-17.223 17.223z"
                                              fill="" />
                                        <path d="m465.016 0h-120.56v34.446h103.337v103.337h34.446v-120.56c0-9.52-7.703-17.223-17.223-17.223z"
                                              fill="" />
                                        <path d="m447.793 447.793h-103.337v34.446h120.56c9.52 0 17.223-7.703 17.223-17.223v-120.56h-34.446z"
                                              fill="" />
                                        <path d="m34.446 344.456h-34.446v120.56c0 9.52 7.703 17.223 17.223 17.223h120.56v-34.446h-103.337z"
                                              fill="" />
                                    </svg>
                                </a>
                            </li>

                            <li class="nav-item dropdown notification_dropdown">
                                <a class="nav-link ai-icon warning" href="#" role="button" data-bs-toggle="dropdown">
                                    <svg width="24" height="24" viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M21.75 14.8385V12.0463C21.7471 9.88552 20.9385 7.80353 19.4821 6.20735C18.0258 4.61116 16.0264 3.61555 13.875 3.41516V1.625C13.875 1.39294 13.7828 1.17038 13.6187 1.00628C13.4546 0.842187 13.2321 0.75 13 0.75C12.7679 0.75 12.5454 0.842187 12.3813 1.00628C12.2172 1.17038 12.125 1.39294 12.125 1.625V3.41534C9.97361 3.61572 7.97429 4.61131 6.51794 6.20746C5.06159 7.80361 4.25291 9.88555 4.25 12.0463V14.8383C3.26257 15.0412 2.37529 15.5784 1.73774 16.3593C1.10019 17.1401 0.751339 18.1169 0.75 19.125C0.750764 19.821 1.02757 20.4882 1.51969 20.9803C2.01181 21.4724 2.67904 21.7492 3.375 21.75H8.71346C8.91521 22.738 9.45205 23.6259 10.2331 24.2636C11.0142 24.9013 11.9916 25.2497 13 25.2497C14.0084 25.2497 14.9858 24.9013 15.7669 24.2636C16.548 23.6259 17.0848 22.738 17.2865 21.75H22.625C23.321 21.7492 23.9882 21.4724 24.4803 20.9803C24.9724 20.4882 25.2492 19.821 25.25 19.125C25.2486 18.117 24.8998 17.1402 24.2622 16.3594C23.6247 15.5786 22.7374 15.0414 21.75 14.8385ZM6 12.0463C6.00232 10.2113 6.73226 8.45223 8.02974 7.15474C9.32723 5.85726 11.0863 5.12732 12.9212 5.125H13.0788C14.9137 5.12732 16.6728 5.85726 17.9703 7.15474C19.2677 8.45223 19.9977 10.2113 20 12.0463V14.75H6V12.0463ZM13 23.5C12.4589 23.4983 11.9316 23.3292 11.4905 23.0159C11.0493 22.7026 10.716 22.2604 10.5363 21.75H15.4637C15.284 22.2604 14.9507 22.7026 14.5095 23.0159C14.0684 23.3292 13.5411 23.4983 13 23.5ZM22.625 20H3.375C3.14298 19.9999 2.9205 19.9076 2.75644 19.7436C2.59237 19.5795 2.50014 19.357 2.5 19.125C2.50076 18.429 2.77757 17.7618 3.26969 17.2697C3.76181 16.7776 4.42904 16.5008 5.125 16.5H20.875C21.571 16.5008 22.2382 16.7776 22.7303 17.2697C23.2224 17.7618 23.4992 18.429 23.5 19.125C23.4999 19.357 23.4076 19.5795 23.2436 19.7436C23.0795 19.9076 22.857 19.9999 22.625 20Z"
                                              fill="#000" />
                                    </svg>
                                    <div class="pulse-css"></div>
                                </a>
                                
                            </li>
                            <li class="nav-item dropdown">
                                <div class="toggle-container">
                                    <input type="checkbox" id="toggle" class="toggle-input" />
                                    <label for="toggle" class="toggle-label">
                                        @if (QuanAn != null && QuanAn.trangthai.Equals("Đang mở cửa"))
                                        {
                                            <form action="@Url.Action("updateStatus", "Restaurant")" method="post" style="margin:0; padding:0; display:inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" style="color:white; background:none; border:none; padding:0; cursor:pointer;" class="toggle-text">Đóng</button>
                                            </form>
                                        }
                                        @if (QuanAn != null && QuanAn.trangthai.Equals("Đóng cửa"))
                                        {
                                            <form action="@Url.Action("updateStatus", "Restaurant")" method="post" style="margin:0; padding:0; display:inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" style="border-radius: 25px; background: green; color:white; border:none; cursor:pointer;" class="toggle-text">Mở</button>
                                            </form>
                                        }
                                        

                                    </label>
                                </div>
                            </li>
                            <!-- ═══ RESTAURANT: Avatar dropdown (modern minimalist) ═══ -->
                            <li class="nav-item dropdown" style="margin-right:12px;">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 fs-nav-hover" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"
                                   style="padding:4px 8px;border-radius:8px;">
                                    <div style="width:28px;height:28px;border-radius:50%;background:#3CB815;color:#fff;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;flex-shrink:0;">@(QuanAn?.tbUser?.username?.Substring(0,1)?.ToUpper() ?? "Q")</div>
                                    <span class="d-none d-lg-inline text-muted small fw-500">@(QuanAn?.tbUser?.username ?? "Quán ăn")</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-right" style="min-width:160px;border-radius:10px;box-shadow:0 4px 20px rgba(0,0,0,.12);border:1px solid rgba(0,0,0,.06);">
                                    <li><a class="dropdown-item d-flex align-items-center gap-2 py-2" href="~/Restaurant"><i class="fas fa-chart-bar" style="width:16px;color:var(--fs-green);"></i> Dashboard</a></li>
                                    <li><a class="dropdown-item d-flex align-items-center gap-2 py-2" href="~/Restaurant/OrderList"><i class="fas fa-clipboard-list" style="width:16px;color:var(--fs-green);"></i> Đơn hàng</a></li>
                                    <li><a class="dropdown-item d-flex align-items-center gap-2 py-2" href="~/Restaurant/Profile"><i class="fas fa-user" style="width:16px;color:var(--fs-green);"></i> Hồ sơ</a></li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li><a href="/Home/Logout" class="dropdown-item d-flex align-items-center gap-2 py-2 text-danger"><i class="fas fa-sign-out-alt" style="width:16px;"></i> Đăng xuất</a></li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                </nav>
            </div>
        </div>
        <!--**********************************
              Header end ti-comment-alt
          ***********************************-->
        <!--**********************************
              Sidebar start
          ***********************************-->
        <div class="deznav">
            <div class="deznav-scroll">
                <ul class="metismenu" id="menu">
                    <li>
                        <a class="has-arrow ai-icon" href="javascript:void()" aria-expanded="false">
                            <i class="fas fa-chart-bar"></i>
                            <span class="nav-text">Dashboard</span>
                        </a>
                        <ul aria-expanded="false">
                            <li><a href="~/Restaurant">Dashboard</a></li>
                            <li><a href="~/Restaurant/Analytics">Phân tích</a></li>
                            <li><a href="~/Restaurant/Review">Đánh giá</a></li>
                            <li><a href="~/Restaurant/OrderList">Danh sách đơn hàng</a></li>
                            <li><a href="~/Restaurant/Discount">Khuyến mãi</a></li>
                        </ul>
                    </li>
                    <li>
                        <a class="has-arrow ai-icon" href="javascript:void()" aria-expanded="false">
                            <i class="fas fa-tv"></i>
                            <span class="nav-text">Apps</span>
                        </a>
                        <ul aria-expanded="false">
                            <li><a href="~/Restaurant/Profile">Hồ sơ</a></li>
                            <li>
                                <a class="has-arrow" href="javascript:void()" aria-expanded="false">Cửa hàng</a>
                                <ul aria-expanded="false">
                                    <li><a href="~/Restaurant/ProductList">Danh sách thực đơn</a></li>
                                    <li><a href="~/Restaurant/ProductDetail">Chi tiết món</a></li>
                                </ul>
                            </li>
                            <li>
                                <a href="~/edelivery/MerchantScan">
                                    <i class="fas fa-camera" style="margin-right:8px;"></i>
                                    <span class="nav-text">Quét mã QR</span>
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>

                <div class="add-menu-sidebar">
                    <img src="~/Source/Restaurant/images/icon1.png" alt="" />
                    <p>Sắp xếp các menu của bạn thông qua nút bên dưới</p>
                    <a href="~/Restaurant/ProductDetail" class="btn btn-primary btn-block light">+ Thêm thực đơn</a>
                </div>
              
            </div>
        </div>
        <!--**********************************
              Sidebar end
          ***********************************-->
        <!--**********************************
              Content body start
          ***********************************-->
        <div class="content-body">
            <!-- row -->
            @RenderBody()
        </div>
        <!--**********************************
              Content body end
          ***********************************-->
    </div>
    <!--**********************************
        Main wrapper end
    ***********************************-->
    <!--**********************************
        Scripts
    ***********************************-->
    <!-- Bootstrap 5.3 JS bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous"></script>
    <!-- Required vendors -->
    <script src="~/Source/Restaurant/vendor/global/global.min.js"></script>
    <!-- peity.js for sparkline charts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/peity/3.3.0/jquery.peity.min.js"></script>
    <script src="~/Source/Restaurant/vendor/bootstrap-select/dist/js/bootstrap-select.min.js"></script>
    <script src="~/Source/Restaurant/vendor/chart.js/Chart.bundle.min.js"></script>
    <script src="~/Source/Restaurant/js/custom.min.js"></script>
    <script src="~/Source/Restaurant/js/deznav-init.js"></script>

    <!-- Counter Up -->
    <script src="~/Source/Restaurant/vendor/waypoints/jquery.waypoints.min.js"></script>
    <script src="~/Source/Restaurant/vendor/jquery.counterup/jquery.counterup.min.js"></script>

    <!-- Apex Chart -->
    <script src="~/Source/Restaurant/vendor/apexchart/apexchart.js"></script>

    <!-- Dashboard 1 -->
    <script src="~/Source/Restaurant/js/dashboard/dashboard-1.js"></script>
    <script src="~/Source/Restaurant/vendor/datatables/js/jquery.dataTables.min.js"></script>

@RenderSection("scripts", required: false)
</body>
</html>



