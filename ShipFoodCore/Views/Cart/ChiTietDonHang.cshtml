
@{
    ViewBag.Title = "ChiTietDonHang";
    Layout = "~/Views/Shared/_LayoutPageHome.cshtml";
    ShipFood.Models.tbDonHang donHang = ViewBag.donHang;
    var userJson = Context.Session.GetString("user");
    ShipFood.Models.tbUser? user = userJson != null ? JsonSerializer.Deserialize<tbUser>(userJson) : null;

}

@section styles {
    <style>
        /* Mobile responsive fixes for ChiTietDonHang */
        @@media (max-width: 768px) {
            .breadcrumb-section { margin-top: 80px !important; }
            .breadcrumb__text h2 { font-size: 20px; }
            .checkout.spad { padding-top: 30px; }
            .checkout__form h4 { font-size: 18px; }
            .checkout__order { margin-top: 20px; }
            #order-tracking-map { height: 180px !important; }
        }
        @@media (max-width: 576px) {
            .breadcrumb-section { margin-top: 60px !important; }
            .checkout__order { padding: 16px; }
            .checkout__order ul li { font-size: 13px; }
            .checkout__order__total { font-size: 14px; }
        }
    </style>
}
    <!-- Breadcrumb Section Begin -->
    <section style="margin-top:130px" class="breadcrumb-section set-bg" data-setbg="@Url.Content("~/Source/Restaurant/images/card/2.png")">
        <div class="container">
            <div class="row">
                <div class="col-lg-12 text-center">
                    <div class="breadcrumb__text">
                        <h2 style="color:green">Checkout</h2>
                        <div class="breadcrumb__option">
                            <a href="~/Home">Trang chủ</a>
                            <span>Checkout</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Breadcrumb Section End -->
    <!-- Checkout Section Begin -->
    <section class="checkout spad">
        <div class="container">
            <div class="checkout__form">
                <h4>Thông tin chi tiết đơn hàng</h4>

                <div class="row">
                    <div class="col-lg-8 col-md-6 formInfor">
                        <!-- ═══ FLAT INVOICE LABELS: thay thế input read-only ─── -->
                        <div style="background:#fff;border-radius:12px;box-shadow:0 2px 12px rgba(0,0,0,.06);padding:24px;">
                            <div style="border-bottom:1.5px solid #e5e7eb;padding-bottom:12px;margin-bottom:12px;">
                                <small style="color:#888;font-size:11px;text-transform:uppercase;letter-spacing:.5px;font-weight:600;">Họ tên người nhận</small>
                                <p style="margin:4px 0 0;font-size:15px;font-weight:600;color:#1a1a2e;">@(donHang.tbThongTinDatHang?.tennguoinhan ?? "N/A")</p>
                            </div>
                            <div style="border-bottom:1.5px solid #e5e7eb;padding-bottom:12px;margin-bottom:12px;">
                                <small style="color:#888;font-size:11px;text-transform:uppercase;letter-spacing:.5px;font-weight:600;">Địa chỉ giao hàng</small>
                                <p style="margin:4px 0 0;font-size:14px;color:#1a1a2e;">@(donHang.tbThongTinDatHang?.diachi ?? "N/A")</p>
                            </div>
                            <div style="border-bottom:1.5px solid #e5e7eb;padding-bottom:12px;margin-bottom:12px;">
                                <small style="color:#888;font-size:11px;text-transform:uppercase;letter-spacing:.5px;font-weight:600;">Số điện thoại</small>
                                <p style="margin:4px 0 0;font-size:14px;color:#1a1a2e;">@(donHang.tbThongTinDatHang?.sdt ?? "N/A")</p>
                            </div>
                            <div style="border-bottom:1.5px solid #e5e7eb;padding-bottom:12px;margin-bottom:12px;">
                                <small style="color:#888;font-size:11px;text-transform:uppercase;letter-spacing:.5px;font-weight:600;">Ghi chú đơn hàng</small>
                                <p style="margin:4px 0 0;font-size:14px;color:#1a1a2e;">@(string.IsNullOrEmpty(donHang.ghichu) ? "Không có" : donHang.ghichu)</p>
                            </div>
                            <div style="border-bottom:1.5px solid #e5e7eb;padding-bottom:12px;margin-bottom:12px;">
                                <small style="color:#888;font-size:11px;text-transform:uppercase;letter-spacing:.5px;font-weight:600;">Shipper</small>
                                <p style="margin:4px 0 0;font-size:14px;font-weight:600;color:#1a1a2e;">@(donHang.tbShipper != null ? donHang.tbShipper.tenshipper + " - " + (donHang.tbShipper.tbUser?.sdt ?? "N/A") : "Chưa có shipper")</p>
                                @if (user != null && user.loaitaikhoan == "Khách hàng")
                                {
                                    <a href="@Url.Action("NhanTin", "Home")" style="display:inline-flex;align-items:center;gap:6px;margin-top:8px;padding:8px 16px;background:#3CB815;color:#fff;border-radius:8px;text-decoration:none;font-size:13px;font-weight:600;">
                                        <i class="fab fa-facebook-messenger"></i> Chat ngay!
                                    </a>
                                }
                                @if (user != null && user.loaitaikhoan == "Khách hàng" && donHang.trangthai == "Đang giao")
                                {
                                    <div class="mt-3">
                                        <div id="order-tracking-map" style="height:250px; border-radius:12px; border:2px solid #3CB815;"></div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6" style="margin:20px auto">
                        <div class="checkout__order">
                            <h4>Đơn hàng (@(donHang.trangthai ?? "N/A"))</h4>
                            <div class="checkout__order__products">Món ăn <span>Tổng tiền</span></div>
                            <ul>
                                @foreach (var i in donHang.tbChiTietDonHang)
                                {
                                    <li>@(i.tbMonAn?.tenmon ?? "N/A") (@i.soluong) <span>@((i.tbMonAn?.giatien * i.soluong)?.ToString("N0")) VNĐ</span></li>
                                }
                            </ul>
                            <!-- ═══ FIX ĐÈ CHỮ: dùng flexbox space-between mỗi dòng ─── -->
                            <div style="border-top:1.5px solid #e5e7eb;padding-top:12px;margin-top:8px;">
                                <div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;">
                                    <span style="color:#888;font-size:14px;">Tạm tính món ăn</span>
                                    <span style="font-weight:600;font-size:14px;color:#1a1a2e;">@donHang.tongtien?.ToString("N0") VNĐ</span>
                                </div>
                                <div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;">
                                    <span style="color:#888;font-size:14px;">Mã giảm giá</span>
                                    <span style="font-weight:600;font-size:14px;color:#3CB815;">0 VNĐ</span>
                                </div>
                                <div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;">
                                    <span style="color:#888;font-size:14px;">Phí ship</span>
                                    <span style="font-weight:600;font-size:14px;color:#1a1a2e;">15,000 VNĐ</span>
                                </div>
                                <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 0 0;margin-top:6px;border-top:2px solid #e74c3c;">
                                    <span style="font-weight:700;font-size:17px;color:#e74c3c;">Tổng thanh toán</span>
                                    <span style="font-weight:700;font-size:17px;color:#e74c3c;">@((donHang.tongtien + 15000)?.ToString("N0")) VNĐ</span>
                                </div>
                            </div>

                            <div class="row mt-3">
                                <div class="col-lg-12">
                                    <div style="border-bottom:1.5px solid #e5e7eb;padding-bottom:10px;">
                                        <small style="color:#888;font-size:11px;text-transform:uppercase;letter-spacing:.5px;font-weight:600;">Phương thức thanh toán</small>
                                        <p style="margin:4px 0 0;font-size:14px;font-weight:600;color:#1a1a2e;">@(donHang.tbLoaiHinhThanhToan?.tenhinhthuc ?? "N/A")</p>
                                    </div>
                                </div>
                            </div>
                            @if (user != null && user.loaitaikhoan == "Khách hàng")
                            {
                                <div class="row mt-3">
                                    <div class="col-lg-12 d-flex gap-2">
                                        <a href="~/Cart/OrderTracking?id=@donHang.madh" class="btn btn-outline-success flex-fill" style="border-radius:8px;"><i class="fas fa-map-marker-alt" style="margin-right:4px;"></i> Theo dõi đơn hàng</a>
                                        @if (donHang.trangthai == "Chờ thanh toán")
                                        {
                                            <button type="button" class="btn btn-outline-danger flex-fill" style="border-radius:8px;"
                                                    onclick="if(confirm('Bạn có chắc muốn hủy đơn hàng này?')){ $.ajax({url:'@Url.Action("HuyDon","Cart")',type:'POST',data:{id:@donHang.madh},headers:{'RequestVerificationToken':$('input[name="__RequestVerificationToken"]').val()},success:function(r){if(r.success){alert(r.message);location.href='/Cart/LichSuDatHang';}else{alert(r.message);}},error:function(){alert('Lỗi kết nối');}});}">
                                                <i class="fas fa-times"></i> Hủy đơn
                                            </button>
                                        }
                                        @if (donHang.trangthai == "Hoàn thành")
                                        {
                                            <button type="button" class="btn btn-warning flex-fill" style="border-radius:8px;color:#fff;font-weight:600;"
                                                    onclick="openReviewModal(@donHang.madh)">
                                                <i class="fas fa-star"></i> Đánh giá
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                            @if (user != null && user.loaitaikhoan == "Quán ăn" && donHang.trangthai == "Đã đặt")
                            {
                                <div class="row mt-3">
                                    <div class="col-lg-12 d-flex gap-2">                                        <a href="~/Restaurant/nhandon/@donHang.madh" class="btn btn-success flex-fill">Nhận đơn</a>
                                        <a href="~/Restaurant/huydon/@donHang.madh" class="btn btn-danger flex-fill">Huỷ đơn</a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Checkout Section End -->

<!-- ═══════════════════════════════════════════════════════════════
     ⭐ MODAL ĐÁNH GIÁ MÓN ĂN
     ═══════════════════════════════════════════════════════════════ -->
<div id="reviewModal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.55);z-index:99999;align-items:center;justify-content:center;">
    <div style="background:#fff;border-radius:20px;max-width:460px;width:92%;padding:32px 24px;box-shadow:0 20px 60px rgba(0,0,0,.2);animation:popIn .3s ease;text-align:center;">
        <div style="font-size:40px;margin-bottom:12px;">⭐</div>
        <h4 style="font-weight:700;margin-bottom:4px;">Đánh giá món ăn</h4>
        <p class="text-muted" style="font-size:14px;margin-bottom:20px;">Chia sẻ trải nghiệm của bạn về món ăn này</p>

        <!-- Star rating -->
        <div id="reviewStars" style="display:flex;justify-content:center;gap:8px;margin-bottom:20px;font-size:36px;cursor:pointer;">
            <span data-star="1" class="review-star" style="color:#ddd;transition:color .15s;">★</span>
            <span data-star="2" class="review-star" style="color:#ddd;transition:color .15s;">★</span>
            <span data-star="3" class="review-star" style="color:#ddd;transition:color .15s;">★</span>
            <span data-star="4" class="review-star" style="color:#ddd;transition:color .15s;">★</span>
            <span data-star="5" class="review-star" style="color:#ddd;transition:color .15s;">★</span>
        </div>
        <p id="reviewLabel" style="font-size:14px;color:#888;margin-bottom:16px;">Chọn số sao</p>

        <!-- Items to review -->
        <div id="reviewItemsList" style="margin-bottom:16px;">
            <p class="text-muted small">Đang tải danh sách món...</p>
        </div>

        <!-- Comment -->
        <textarea id="reviewComment" style="width:100%;border:1.5px solid #dee2e6;border-radius:12px;padding:12px;font-size:14px;resize:none;min-height:80px;" placeholder="Nhận xét của bạn... (không bắt buộc)"></textarea>
        <p style="text-align:right;font-size:11px;color:#aaa;margin:4px 0 16px;"><span id="charCount">0</span>/500</p>

        <!-- Buttons -->
        <div style="display:flex;gap:10px;">
            <button type="button" class="btn btn-outline-secondary flex-fill" style="border-radius:10px;" onclick="closeReviewModal()">Hủy</button>
            <button type="button" class="btn btn-warning flex-fill" style="border-radius:10px;color:#fff;font-weight:600;" id="btnSubmitReview" onclick="submitReview()" disabled>
                <i class="fas fa-star"></i> Gửi đánh giá
            </button>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()
@section scripts {
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script type="text/javascript">
    // ════════════════════════════════════════════════════════
    // ⭐ ĐÁNH GIÁ MÓN ĂN FROM CHI TIẾT ĐƠN HÀNG
    // ════════════════════════════════════════════════════════
    var selectedReviewStars = 0;
    var reviewingMactdh = null;
    var reviewingOrderId = @donHang.madh;

    function openReviewModal(orderId) {
        reviewingOrderId = orderId || @donHang.madh;
        selectedReviewStars = 0;
        reviewingMactdh = null;
        $('#reviewComment').val('');
        $('#charCount').text('0');
        $('#btnSubmitReview').prop('disabled', true);
        resetStars();
        $('#reviewLabel').text('Chọn số sao');
        $('#reviewItemsList').html('<p class="text-muted small">Đang tải danh sách món...</p>');
        $('#reviewModal').css('display','flex');

        // Load reviewable items
        $.ajax({
            url: '@Url.Action("GetReviewableItems", "Cart")',
            type: 'GET',
            data: { orderId: reviewingOrderId },
            success: function(res) {
                if (res.success && res.items) {
                    var html = '<div style="text-align:left;margin-bottom:12px;">';
                    html += '<label style="font-weight:600;font-size:14px;">Chọn món để đánh giá:</label>';
                    res.items.forEach(function(item) {
                        var disabled = item.reviewed ? 'disabled' : '';
                        var cls = item.reviewed ? 'text-muted' : '';
                        html += '<div class="review-item-option ' + cls + '" style="display:flex;align-items:center;gap:10px;padding:8px 12px;border-radius:10px;border:1.5px solid #e5e7eb;margin-top:6px;cursor:' + (item.reviewed ? 'default' : 'pointer') + ';"';
                        html += ' onclick="' + (item.reviewed ? '' : 'selectReviewItem(' + item.mactdh + ',\' ' + (item.tenmon || 'Món ăn').replace(/'/g, "\\'") + '\')') + '">';
                        html += '<input type="radio" name="reviewItem" value="' + item.mactdh + '" ' + disabled + '>';
                        html += '<span style="flex:1;font-size:14px;">' + escHtml(item.tenmon || 'Món ăn') + ' <span class="text-muted">x' + item.soluong + '</span></span>';
                        if (item.reviewed) {
                            html += '<span class="badge bg-success" style="font-size:11px;"><i class="fas fa-check"></i> Đã đánh giá</span>';
                        }
                        html += '</div>';
                    });
                    html += '</div>';
                    $('#reviewItemsList').html(html);
                } else {
                    $('#reviewItemsList').html('<p class="text-danger small">' + (res.message || 'Không có món nào để đánh giá') + '</p>');
                }
            },
            error: function() {
                $('#reviewItemsList').html('<p class="text-danger small">Lỗi tải danh sách món</p>');
            }
        });
    }

    function selectReviewItem(mactdh, tenmon) {
        reviewingMactdh = mactdh;
        // Highlight selected
        $('.review-item-option').css('border-color','#e5e7eb').css('background','');
        $('.review-item-option input[value="' + mactdh + '"]').closest('.review-item-option').css('border-color','#ffc107').css('background','#fffef0');
        updateSubmitBtn();
    }

    function closeReviewModal() {
        $('#reviewModal').css('display','none');
    }

    // Star rating
    $(document).on('click', '.review-star', function() {
        selectedReviewStars = parseInt($(this).data('star'));
        updateStars();
        updateSubmitBtn();
    });

    $(document).on('mouseenter', '.review-star', function() {
        var val = parseInt($(this).data('star'));
        $('.review-star').each(function() {
            var s = parseInt($(this).data('star'));
            $(this).css('color', s <= val ? '#ffc107' : '#ddd');
        });
        var labels = ['', 'Rất tệ 😞', 'Tệ 😕', 'Tạm được 😐', 'Ngon 👍', 'Tuyệt vời 🎉'];
        $('#reviewLabel').text(labels[val] || 'Chọn số sao');
    });

    $(document).on('mouseleave', '.review-star', function() {
        updateStars();
    });

    function resetStars() {
        selectedReviewStars = 0;
        updateStars();
        $('#reviewLabel').text('Chọn số sao');
    }

    function updateStars() {
        $('.review-star').each(function() {
            var s = parseInt($(this).data('star'));
            $(this).css('color', s <= selectedReviewStars ? '#ffc107' : '#ddd');
        });
        var labels = ['', 'Rất tệ 😞', 'Tệ 😕', 'Tạm được 😐', 'Ngon 👍', 'Tuyệt vời 🎉'];
        if (selectedReviewStars > 0) $('#reviewLabel').text(labels[selectedReviewStars] || 'Chọn số sao');
    }

    function updateSubmitBtn() {
        $('#btnSubmitReview').prop('disabled', !(selectedReviewStars > 0 && reviewingMactdh != null));
    }

    // Character count
    $(document).on('input', '#reviewComment', function() {
        var len = $(this).val().length;
        if (len > 500) { $(this).val($(this).val().substring(0, 500)); len = 500; }
        $('#charCount').text(len);
    });

    function submitReview() {
        if (!selectedReviewStars || !reviewingMactdh) {
            alert('Vui lòng chọn số sao và món ăn');
            return;
        }

        $('#btnSubmitReview').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Đang gửi...');

        $.ajax({
            url: '@Url.Action("SubmitReview", "Cart")',
            type: 'POST',
            data: {
                mactdh: reviewingMactdh,
                diemdanhgia: selectedReviewStars,
                nhanxet: $('#reviewComment').val()
            },
            headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
            success: function(res) {
                if (res.success) {
                    alert('✅ ' + res.message);
                    closeReviewModal();
                    location.reload();
                } else {
                    alert('❌ ' + res.message);
                    $('#btnSubmitReview').prop('disabled', false).html('<i class="fas fa-star"></i> Gửi đánh giá');
                }
            },
            error: function() {
                alert('❌ Lỗi kết nối. Vui lòng thử lại.');
                $('#btnSubmitReview').prop('disabled', false).html('<i class="fas fa-star"></i> Gửi đánh giá');
            }
        });
    }

    function escHtml(str) {
        if (!str) return '';
        var d = document.createElement('div'); d.textContent = str; return d.innerHTML;
    }

    // ── Original redirectToPage ──
    function redirectToPage() {
        window.location.href = '@Url.Action("NhanTin", "Home")';
    }

    // ═══ SIGNALR: Kết nối real-time - độc lập với bản đồ ═══
    // Bug fix: SignalR connection moved OUTSIDE map conditional (if(trackingMap))
    // Trước đây nằm trong điều kiện bản đồ → chỉ chạy khi status == "Đang giao"
    // → user không thấy cập nhật trạng thái cho các status trước đó
    $(document).ready(function () {
        var conn = new signalR.HubConnectionBuilder()
            .withUrl('/nhantin')
            .withAutomaticReconnect()
            .build();

        // ═══ ORDER STATUS UPDATE: Lắng nghe mọi lúc (không phụ thuộc map) ═══
        conn.on('orderStatusChanged', function (orderId, trangthai, timestamp) {
            if (orderId !== @donHang.madh) return;
            $('.checkout__order h4').text('Đơn hàng (' + trangthai + ')');
            $('.breadcrumb__option span').text('Đơn hàng - ' + trangthai);
            showOrderStatusToast(trangthai);
        });

        conn.start().then(function () {
            conn.invoke('JoinOrderGroup', @donHang.madh).catch(function (err) {
                console.error('JoinOrderGroup error:', err);
            });
            // ═══ MAP: Chỉ khởi tạo bản đồ nếu element tồn tại ═══
            initLiveMap(conn);
        }).catch(function (err) {
            console.error('SignalR connection error:', err);
        });

        conn.onreconnected(function () {
            conn.invoke('JoinOrderGroup', @donHang.madh).catch(function (err) {
                console.error('RejoinOrderGroup error:', err);
            });
        });

        function showOrderStatusToast(trangthai) {
            var icons = { 'Đã xác nhận': '👍', 'Đang chuẩn bị': '👨‍🍳', 'Đã lấy': '📦', 'Đang giao': '🚚', 'Hoàn thành': '✅', 'Đã hủy': '❌' };
            var icon = icons[trangthai] || '📦';
            var toast = $('<div style="position:fixed;top:80px;right:20px;z-index:9999;background:#3CB815;color:#fff;padding:14px 20px;border-radius:10px;box-shadow:0 4px 20px rgba(0,0,0,.2);font-size:13px;max-width:340px;animation:slideIn .3s ease;">' + icon + ' Đơn hàng đã chuyển sang: <strong>' + trangthai + '</strong></div>');
            $('body').append(toast);
            setTimeout(function(){ toast.fadeOut(400, function(){ $(this).remove(); }); }, 4000);
        }

        function initLiveMap(conn) {
            var trackingMap = document.getElementById('order-tracking-map');
            if (!trackingMap || !window.L) return;
            var map = L.map('order-tracking-map').setView([10.8231, 106.6297], 13);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap'
            }).addTo(map);
            var shipperMarker = null;
            conn.on('shipperLocationUpdate', function (orderId, lat, lng) {
                if (orderId !== @donHang.madh) return;
                if (!shipperMarker) {
                    shipperMarker = L.marker([lat, lng])
                        .addTo(map)
                        .bindPopup('🚚 Shipper đang giao hàng')
                        .openPopup();
                    if (shipperMarker._icon) {
                        shipperMarker._icon.style.transition = 'transform 0.5s ease';
                    }
                } else {
                    shipperMarker.setLatLng([lat, lng]);
                }
                map.setView([lat, lng], 15);
            });
        }
    });
</script>
}
